# ============================================================
# 五常同城 - 环境变量配置模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 按实际环境修改各项配置
#   3. 切勿将真实 .env 提交到版本控制
# ============================================================

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=wuchang_tongcheng

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123

# ===== Elasticsearch =====
ES_HOST=http://localhost:9210

# ===== RabbitMQ =====
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5673
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/wuchang

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=wuchang
MINIO_USE_SSL=false

# ===== JWT =====
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRE_HOURS=24

# ===== 七牛云 OSS =====
QINIU_ACCESS_KEY=your-access-key
QINIU_SECRET_KEY=your-secret-key
QINIU_BUCKET=wuchang-tongcheng
QINIU_DOMAIN=https://cdn.wuchang.com

# ===== 高德地图 =====
AMAP_API_KEY=your-amap-api-key

# ===== 阿里云短信 =====
SMS_ACCESS_KEY_ID=your-access-key-id
SMS_ACCESS_KEY_SECRET=your-access-key-secret
SMS_SIGN_NAME=五常同城
SMS_TEMPLATE_CODE=SMS_xxxxx

# ===== 微信小程序 =====
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# ===== 抖音小程序 =====
DOUYIN_APPID=your-douyin-appid
DOUYIN_SECRET=your-douyin-secret

# ===== 服务端口 =====
BACKEND_PORT=8088
ADMIN_PORT=5177
PC_PORT=3010

# ===== Gitee =====
GITEE_TOKEN=6e692764fcd5d30bd996366fe810f270
