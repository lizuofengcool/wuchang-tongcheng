# 五常同城项目配置文件模板
# 复制此文件为 config.yaml 并修改相应配置

# 服务配置
server:
  host: "0.0.0.0"
  port: 8088
  mode: "debug"  # debug, release, test

# 数据库配置
database:
  host: "localhost"
  port: 5434
  user: "postgres"
  password: "postgres123"
  dbname: "wuchang_tongcheng"
  sslmode: "disable"
  timezone: "Asia/Shanghai"
  # 连接池配置
  max_open_conns: 100
  max_idle_conns: 10
  max_lifetime: 3600  # 秒

# Redis配置
redis:
  host: "localhost"
  port: 6380
  password: "redis123"
  db: 0
  pool_size: 10
  default_expiration: 3600  # 秒

# 日志配置
logger:
  level: "info"  # debug, info, warn, error
  filename: "./logs/app.log"
  max_size: 100       # MB
  max_backups: 3
  max_age: 30         # 天
  compress: false
  console: true

# JWT配置
jwt:
  secret: "wuchang-tongcheng-secret-key-change-in-production"
  expire: 24  # 过期时间（小时）
  issuer: "wuchang-tongcheng"

# RabbitMQ配置
rabbitmq:
  host: "localhost"
  port: 5673
  user: "admin"
  password: "admin123"
  vhost: "/wuchang"

# Elasticsearch配置
elasticsearch:
  addresses:
    - "http://localhost:9210"
  username: ""
  password: ""

# 对象存储配置
storage:
  type: "local"  # local（本地磁盘）| minio（S3协议，兼容AWS S3/阿里云OSS/腾讯云COS）| qiniu（七牛云Kodo，AK/SK未配置时自动降级local）
  access_key: "your-access-key"     # minio/qiniu: access key
  secret_key: "your-secret-key"    # minio/qiniu: secret key
  bucket: "wuchang-tongcheng"       # local: 存储目录(默认./uploads)；minio: 桶名；qiniu: 存储空间名
  domain: "http://localhost:9010"  # local: 访问域名(默认http://localhost:8088)；minio: 服务端点；qiniu: CDN/源站域名
  region: "us-east-1"               # minio: 区域（本地MinIO可用us-east-1）

# 地图服务配置
map:
  type: "amap"  # amap, baidu
  key: "your-map-api-key"

# 短信验证码服务配置
sms:
  provider: "mock"            # ""/mock（不发短信，dev_return_code=true 时接口返回验证码明文便于联调）/aliyun（dysmsapi RPC API，AK/SK/SignName/TemplateCode 任一缺失降级 mock）
  sign_name: ""               # 短信签名（aliyun 用）
  template_code: ""           # 短信模板 code（aliyun 用）
  access_key: ""              # 短信服务 AK（aliyun 用）
  secret_key: ""              # 短信服务 SK（aliyun 用）
  code_ttl: 300               # 验证码有效期（秒），默认 300
  code_length: 6              # 验证码位数，默认 6
  max_attempts: 5             # 单次验证码最大尝试次数，超限后作废，默认 5
  dev_return_code: false      # 开发联调：发送接口返回验证码明文（仅 mock provider 生效，生产务必 false）

# OSS STS 临时凭据直传配置（可选）
#
# 用于前端直传 OSS：后端用 access_key/secret_key 调用 STS AssumeRole 扮演 role_arn
# 指定的 RAM 角色（需授予 OSS 写权限），拿到临时 AK/SK/Token 下发给前端。
# 与 storage 配置分离（storage 是后端自用 AK/SK；STS 是下发前端的临时凭据）。
# provider 非 aliyun 或 AK/SK/RoleArn 任一缺失/占位（your-）→ 自动降级 NoopProvider，
# POST /api/v1/file/sts 返回 1307，前端回退 POST /file/upload 或 POST /file/presign。
sts:
  provider: ""                # ""/aliyun（aliyun 且 access_key/secret_key/role_arn 齐全才激活）
  access_key: ""              # 调用 AssumeRole 的 RAM 用户 AK
  secret_key: ""              # 调用 AssumeRole 的 RAM 用户 SK
  role_arn: ""                # 被扮演的 RAM 角色 ARN（如 acs:ram::123456789:role/wuchang-upload）
  role_session_name: ""       # 会话名，默认 wuchang-upload
  duration_seconds: 3600      # 凭据有效期（秒），范围 900~3600，默认 3600
  bucket: ""                  # OSS 桶名（透传前端构造 OSS 客户端）
  region: ""                  # OSS 区域，如 oss-cn-hangzhou
  endpoint: ""                # OSS 端点，如 https://oss-cn-hangzhou.aliyuncs.com
  object_prefix: "uploads/"   # 对象 key 前缀

# 第三方登录配置（可选）
#
# 微信开放平台网站应用 OAuth2 网页授权登录：
# 前端在微信扫码授权后拿到 code，POST /api/v1/user/login/oauth/wechat {code} 换取 JWT。
# - provider=""      → 不启用微信登录（接口返回 4006 第三方登录未启用）
# - provider="mock"  → 联调模式：code 形如 "mock:<openid>[:<nickname>]" 直接构造身份，不访问微信
# - provider="wechat"→ 真实微信 OAuth，app_id/app_secret 齐全且非占位（your-）才激活，否则降级不启用
oauth:
  wechat:
    provider: ""              # ""/mock/wechat
    app_id: ""                # 微信开放平台 AppID
    app_secret: ""            # 微信开放平台 AppSecret
