// 同城车辆买卖模块 API 封装
// 对应后端 backend/internal/modules/car/plugin.go 路由清单（80+ API）
// 路由前缀：/car（由 request.uts 中 BASE_URL 拼接为 /api/v1/car）
// 按场景分组：车源/收藏/发布单/检测/评估/分期/车险/试驾/过户/合同/担保/评价/举报/推荐/车型库/统计
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 车源 =====
// 车源列表（公开）
export const listCars = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/car', params)
}

// 车源详情（公开）
export const getCarDetail = (id: number) : Promise<ApiResult> => {
    return get('/car/' + id)
}

