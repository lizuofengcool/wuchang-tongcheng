// ===== 搜索历史（本地存储） =====
export const getLoveSearchHistory = () : string[] => {
    const data = uni.getStorageSync('love_search_history')
    if (data instanceof Array) return data as string[]
    return [] as string[]
}

export const clearLoveSearchHistory = () => {
    uni.removeStorageSync('love_search_history')
}

export const addLoveSearchHistory = (keyword: string) => {
    if (keyword.length == 0) return
    const list = getLoveSearchHistory()
    const idx = list.indexOf(keyword)
    if (idx >= 0) list.splice(idx, 1)
    list.unshift(keyword)
    if (list.length > 20) list.splice(20)
    uni.setStorageSync('love_search_history', list)
}
