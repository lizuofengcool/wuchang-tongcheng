// 同城相亲交友模块 API 封装
// 对应后端 backend/internal/modules/love/plugin.go 路由清单（130+ API）
// 路由前缀：/love（由 request.uts 中 BASE_URL 拼接为 /api/v1/love）
// 按场景分组：资料/匹配/喜欢/拉黑/访客/印象/故事/认证/会员/礼物/通知/隐私
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 档案（Love 主表） =====
// 交友档案列表（公开）
export const listLoves = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/love', params)
}

// 档案详情（公开）
export const getLoveDetail = (id: number) : Promise<ApiResult> => {
    return get('/love/' + id)
}

// 搜索档案（公开）
export const searchLoves = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/love/search', params)
}

// 附近档案（公开）
export const listNearbyLoves = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/love/nearby', params)
}

// 我的档案列表（需登录）
export const listMyLoves = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/love/me', params)
}

// 创建档案（需登录）
export const createLove = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/love', data)
}

// 更新档案（需登录）
export const updateLove = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/love/' + id, data)
}

// 删除档案（需登录）
export const deleteLove = (id: number) : Promise<ApiResult> => {
    return del('/love/' + id)
}

// 增加档案浏览量（公开）
export const incrLoveView = (id: number) : Promise<ApiResult> => {
    return post('/love/' + id + '/view', null)
}

// 增加档案联系次数（需登录）
export const incrLoveContact = (id: number) : Promise<ApiResult> => {
    return post('/love/' + id + '/contact', null)
}

// 更新档案位置（需登录）
export const updateLoveLocation = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/love/' + id + '/location', data)
}

// 更新语音介绍（需登录）
export const updateLoveVoiceIntro = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/love/' + id + '/voice-intro', data)
}

// 匹配度（需登录）
export const getLoveMatchScore = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/love/match-score', params)
}

