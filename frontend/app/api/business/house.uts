}

// 发布房源（需登录）
export const createHouse = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/house', data)
}

// 更新房源（需登录）
export const updateHouse = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/house/' + id, data)
}

// 删除房源（需登录）
export const deleteHouse = (id: number) : Promise<ApiResult> => {
    return del('/house/' + id)
}

// 我的发布（需登录）
export const listMyHouses = (params: UTSJSONObject) : Promise<ApiResult> => {
