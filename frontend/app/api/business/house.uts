// 同城房屋租售模块 API 封装
// 对应后端 backend/internal/modules/house/plugin.go 路由清单（80+ API）
// 路由前缀：/house（由 request.uts 中 BASE_URL 拼接为 /api/v1/house）
// 按场景分组：房源/收藏/发布单/小区/经纪人/合同/看房/VR/房贷/评价/举报/担保/成交/推荐/分类/设施/统计
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 房源 =====
// 房源列表（公开）
export const listHouses = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/house', params)
}

// 房源详情（公开）
export const getHouseDetail = (id: number) : Promise<ApiResult> => {
    return get('/house/' + id)
}

// 搜索房源（公开）
export const searchHouses = (params: UTSJSONObject) : Promise<ApiResult> => {
