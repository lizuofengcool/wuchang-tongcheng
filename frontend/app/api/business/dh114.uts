// 同城114模块 API 封装
// 对应后端 backend/internal/modules/dh114/plugin.go 路由清单（100+ API）
// 路由前缀：/dh114（由 request.uts 中 BASE_URL 拼接为 /api/v1/dh114）
// 按场景分组：商户/商户详情/营业时间/菜单/分类/优惠券/团购/评价/收藏/电话本/认证/推荐
// C 端仅调用公开与登录接口，不含 /admin 后台接口
// 对标大众点评/美团/58同城

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 商户主表（dh114s）=====
// 商户列表（公开）
export const listDh114s = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/dh114', params)
}

// 商户详情（公开）
export const getDh114Detail = (id: number) : Promise<ApiResult> => {
    return get('/dh114/' + id)
}

// 搜索商户（公开）
export const searchDh114s = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/dh114/search', params)
}

// 高级搜索（公开）
export const advancedSearchDh114s = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/dh114/advanced-search', params)
}

// 附近商户（公开）
export const listNearbyDh114s = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/dh114/nearby', params)
}

// 我的发布（需登录）
export const listMyDh114s = () : Promise<ApiResult> => {
    return get('/dh114/mine')
}

// 发布商户（需登录）
export const createDh114 = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/dh114', data)
}

// 更新商户（需登录）
export const updateDh114 = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/dh114/' + id, data)
}

// 删除商户（需登录）
export const deleteDh114 = (id: number) : Promise<ApiResult> => {
    return del('/dh114/' + id)
}

// 分享数 +1（公开）
export const incrDh114Share = (id: number) : Promise<ApiResult> => {
    return post('/dh114/' + id + '/share', null)
}

// 联系数 +1（公开）
export const incrDh114Contact = (id: number) : Promise<ApiResult> => {
    return post('/dh114/' + id + '/contact', null)
}

// 记录浏览（公开）
export const recordDh114View = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/dh114/views', data)
}

// 记录拨号（公开）
export const recordDh114Call = (id: number) : Promise<ApiResult> => {
    return post('/dh114/' + id + '/calls', null)
}

// ===== 商户收藏快捷操作 =====
// 收藏（需登录）
export const favDh114 = (id: number) : Promise<ApiResult> => {
    return post('/dh114/' + id + '/fav', null)
}

// 取消收藏（需登录）
export const unfavDh114 = (id: number) : Promise<ApiResult> => {
    return del('/dh114/' + id + '/fav')
}

// 收藏状态（需登录）
export const favStatusDh114 = (id: number) : Promise<ApiResult> => {
    return get('/dh114/' + id + '/fav-status')
}

// 我的收藏列表（需登录）
export const listFavDh114s = () : Promise<ApiResult> => {
    return get('/dh114/favs')
}

// ===== 商户详情（businesses）=====
// 商户详情列表（公开）
export const listBusinesses = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/dh114/businesses', params)
}

// 商户详情（公开）
export const getBusinessDetail = (id: number) : Promise<ApiResult> => {
    return get('/dh114/businesses/' + id)
}

// 按商户ID查询商户详情（公开）
export const getBusinessByDh114 = (id: number) : Promise<ApiResult> => {
    return get('/dh114/' + id + '/business')
}

// 创建商户详情（需登录）
export const createBusiness = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/dh114/businesses', data)
}

// 更新商户详情（需登录）
export const updateBusiness = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/dh114/businesses/' + id, data)
}

// 删除商户详情（需登录）
export const deleteBusiness = (id: number) : Promise<ApiResult> => {
    return del('/dh114/businesses/' + id)
}

