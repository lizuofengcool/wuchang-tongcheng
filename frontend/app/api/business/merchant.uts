// 商家端 API 封装
// 对应后端：
//   - merchant 中台（/merchant/*）
//   - mall 模块商家维度 API（/mall/products, /mall/orders, /mall/refunds, /mall/logistics, /mall/reviews, /mall/statistics, /mall/audit-rules, /mall/reports）
//   - marketing 营销中台（/marketing/coupons, /marketing/activities）
// 路由前缀由 request.uts BASE_URL 拼接为 /api/v1/{module}/...
// 风格对标 frontend/app/api/business/mall.uts
// 对标美团商家版 / 饿了么商家版

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== merchant 中台 - 店铺（shops）=====
// 店铺列表
export const listMerchantShops = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/merchant/shops', params)
}

// 店铺详情（按搜索）
export const searchMerchantShop = (id: number) : Promise<ApiResult> => {
    return get('/merchant/shops/search/' + id)
}

// 申请入驻
export const applyMerchantShop = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/merchant/shops/apply', data)
}

// 认领店铺
export const claimMerchantShop = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/merchant/shops/claim', data)
}

// 我的店铺
export const getMyMerchantShop = () : Promise<ApiResult> => {
    return get('/merchant/shops/mine')
}

// 更新店铺
export const updateMerchantShop = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/merchant/shops/' + id, data)
}

// ===== merchant 中台 - 员工（staff）=====
// 员工详情
export const getMerchantStaffDetail = (id: number) : Promise<ApiResult> => {
    return get('/merchant/staff/' + id)
}

// 员工列表
export const listMerchantStaff = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/merchant/staff', params)
}

// 添加员工
export const createMerchantStaff = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/merchant/staff', data)
}

// 更新员工
export const updateMerchantStaff = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/merchant/staff/' + id, data)
}

// 删除员工
export const deleteMerchantStaff = (id: number) : Promise<ApiResult> => {
    return del('/merchant/staff/' + id)
}

// 更新员工权限
export const updateMerchantStaffPermissions = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/merchant/staff/' + id + '/permissions', data)
}

// 更新员工角色
export const updateMerchantStaffRole = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/merchant/staff/' + id + '/role', data)
}

