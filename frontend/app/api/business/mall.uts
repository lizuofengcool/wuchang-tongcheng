// 同城商城模块 API 封装
// 对应后端 backend/internal/modules/mall/plugin.go 路由清单（180+ API）
// 路由前缀：/mall（由 request.uts 中 BASE_URL 拼接为 /api/v1/mall）
// 按场景分组：店铺/商品/SKU/分类/购物车/订单/支付/退款/收货地址/评价/物流/举报/统计/审核规则
// C 端仅调用公开与登录接口，不含 /admin 后台接口
// 对标淘宝/京东/拼多多同城商城

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 店铺（shops）=====
// 店铺列表（公开）
export const listMallShops = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/mall/shops', params)
}

// 店铺搜索（公开）
export const searchMallShops = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/mall/shops/search', params)
}

// 按用户列出店铺（公开）
export const listMallShopsByUser = (userId: number, params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/mall/shops/by-user/' + userId, params)
}

// 按分类列出店铺（公开）
export const listMallShopsByCategory = (categoryId: number, params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/mall/shops/by-category/' + categoryId, params)
}

// 店铺详情（公开）
export const getMallShopDetail = (id: number) : Promise<ApiResult> => {
    return get('/mall/shops/' + id)
}

// 我的店铺（需登录）
export const getMyMallShop = () : Promise<ApiResult> => {
    return get('/mall/shops/mine')
}

// 创建店铺（需登录）
export const createMallShop = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/mall/shops', data)
}

// 更新店铺（需登录）
export const updateMallShop = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/mall/shops/' + id, data)
}

// 删除店铺（需登录）
export const deleteMallShop = (id: number) : Promise<ApiResult> => {
    return del('/mall/shops/' + id)
}

// 更新店铺状态（需登录）
export const updateMallShopStatus = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/mall/shops/' + id + '/status', data)
}

// 店铺浏览数 +1（公开）
export const incrMallShopView = (id: number) : Promise<ApiResult> => {
    return post('/mall/shops/' + id + '/view', null)
}

