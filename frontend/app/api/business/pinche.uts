    return get('/pinche/trips/share/' + token)
}

// 拼车关联行程（公开）
export const listTripsByPinche = (pincheId: number) : Promise<ApiResult> => {
    return get('/pinche/pinches/' + pincheId + '/trips')
}

// 开始行程（需登录，车主触发）
export const startTrip = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/pinche/trips', data)
}

// 完成行程（需登录，车主触发）
export const completeTrip = (id: number) : Promise<ApiResult> => {
    return put('/pinche/trips/' + id + '/complete', null)
}

// 确认行程（需登录，乘客确认）
export const confirmTrip = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/pinche/trips/' + id + '/confirm', data)
}

// 我的行程（需登录）
export const listMyTrips = () : Promise<ApiResult> => {
    return get('/pinche/trips/mine')
}

// 车主行程（需登录）
