    return get('/pinche/trips/driver/' + driverId)
}

// 乘客行程（需登录）
export const listPassengerTrips = (passengerId: number) : Promise<ApiResult> => {
    return get('/pinche/trips/passenger/' + passengerId)
}

// 行程分享（需登录，生成分享 token）
export const shareTrip = (id: number) : Promise<ApiResult> => {
    return post('/pinche/trips/' + id + '/share', null)
}

