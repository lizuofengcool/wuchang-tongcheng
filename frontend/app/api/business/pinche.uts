// 同城拼车出行模块 API 封装
// 对应后端 backend/internal/modules/pinche/plugin.go 路由清单（80+ API）
// 路由前缀：/pinche（由 request.uts 中 BASE_URL 拼接为 /api/v1/pinche）
// 按场景分组：拼车/路线/行程/预订/车主/车辆/支付/评价/保险/紧急联系
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 拼车行程（pinches） =====
// 拼车列表（公开）
export const listPinches = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/pinche', params)
}

// 拼车详情（公开）
export const getPincheDetail = (id: number) : Promise<ApiResult> => {
    return get('/pinche/' + id)
}

// 搜索拼车（公开）
export const searchPinches = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/pinche/search', params)
}

// 附近拼车（公开）
export const listNearbyPinches = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/pinche/nearby', params)
}

// 智能匹配（公开，按起点/终点/时间/座位/车主评分综合匹配）
export const matchPinches = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/pinche/match', params)
}

// 我的拼车发布（需登录）
export const listMyPinches = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/pinche/mine', params)
}

// 发布拼车（需登录）
export const createPinche = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/pinche', data)
}

// 更新拼车（需登录）
export const updatePinche = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/pinche/' + id, data)
}

// 删除拼车（需登录）
export const deletePinche = (id: number) : Promise<ApiResult> => {
    return del('/pinche/' + id)
}

// 联系量自增（公开，电话/IM 触发）
export const incrPincheContact = (id: number) : Promise<ApiResult> => {
    return post('/pinche/' + id + '/contact', null)
}

// 分享量自增（公开，分享行程触发）
export const incrPincheShare = (id: number) : Promise<ApiResult> => {
    return post('/pinche/' + id + '/share', null)
}

// 浏览量自增（公开）
export const recordPincheView = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/pinche/views', data)
}

