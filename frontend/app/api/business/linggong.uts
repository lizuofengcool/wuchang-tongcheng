// ===== 搜索历史（本地存储） =====
export const getSearchHistory = () : string[] => {
    const data = uni.getStorageSync('linggong_search_history')
    if (data instanceof Array) return data as string[]
    return [] as string[]
}

export const clearSearchHistory = () => {
    uni.removeStorageSync('linggong_search_history')
}

export const addSearchHistory = (keyword: string) => {
    if (keyword.length == 0) return
    const list = getSearchHistory()
    const idx = list.indexOf(keyword)
    if (idx >= 0) list.splice(idx, 1)
    list.unshift(keyword)
    if (list.length > 20) list.splice(20)
    uni.setStorageSync('linggong_search_history', list)
}
