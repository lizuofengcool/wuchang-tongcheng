// 同城零工兼职模块 API 封装
// 对应后端 backend/internal/modules/linggong/plugin.go 路由清单
// 路由前缀：/linggong（由 request.uts 中 BASE_URL 拼接为 /api/v1/linggong）
// 按场景分组：岗位/任务包/报名/雇主/求职者/合同/支付/评价/技能/证书/信用/审核规则
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 岗位主表（linggongs） =====
// 岗位列表（公开）
export const listLinggongs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/linggong', params)
}

// 岗位详情（公开）
export const getLinggongDetail = (id: number) : Promise<ApiResult> => {
    return get('/linggong/' + id)
}

// 搜索岗位（公开）
export const searchLinggongs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/linggong/search', params)
}

// 附近岗位（公开）
export const listNearbyLinggongs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/linggong/nearby', params)
}

// 我的发布（需登录）
export const listMyLinggongs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/linggong/mine', params)
}

// 发布岗位（需登录）
export const createLinggong = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/linggong', data)
}

// 更新岗位（需登录）
export const updateLinggong = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/linggong/' + id, data)
}

// 删除岗位（需登录）
export const deleteLinggong = (id: number) : Promise<ApiResult> => {
    return del('/linggong/' + id)
}

// 增加浏览数（公开）
export const incrLinggongView = (id: number) : Promise<ApiResult> => {
    return post('/linggong/' + id + '/view', null)
}

// 增加联系数（公开）
export const incrLinggongContact = (id: number) : Promise<ApiResult> => {
