// 同城招聘求职模块 API 封装
// 对应后端 backend/internal/modules/job/plugin.go 路由清单（90+ API）
// 路由前缀：/job（由 request.uts 中 BASE_URL 拼接为 /api/v1/job）
// 按场景分组：职位/收藏/推广/公司/认证/简历/投递/面试/消息/会话/评价/举报/统计
// C 端仅调用公开与登录接口，不含 /admin 后台接口

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 职位 =====
// 职位列表（公开）
export const listJobs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job', params)
}

// 职位详情（公开）
export const getJobDetail = (id: number) : Promise<ApiResult> => {
    return get('/job/' + id)
}

// 搜索职位（公开，走 Elasticsearch）
export const searchJobs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job/search', params)
}

// 高级搜索（公开）
export const advancedSearchJobs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job/advanced-search', params)
}

// 附近职位（公开）
export const listNearbyJobs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job/nearby', params)
}

// 相似职位（公开）
export const listSimilarJobs = (id: number, params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job/' + id + '/similar', params)
}

// 发布职位（需登录）
export const createJob = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/job', data)
}

// 更新职位（需登录）
export const updateJob = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/job/' + id, data)
}

// 删除职位（需登录）
export const deleteJob = (id: number) : Promise<ApiResult> => {
    return del('/job/' + id)
}

// 更新职位状态（需登录，状态机：上架/下架/关闭）
export const updateJobStatus = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/job/' + id + '/status', data)
}

// 我的发布（需登录）
export const listMyJobs = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/job/mine', params)
}

