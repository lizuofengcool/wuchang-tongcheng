// ===== 搜索 =====
// 搜索（公开，走 Elasticsearch）
export const search = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/ershou/search', params)
}

// 高级搜索（公开）
export const advancedSearch = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/ershou/search', params)
}

// 热搜榜（公开）—— 后端统计接口 /statistics/hot-items 替代
export const getHotSearch = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/ershou/statistics/hot-items', params)
}

// 搜索历史（本地存储）
export const getSearchHistory = () : string[] => {
    const data = uni.getStorageSync('ershou_search_history')
    if (data instanceof Array) return data as string[]
    return [] as string[]
}

// 清空搜索历史
export const clearSearchHistory = () => {
    uni.removeStorageSync('ershou_search_history')
}

// 添加搜索历史
export const addSearchHistory = (keyword: string) => {
    if (keyword.length == 0) return
    const list = getSearchHistory()
    const idx = list.indexOf(keyword)
    if (idx >= 0) list.splice(idx, 1)
    list.unshift(keyword)
    if (list.length > 20) list.splice(20)
    uni.setStorageSync('ershou_search_history', list)
}

