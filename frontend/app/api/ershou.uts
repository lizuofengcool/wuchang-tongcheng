// 二手交易模块 API 封装
// 对应后端 backend/internal/modules/ershou/plugin.go 路由清单（100+ API）
// 路由前缀：/ershou（由 request.uts 中 BASE_URL 拼接为 /api/v1/ershou）
// 按场景分组：商品/收藏/留言/搜索/推荐/订单/拍卖/评价/举报/店铺/用户/目录/统计

import { request, get, post, put, del } from '@/utils/request.uts'

// ===== 通用类型 =====
export type PageQuery = {
    page?: number
    page_size?: number
}

// ===== 商品 =====
// 商品列表（公开）
export const listErshous = (params: UTSJSONObject) : Promise<ApiResult> => {
    return get('/ershou', params)
}

// 商品详情（公开）
export const getErshouDetail = (id: number) : Promise<ApiResult> => {
    return get('/ershou/' + id)
}

// 发布商品（需登录）
export const createErshou = (data: UTSJSONObject) : Promise<ApiResult> => {
    return post('/ershou', data)
}

// 更新商品（需登录）
export const updateErshou = (id: number, data: UTSJSONObject) : Promise<ApiResult> => {
    return put('/ershou/' + id, data)
}

// 删除商品（需登录）
export const deleteErshou = (id: number) : Promise<ApiResult> => {
    return del('/ershou/' + id)
}

// 我的发布（需登录）
export const listMine = (params: UTSJSONObject) : Promise<ApiResult> => {
