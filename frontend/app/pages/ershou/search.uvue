<template>
    <view class="page">
        <!-- 顶部搜索框 -->
        <view class="search-bar">
            <view class="search-box">
                <text class="search-icon">🔍</text>
                <input class="search-input" placeholder="搜索二手好物..." v-model="keyword" :focus="autoFocus" confirm-type="search" @confirm="doSearch" @input="onInput" />
                <text class="clear-icon" v-if="keyword.length > 0" @click="clearKeyword">×</text>
            </view>
            <text class="cancel-btn" @click="goBack">取消</text>
        </view>

        <scroll-view class="content" scroll-y>
            <!-- 搜索建议 -->
            <view class="suggest-section" v-if="suggestions.length > 0 && keyword.length > 0">
                <view class="suggest-item" v-for="(s, idx) in suggestions" :key="idx" @click="tapSuggest(s)">
                    <text class="suggest-text">{{ s }}</text>
                </view>
            </view>

            <!-- 历史搜索 -->
            <view class="section" v-if="keyword.length == 0">
                <view class="section-header">
                    <text class="section-title">历史搜索</text>
                    <text class="section-action" v-if="historyList.length > 0" @click="clearHistory">清空</text>
                </view>
                <view class="tags" v-if="historyList.length > 0">
                    <view class="tag" v-for="(item, index) in historyList" :key="index" @click="tapTag(item)">
                        <text class="tag-text">{{ item }}</text>
                    </view>
                </view>
                <view class="empty-tip" v-else>
                    <text class="empty-tip-text">暂无历史记录</text>
                </view>
            </view>

            <!-- 热门搜索 -->
            <view class="section" v-if="keyword.length == 0">
                <view class="section-header">
                    <text class="section-title">热门搜索</text>
                </view>
                <view class="hot-list">
                    <view class="hot-item" v-for="(item, index) in hotList" :key="index" @click="tapTag(item)">
                        <text class="hot-rank" :class="{ top: index < 3 }">{{ index + 1 }}</text>
                        <text class="hot-text">{{ item }}</text>
                    </view>
                </view>
            </view>

            <!-- 搜索结果 -->
            <view class="result-section" v-if="searched">
                <view class="result-header">
                    <text class="result-count">共 {{ total }} 件相关商品</text>
                    <view class="sort-row">
                        <text class="sort-item" :class="{ active: sort == 'popular' }" @click="changeSort('popular')">综合</text>
                        <text class="sort-item" :class="{ active: sort == 'price_asc' }" @click="changeSort('price_asc')">价格↑</text>
                        <text class="sort-item" :class="{ active: sort == 'price_desc' }" @click="changeSort('price_desc')">价格↓</text>
                        <text class="sort-item" :class="{ active: sort == 'latest' }" @click="changeSort('latest')">最新</text>
                    </view>
                </view>
                <er-item-list v-for="item in resultList" :key="item.id" :item="item" @click="goDetail" />
                <view class="load-more" v-if="loading">
                    <text class="load-text">加载中...</text>
                </view>
                <view class="no-more" v-if="!hasMore && resultList.length > 0">
                    <text class="no-more-text">已经到底啦~</text>
                </view>
                <er-empty-state v-if="resultList.length == 0 && !loading" icon="🔍" text="未找到相关商品" btnText="换个关键词" @click="clearKeyword" />
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { search, getHotSearch, getSearchHistory, addSearchHistory, clearSearchHistory } from '@/api/ershou.uts'

    type ResultItem = {
        id: number
        title: string
        summary: string
        cover_image: string
        price: number
        original_price: number
        condition: string
        address: string
        distance: number
        user_name: string
        user_avatar: string
        view_count: number
        fav_count: number
        message_count: number
        is_urgent: boolean
        is_auction: boolean
        bargainable: boolean
        featured: boolean
    }

    const keyword = ref('')
    const autoFocus = ref(true)
    const historyList = ref<string[]>([] as string[])
    const hotList = ref<string[]>(['iPhone 15', '九成新笔记本', '二手电动车', '佳能相机', '儿童玩具', '商品房出租', '小米电视', '二手沙发'])
    const suggestions = ref<string[]>([] as string[])
    const resultList = ref<ResultItem[]>([] as ResultItem[])
    const searched = ref(false)
    const loading = ref(false)
    const hasMore = ref(true)
    const total = ref(0)
    const page = ref(1)
    const pageSize = 20
    const sort = ref('popular')
    let inputTimer = 0

    const loadHistory = () => {
        historyList.value = getSearchHistory()
    }

    const onInput = () => {
        // 简化：直接展示热搜词作为建议
        if (keyword.value.length == 0) {
            suggestions.value = [] as string[]
            return
        }
        if (inputTimer != 0) clearTimeout(inputTimer)
        inputTimer = setTimeout(() => {
            // 取热搜词中包含 keyword 的
            const k = keyword.value
            const arr = hotList.value.filter((s: string) : boolean => s.indexOf(k) >= 0)
            suggestions.value = arr
        }, 300) as number
    }

    const doSearch = () => {
        if (keyword.value.length == 0) {
            uni.showToast({ title: '请输入关键词', icon: 'none' })
            return
        }
        addSearchHistory(keyword.value)
        loadHistory()
        suggestions.value = [] as string[]
        searched.value = true
        page.value = 1
        hasMore.value = true
        resultList.value = [] as ResultItem[]
        loadResults()
    }

    const loadResults = async () => {
        if (loading.value || !hasMore.value) return
        loading.value = true
        try {
            const params = {
                keyword: keyword.value,
                page: page.value,
                page_size: pageSize,
                sort: sort.value
            } as UTSJSONObject
            const res = await search(params)
            const data = res.data as UTSJSONObject
            const list = (data['list'] as ResultItem[]) ?? ([] as ResultItem[])
            total.value = (data['total'] as number) ?? 0
            if (page.value == 1) {
                resultList.value = list
            } else {
                resultList.value = resultList.value.concat(list)
            }
            hasMore.value = list.length >= pageSize
        } catch (e) {
            // 错误统一处理
        } finally {
            loading.value = false
        }
    }

    const changeSort = (s: string) => {
        sort.value = s
        page.value = 1
        hasMore.value = true
        resultList.value = [] as ResultItem[]
        loadResults()
    }

    const tapTag = (text: string) => {
        keyword.value = text
        doSearch()
    }

    const tapSuggest = (text: string) => {
        keyword.value = text
        doSearch()
    }

    const clearKeyword = () => {
        keyword.value = ''
        searched.value = false
        resultList.value = [] as ResultItem[]
        suggestions.value = [] as string[]
    }

    const clearHistory = () => {
        uni.showModal({
            title: '清空历史',
            content: '确定清空所有搜索历史吗？',
            success: (r: ShowModalSuccessCallbackResult) => {
                if (r.confirm) {
                    clearSearchHistory()
                    loadHistory()
                    uni.showToast({ title: '已清空', icon: 'none' })
                }
            }
        })
    }

    const goBack = () => {
        uni.navigateBack()
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/ershou/detail?id=' + id })
    }

    onLoad(() => {
        loadHistory()
    })

    onReachBottom(() => {
        if (!hasMore.value || loading.value) return
        page.value++
        loadResults()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
    }

    .search-box {
        flex: 1;
        flex-direction: row;
        align-items: center;
        background-color: #F5F5F5;
        border-radius: 20px;
        padding: 8px 12px;
    }

    .search-icon {
        font-size: 14px;
        margin-right: 8px;
    }

    .search-input {
        flex: 1;
        font-size: 14px;
        color: #333;
    }

    .clear-icon {
        font-size: 18px;
        color: #999;
        padding: 0 4px;
    }

    .cancel-btn {
        font-size: 14px;
        color: #FF6B35;
        margin-left: 12px;
    }

    .content {
        flex: 1;
    }

    .suggest-section {
        background-color: #FFFFFF;
        padding: 4px 0;
    }

    .suggest-item {
        padding: 10px 16px;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .suggest-text {
        font-size: 14px;
        color: #333;
    }

    .section {
        background-color: #FFFFFF;
        padding: 16px;
        margin-top: 8px;
    }

    .section-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .section-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
    }

    .section-action {
        font-size: 12px;
        color: #999;
    }

    .tags {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .tag {
        background-color: #F5F5F5;
        border-radius: 16px;
        padding: 6px 14px;
        margin-right: 8px;
        margin-bottom: 8px;
    }

    .tag-text {
        font-size: 13px;
        color: #666;
    }

    .empty-tip {
        padding: 16px 0;
        align-items: center;
    }

    .empty-tip-text {
        font-size: 13px;
        color: #BBB;
    }

    .hot-list {
        flex-direction: column;
    }

    .hot-item {
        flex-direction: row;
        align-items: center;
        padding: 10px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .hot-rank {
        font-size: 14px;
        color: #999;
        width: 24px;
        font-weight: 600;
    }

    .hot-rank.top {
        color: #FF6B35;
    }

    .hot-text {
        font-size: 14px;
        color: #333;
    }

    .result-section {
        background-color: #FFFFFF;
        padding: 12px;
        margin-top: 8px;
    }

    .result-header {
        margin-bottom: 10px;
    }

    .result-count {
        font-size: 12px;
        color: #999;
        margin-bottom: 8px;
    }

    .sort-row {
        flex-direction: row;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
        padding: 8px 0;
    }

    .sort-item {
        flex: 1;
        font-size: 12px;
        color: #666;
        text-align: center;
    }

    .sort-item.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .load-more, .no-more {
        padding: 16px;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
