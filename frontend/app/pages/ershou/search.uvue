<template>
    <view class="page">
        <!-- 顶部搜索框 -->
        <view class="search-bar">
            <view class="search-box">
                <text class="search-icon">🔍</text>
                <input class="search-input" placeholder="搜索二手物品..." v-model="keyword" :focus="autoFocus" confirm-type="search" @confirm="doSearch" />
            </view>
            <text class="cancel-btn" @click="goBack">取消</text>
        </view>

        <view class="content">
            <text class="placeholder">搜索结果开发中</text>
            <text class="hint">P2 阶段完善：搜索结果列表、筛选、排序、历史搜索</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    const keyword = ref('')
    const autoFocus = ref(true)

    const doSearch = () => {
        if (keyword.value.length == 0) {
            uni.showToast({ title: '请输入关键词', icon: 'none' })
            return
        }
        uni.showToast({ title: '搜索功能开发中', icon: 'none' })
    }

    const goBack = () => {
        uni.navigateBack()
    }
</script>

