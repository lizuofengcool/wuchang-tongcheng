<template>
    <view class="page">
        <!-- 顶部 Tab -->
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>

        <!-- 数据统计 -->
        <view class="stats-card">
            <view class="stat-item">
                <text class="stat-value">{{ stats.total }}</text>
                <text class="stat-label">总发布</text>
            </view>
            <view class="stat-item">
                <text class="stat-value">{{ stats.sold }}</text>
                <text class="stat-label">已售出</text>
            </view>
            <view class="stat-item">
                <text class="stat-value">{{ stats.views }}</text>
                <text class="stat-label">总浏览</text>
            </view>
            <view class="stat-item">
                <text class="stat-value">{{ stats.favs }}</text>
                <text class="stat-label">总收藏</text>
            </view>
        </view>

        <!-- 商品列表 -->
        <scroll-view class="goods-list" scroll-y @scrolltolower="loadMore">
            <view class="goods-card" v-for="item in goodsList" :key="item.id">
                <image class="goods-img" :src="item.cover_image" mode="aspectFill" lazy-load="true" @click="goDetail(item.id)" />
                <view class="goods-info">
                    <text class="goods-title" @click="goDetail(item.id)">{{ item.title }}</text>
                    <view class="goods-meta">
                        <text class="goods-price">¥{{ formatPrice(item.price) }}</text>
                        <text class="goods-status" :class="item.status">{{ getStatusText(item.status) }}</text>
                    </view>
                    <view class="goods-stats">
                        <text class="stat">浏览 {{ item.view_count }}</text>
                        <text class="stat">收藏 {{ item.fav_count }}</text>
                        <text class="stat" v-if="item.status == 'sold'">售出 ¥{{ formatPrice(item.sold_price) }}</text>
                    </view>
                    <view class="goods-actions">
                        <view class="action-btn outline" @click="doAction('edit', item)">
                            <text class="action-btn-text">编辑</text>
                        </view>
                        <view class="action-btn outline" v-if="item.status == 'on_sale'" @click="doAction('unshelve', item)">
                            <text class="action-btn-text">下架</text>
                        </view>
                        <view class="action-btn outline" v-if="item.status == 'off_shelf' || item.status == 'draft'" @click="doAction('republish', item)">
                            <text class="action-btn-text primary">重新发布</text>
                        </view>
                        <view class="action-btn outline" @click="doAction('delete', item)">
                            <text class="action-btn-text danger">删除</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && goodsList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <er-empty-state v-if="goodsList.length == 0 && !loading" icon="📦" text="暂无相关商品" btn-text="去发布" @click="goPublish" />
        </scroll-view>

        <!-- 悬浮发布按钮 -->
        <view class="fab-btn" @click="goPublish">
            <text class="fab-icon">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listMine, updateErshou, deleteErshou } from '@/api/ershou.uts'

    type GoodsItem = {
        id: number
        title: string
        cover_image: string
        price: number
        sold_price: number
        status: string
        view_count: number
        fav_count: number
    }
    type Stats = {
        total: number
        sold: number
        views: number
        favs: number
    }

    const tabs = ref([
        { key: 'on_sale', name: '在售' },
        { key: 'sold', name: '已售' },
        { key: 'off_shelf', name: '下架' },
        { key: 'draft', name: '草稿' }
    ] as { key: string, name: string }[])
    const currentTab = ref(0)
    const goodsList = ref([] as GoodsItem[])
    const stats = ref({ total: 0, sold: 0, views: 0, favs: 0 } as Stats)
    const page = ref(1)
    const pageSize = 10
    const loading = ref(false)
    const hasMore = ref(true)

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            status: tabs.value[currentTab.value].key,
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listMine(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                goodsList.value = (d['list'] as GoodsItem[]) ?? ([] as GoodsItem[])
                stats.value = {
                    total: (d['total'] as number) ?? 0,
                    sold: (d['sold'] as number) ?? 0,
                    views: (d['views'] as number) ?? 0,
                    favs: (d['favs'] as number) ?? 0
                } as Stats
                if (reset) {
                    goodsList.value = (d['list'] as GoodsItem[]) ?? ([] as GoodsItem[])
                } else {
                    const list = (d['list'] as GoodsItem[]) ?? ([] as GoodsItem[])
                    goodsList.value = goodsList.value.concat(list)
                }
                const listLen = ((d['list'] as GoodsItem[]) ?? ([] as GoodsItem[])).length
                hasMore.value = listLen >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const getStatusText = (status: string): string => {
        const map: UTSJSONObject = {
            on_sale: '在售',
            sold: '已售',
            off_shelf: '已下架',
            draft: '草稿',
            audit: '审核中',
            rejected: '审核未通过'
        } as UTSJSONObject
        return (map[status] as string) ?? status
    }

    const formatPrice = (price: number): string => {
        return (price / 100).toFixed(2)
    }

    const doAction = (action: string, item: GoodsItem) => {
        if (action == 'edit') {
            uni.navigateTo({ url: '/pages/ershou/publish?id=' + item.id })
        } else if (action == 'unshelve') {
            uni.showModal({
                title: '下架商品',
                content: '确认下架该商品？',
                success: (res) => {
                    if (res.confirm) {
                        updateErshou(item.id, { status: 'off_shelf' } as UTSJSONObject).then((r: ApiResult) => {
                            if (r.code == 200) {
                                uni.showToast({ title: '已下架', icon: 'success' })
                                loadList(true)
                            } else {
                                uni.showToast({ title: r.message || '操作失败', icon: 'none' })
                            }
                        })
                    }
                }
            })
        } else if (action == 'republish') {
            updateErshou(item.id, { status: 'on_sale' } as UTSJSONObject).then((r: ApiResult) => {
                if (r.code == 200) {
                    uni.showToast({ title: '已重新发布', icon: 'success' })
                    loadList(true)
                } else {
                    uni.showToast({ title: r.message || '操作失败', icon: 'none' })
                }
            })
        } else if (action == 'delete') {
            uni.showModal({
                title: '删除商品',
                content: '删除后无法恢复，确认删除？',
                success: (res) => {
                    if (res.confirm) {
                        deleteErshou(item.id).then((r: ApiResult) => {
                            if (r.code == 200) {
                                uni.showToast({ title: '已删除', icon: 'success' })
                                loadList(true)
                            } else {
                                uni.showToast({ title: r.message || '删除失败', icon: 'none' })
                            }
                        })
                    }
                }
            })
        }
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/ershou/detail?id=' + id })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/ershou/publish' })
    }
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom: 1px solid #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 14px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .stats-card {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 16px 0;
        margin-bottom: 8px;
    }

    .stat-item {
        flex: 1;
        align-items: center;
    }

    .stat-value {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 600;
    }

    .stat-label {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
    }

    .goods-list {
        flex: 1;
        padding: 12px;
    }

    .goods-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 12px;
        flex-direction: row;
    }

    .goods-img {
        width: 100px;
        height: 100px;
        border-radius: 8px;
        background-color: #F5F5F5;
    }

    .goods-info {
        flex: 1;
        margin-left: 12px;
    }

    .goods-title {
        font-size: 14px;
        color: #333;
        font-weight: 500;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .goods-meta {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
    }

    .goods-price {
        font-size: 15px;
        color: #FF6B35;
        font-weight: 600;
    }

    .goods-status {
        font-size: 11px;
        color: #999;
        margin-left: 8px;
        padding: 2px 6px;
        background-color: #F5F5F5;
        border-radius: 4px;
    }

    .goods-status.sold {
        color: #07C160;
        background-color: #F0FFF8;
    }

    .goods-stats {
        flex-direction: row;
        margin-top: 8px;
    }

    .stat {
        font-size: 11px;
        color: #999;
        margin-right: 12px;
    }

    .goods-actions {
        flex-direction: row;
        margin-top: 8px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 4px 10px;
        border-radius: 14px;
        border: 1px solid #DDDDDD;
        margin-left: 6px;
        margin-top: 4px;
    }

    .action-btn-text {
        font-size: 12px;
        color: #666;
    }

    .action-btn-text.primary {
        color: #FF6B35;
    }

    .action-btn-text.danger {
        color: #EE0A24;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .fab-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(255, 107, 53, 0.4);
    }

    .fab-icon {
        font-size: 28px;
        color: #FFFFFF;
        font-weight: 300;
    }
</style>
