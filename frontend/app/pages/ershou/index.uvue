<template>
    <view class="page">
        <!-- 顶部搜索栏 -->
        <view class="header" :style="{ paddingTop: statusBarHeight + 'px' }">
            <view class="search-box" @click="goSearch">
                <text class="search-icon">🔍</text>
                <text class="search-placeholder">搜你想淘的好物</text>
            </view>
            <view class="header-actions">
                <view class="action-icon" @click="goMessages">
                    <text class="action-text">💬</text>
                </view>
                <view class="action-icon" @click="scanCode">
                    <text class="action-text">☖</text>
                </view>
            </view>
        </view>

        <scroll-view class="main-scroll" scroll-y @scrolltolower="loadMore">
            <!-- 分类导航 -->
            <scroll-view class="category-nav" scroll-x>
                <view class="category-item" v-for="item in categories" :key="item.id" @click="goCategory(item.id)">
                    <text class="category-icon">{{ item.icon }}</text>
                    <text class="category-name">{{ item.name }}</text>
                </view>
            </scroll-view>

            <!-- 金刚位 -->
            <view class="kingkong">
                <view class="kingkong-item" v-for="(item, idx) in kingkongs" :key="idx" @click="goKingkong(item.key)">
                    <view class="kingkong-icon-wrap" :style="{ backgroundColor: item.bg }">
                        <text class="kingkong-icon">{{ item.icon }}</text>
                    </view>
                    <text class="kingkong-name">{{ item.name }}</text>
                </view>
            </view>

            <!-- 推荐流标题 -->
            <view class="section-header">
                <text class="section-title">为你推荐</text>
                <text class="section-sub">发现附近好物</text>
            </view>

            <!-- 瀑布流（双列网格） -->
            <view class="waterfall">
                <view class="waterfall-col">
                    <er-item-card v-for="item in leftCol" :key="item.id" :item="item" @click="goDetail" />
                </view>
                <view class="waterfall-col">
                    <er-item-card v-for="item in rightCol" :key="item.id" :item="item" @click="goDetail" />
                </view>
            </view>

            <!-- 加载状态 -->
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && feedList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <er-empty-state v-if="feedList.length == 0 && !loading" icon="📭" text="暂无好物，下拉刷新试试" />
        </scroll-view>

        <!-- 底部 Tab -->
        <view class="tab-bar">
            <view class="tab-item" @click="goTab('home')">
                <text class="tab-icon active">🏠</text>
                <text class="tab-text active">首页</text>
            </view>
            <view class="tab-item" @click="goTab('publish')">
                <text class="tab-icon">+</text>
                <text class="tab-text">发布</text>
            </view>
            <view class="tab-item" @click="goTab('orders')">
                <text class="tab-icon">📋</text>
                <text class="tab-text">订单</text>
            </view>
            <view class="tab-item" @click="goTab('my')">
                <text class="tab-icon">👤</text>
                <text class="tab-text">我的</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listErshous, nearby, getHotItems } from '@/api/ershou.uts'

    const statusBarHeight = state.statusBarHeight

    type Category = { id: number, name: string, icon: string }
    type Kingkong = { key: string, name: string, icon: string, bg: string }
    type FeedItem = {
        id: number
        title: string
        cover_image: string
        price: number
        original_price: number
        price_unit: string
        address: string
        distance: number
        user_name: string
        user_avatar: string
        view_count: number
        fav_count: number
        is_urgent: boolean
        is_auction: boolean
    }

    const categories = ref<Category[]>([
        { id: 1, name: '数码', icon: '📱' },
        { id: 2, name: '服饰', icon: '👕' },
        { id: 3, name: '家居', icon: '🛋️' },
        { id: 4, name: '书籍', icon: '📚' },
        { id: 5, name: '母婴', icon: '🍼' },
        { id: 6, name: '运动', icon: '⚽' },
        { id: 7, name: '虚拟', icon: '🎫' },
        { id: 8, name: '其他', icon: '🎁' }
    ] as Category[])

    const kingkongs = ref<Kingkong[]>([
        { key: 'recommend', name: '推荐', icon: '🔥', bg: '#FFE5E5' },
        { key: 'nearby', name: '附近', icon: '📍', bg: '#E5F5FF' },
        { key: 'samecity', name: '同城', icon: '🏙️', bg: '#FFF5E5' },
        { key: 'live', name: '直播', icon: '🎥', bg: '#F5E5FF' },
        { key: 'auction', name: '拍卖', icon: '🔨', bg: '#E5FFF5' },
        { key: 'lowprice', name: '低价', icon: '💰', bg: '#E5FFE5' },
        { key: 'new', name: '新品', icon: '✨', bg: '#FFFFE5' },
        { key: 'urgent', name: '急转', icon: '⚡', bg: '#FFE5F5' }
    ] as Kingkong[])

    const feedList = ref<FeedItem[]>([] as FeedItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const leftCol = computed(() : FeedItem[] => {
        return feedList.value.filter((_: FeedItem, idx: number) : boolean => idx % 2 == 0)
    })

    const rightCol = computed(() : FeedItem[] => {
        return feedList.value.filter((_: FeedItem, idx: number) : boolean => idx % 2 == 1)
    })

    const loadData = async () => {
        if (loading.value || !hasMore.value) return
        loading.value = true
        try {
            const params = {
                page: page.value,
                page_size: pageSize,
                sort: 'popular'
            } as UTSJSONObject
            const res = await listErshous(params)
            const data = res.data as UTSJSONObject
            const list = data['list'] as FeedItem[] ?? ([] as FeedItem[])
            if (page.value == 1) {
                feedList.value = list
            } else {
                feedList.value = feedList.value.concat(list)
            }
            hasMore.value = list.length >= pageSize
        } catch (e) {
            // 错误由 request 统一处理
        } finally {
            loading.value = false
        }
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        page.value++
        loadData()
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/ershou/search' })
    }

    const goMessages = () => {
        uni.navigateTo({ url: '/pages/ershou/messages' })
    }

    const scanCode = () => {
        uni.scanCode({
            success: (res: ScanCodeSuccessCallbackResult) => {
                if (res.result.length > 0) {
                    uni.showToast({ title: '扫码结果：' + res.result, icon: 'none' })
                }
            },
            fail: (_: UniError) => {
                uni.showToast({ title: '扫码取消', icon: 'none' })
            }
        })
    }

    const goCategory = (categoryId: number) => {
        uni.navigateTo({ url: '/pages/ershou/list?category_id=' + categoryId })
    }

    const goKingkong = (key: string) => {
        if (key == 'recommend') {
            page.value = 1
            hasMore.value = true
            feedList.value = [] as FeedItem[]
            loadData()
            return
        }
        if (key == 'nearby') {
            uni.navigateTo({ url: '/pages/ershou/list?sort=nearby' })
            return
        }
        if (key == 'auction') {
            uni.navigateTo({ url: '/pages/ershou/list?auction=1' })
            return
        }
        if (key == 'urgent') {
            uni.navigateTo({ url: '/pages/ershou/list?urgent=1' })
            return
        }
        if (key == 'lowprice') {
            uni.navigateTo({ url: '/pages/ershou/list?sort=price_asc' })
            return
        }
        if (key == 'new') {
            uni.navigateTo({ url: '/pages/ershou/list?sort=latest' })
            return
        }
        uni.navigateTo({ url: '/pages/ershou/list?kingkong=' + key })
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/ershou/detail?id=' + id })
    }

    const goTab = (tab: string) => {
        if (tab == 'home') return
        if (tab == 'publish') {
            uni.navigateTo({ url: '/pages/ershou/publish' })
            return
        }
        if (tab == 'orders') {
            uni.navigateTo({ url: '/pages/ershou/orders' })
            return
        }
        if (tab == 'my') {
            uni.switchTab({ url: '/pages/my/my' })
            return
        }
    }

    onPullDownRefresh(() => {
        page.value = 1
        hasMore.value = true
        feedList.value = [] as FeedItem[]
        loadData()
        setTimeout(() => {
            uni.stopPullDownRefresh()
        }, 1000)
    })

    onLoad(() => {
        loadData()
    })

    onShow(() => {
        // 重新进入时刷新
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .header {
        background-color: #FFFFFF;
        padding: 8px 12px;
        flex-direction: row;
        align-items: center;
    }

    .search-box {
        flex: 1;
        flex-direction: row;
        align-items: center;
        background-color: #F5F5F5;
        border-radius: 20px;
        padding: 8px 12px;
    }

    .search-icon {
        font-size: 14px;
        margin-right: 8px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
        flex: 1;
    }

    .header-actions {
        flex-direction: row;
        align-items: center;
        margin-left: 8px;
    }

    .action-icon {
        padding: 4px 8px;
    }

    .action-text {
        font-size: 18px;
    }

    .main-scroll {
        flex: 1;
    }

    .category-nav {
        background-color: #FFFFFF;
        padding: 12px 8px;
        flex-direction: row;
    }

    .category-item {
        align-items: center;
        padding: 4px 12px;
    }

    .category-icon {
        font-size: 28px;
    }

    .category-name {
        font-size: 12px;
        color: #333;
        margin-top: 4px;
    }

    .kingkong {
        background-color: #FFFFFF;
        margin-top: 8px;
        padding: 12px 8px;
        flex-direction: row;
        flex-wrap: wrap;
    }

    .kingkong-item {
        width: 25%;
        align-items: center;
        margin-bottom: 12px;
    }

    .kingkong-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        align-items: center;
        justify-content: center;
    }

    .kingkong-icon {
        font-size: 22px;
    }

    .kingkong-name {
        font-size: 12px;
        color: #333;
        margin-top: 4px;
    }

    .section-header {
        background-color: #FFFFFF;
        margin-top: 8px;
        padding: 12px;
        flex-direction: row;
        align-items: baseline;
    }

    .section-title {
        font-size: 16px;
        color: #333;
        font-weight: 700;
    }

    .section-sub {
        font-size: 11px;
        color: #999;
        margin-left: 8px;
    }

    .waterfall {
        flex-direction: row;
        padding: 8px;
    }

    .waterfall-col {
        flex: 1;
        margin: 0 4px;
    }

    .load-more, .no-more {
        padding: 16px;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        border-top-width: 1px;
        border-top-color: #E5E5E5;
        padding: 6px 0;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        padding: 4px 0;
    }

    .tab-icon {
        font-size: 22px;
        color: #666;
    }

    .tab-icon.active {
        color: #FF6B35;
    }

    .tab-text {
        font-size: 11px;
        color: #666;
        margin-top: 2px;
    }

    .tab-text.active {
        color: #FF6B35;
    }
</style>
