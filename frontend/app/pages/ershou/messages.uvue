<template>
    <view class="page">
        <!-- 顶部 Tab -->
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <view class="tab-text-wrap">
                    <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                    <view class="badge" v-if="tab.unread > 0">
                        <text class="badge-text">{{ tab.unread > 99 ? '99+' : tab.unread }}</text>
                    </view>
                </view>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>

        <!-- 系统/交易消息 -->
        <scroll-view class="msg-list" scroll-y v-if="currentTab <= 1" @scrolltolower="loadMore">
            <view class="msg-card" v-for="msg in msgList" :key="msg.id" @click="readMsg(msg)">
                <view class="msg-icon-wrap" :class="{ unread: !msg.is_read }">
                    <text class="msg-icon">{{ currentTab == 0 ? '📢' : '💰' }}</text>
                    <view class="dot" v-if="!msg.is_read"></view>
                </view>
                <view class="msg-content">
                    <view class="msg-title-row">
                        <text class="msg-title">{{ msg.title }}</text>
                        <text class="msg-time">{{ msg.created_at }}</text>
                    </view>
                    <text class="msg-text">{{ msg.content }}</text>
                    <view class="msg-action" v-if="msg.action_url">
                        <text class="msg-action-text">查看详情 ></text>
                    </view>
                </view>
            </view>

            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && msgList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <er-empty-state v-if="msgList.length == 0 && !loading" :icon="currentTab == 0 ? '📢' : '💰'" :text="currentTab == 0 ? '暂无系统消息' : '暂无交易消息'" />
        </scroll-view>

        <!-- 聊天列表 -->
        <scroll-view class="msg-list" scroll-y v-else @scrolltolower="loadMore">
            <view class="chat-card" v-for="chat in chatList" :key="chat.id" @click="goChat(chat)">
                <view class="chat-avatar-wrap">
                    <image class="chat-avatar" :src="chat.avatar" mode="aspectFill" lazy-load="true" v-if="chat.avatar" />
                    <view class="chat-avatar-placeholder" v-else>
                        <text class="chat-avatar-text">{{ chat.name.charAt(0) }}</text>
                    </view>
                    <view class="dot avatar-dot" v-if="chat.unread > 0"></view>
                </view>
                <view class="chat-content">
                    <view class="chat-title-row">
                        <text class="chat-name">{{ chat.name }}</text>
                        <text class="chat-time">{{ chat.last_time }}</text>
                    </view>
                    <view class="chat-msg-row">
                        <text class="chat-msg">{{ chat.last_message }}</text>
                        <view class="chat-badge" v-if="chat.unread > 0">
                            <text class="chat-badge-text">{{ chat.unread > 99 ? '99+' : chat.unread }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && chatList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <er-empty-state v-if="chatList.length == 0 && !loading" icon="💬" text="暂无聊天消息" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'

    type Tab = { key: string, name: string, unread: number }
    type MsgItem = {
        id: number
        title: string
        content: string
        is_read: boolean
        created_at: string
        action_url: string
    }
    type ChatItem = {
        id: number
        name: string
        avatar: string
        last_message: string
        last_time: string
        unread: number
    }

    const tabs = ref([
        { key: 'system', name: '系统', unread: 2 },
        { key: 'trade', name: '交易', unread: 3 },
        { key: 'chat', name: '聊天', unread: 1 }
    ] as Tab[])
    const currentTab = ref(0)
    const msgList = ref([] as MsgItem[])
    const chatList = ref([] as ChatItem[])
    const page = ref(1)
    const pageSize = 20
    const loading = ref(false)
    const hasMore = ref(false)

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = false
        }
        loading.value = true
        const tabKey = tabs.value[currentTab.value].key
        // 后端消息中心 API 暂未提供，使用本地空数据占位
        // 待后端 /api/v1/ershou/messages 接口就绪后切换为真实请求
        setTimeout(() => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (tabKey == 'chat') {
                if (reset) chatList.value = [] as ChatItem[]
            } else {
                if (reset) msgList.value = [] as MsgItem[]
            }
        }, 200)
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const readMsg = (msg: MsgItem) => {
        if (!msg.is_read) {
            msg.is_read = true
            if (tabs.value[currentTab.value].unread > 0) {
                tabs.value[currentTab.value].unread = tabs.value[currentTab.value].unread - 1
            }
        }
        if (msg.action_url.length > 0) {
            uni.navigateTo({ url: msg.action_url })
        }
    }

    const goChat = (chat: ChatItem) => {
        uni.showToast({ title: '聊天功能开发中', icon: 'none' })
    }
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom: 1px solid #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text-wrap {
        position: relative;
        flex-direction: row;
        align-items: center;
    }

    .tab-text {
        font-size: 14px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .badge {
        background-color: #EE0A24;
        border-radius: 8px;
        padding: 1px 6px;
        margin-left: 4px;
        min-width: 16px;
        align-items: center;
        justify-content: center;
    }

    .badge-text {
        font-size: 10px;
        color: #FFFFFF;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .msg-list {
        flex: 1;
        padding: 12px;
    }

    .msg-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 8px;
        flex-direction: row;
    }

    .msg-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background-color: #FFF5F0;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .msg-icon-wrap.unread {
        background-color: #FF6B35;
    }

    .msg-icon {
        font-size: 20px;
    }

    .dot {
        position: absolute;
        top: 0;
        right: 0;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background-color: #EE0A24;
    }

    .avatar-dot {
        top: -2px;
        right: -2px;
    }

    .msg-content {
        flex: 1;
    }

    .msg-title-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .msg-title {
        font-size: 14px;
        color: #333;
        font-weight: 500;
    }

    .msg-time {
        font-size: 11px;
        color: #999;
    }

    .msg-text {
        font-size: 13px;
        color: #666;
        margin-top: 4px;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .msg-action {
        margin-top: 6px;
    }

    .msg-action-text {
        font-size: 12px;
        color: #FF6B35;
    }

    .chat-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 8px;
        flex-direction: row;
        align-items: center;
    }

    .chat-avatar-wrap {
        position: relative;
        margin-right: 12px;
    }

    .chat-avatar {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #F5F5F5;
    }

    .chat-avatar-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .chat-avatar-text {
        font-size: 20px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .chat-content {
        flex: 1;
    }

    .chat-title-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .chat-name {
        font-size: 14px;
        color: #333;
        font-weight: 500;
    }

    .chat-time {
        font-size: 11px;
        color: #999;
    }

    .chat-msg-row {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-top: 6px;
    }

    .chat-msg {
        flex: 1;
        font-size: 13px;
        color: #999;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .chat-badge {
        background-color: #EE0A24;
        border-radius: 10px;
        padding: 2px 8px;
        margin-left: 8px;
        align-items: center;
        justify-content: center;
    }

    .chat-badge-text {
        font-size: 11px;
        color: #FFFFFF;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
