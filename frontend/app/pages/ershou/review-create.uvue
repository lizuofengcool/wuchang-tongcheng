<template>
    <view class="page">
        <scroll-view class="content" scroll-y>
            <!-- 商品信息 -->
            <view class="item-card card" v-if="item.id > 0">
                <image class="item-img" :src="item.cover_image" mode="aspectFill" lazy-load="true" />
                <view class="item-info">
                    <text class="item-title">{{ item.title }}</text>
                    <text class="item-price">¥{{ formatPrice(item.price) }}</text>
                </view>
            </view>

            <!-- 评分 -->
            <view class="card">
                <text class="card-title">商品评分</text>
                <view class="star-row">
                    <view class="star-item" v-for="i in 5" :key="i" @click="setRating(i)">
                        <text class="star" :class="{ active: i <= rating }">★</text>
                    </view>
                </view>
                <view class="rating-tags">
                    <view class="rating-tag" v-for="(tag, idx) in ratingTags" :key="idx" @click="toggleTag(idx)" :class="{ active: tag.selected }">
                        <text class="tag-text">{{ tag.label }}</text>
                    </view>
                </view>
            </view>

            <!-- 评价内容 -->
            <view class="card">
                <text class="card-title">评价内容</text>
                <textarea class="review-textarea" placeholder="说说商品质量、卖家的服务态度、物流速度..." v-model="content" maxlength="500" />
                <view class="char-count">
                    <text class="char-count-text">{{ content.length }}/500</text>
                </view>
            </view>

            <!-- 上传图片 -->
            <view class="card">
                <view class="card-title-row">
                    <text class="card-title">上传图片</text>
                    <text class="card-sub">最多 9 张</text>
                </view>
                <er-image-uploader :max-count="9" :media-list="mediaList" @change="onMediaChange" />
            </view>

            <!-- 匿名开关 -->
            <view class="card anon-card">
                <text class="anon-label">匿名评价</text>
                <switch :checked="isAnonymous" @change="onAnonymousChange" color="#FF6B35" />
            </view>

            <view style="height: 80px"></view>
        </scroll-view>

        <!-- 底部提交 -->
        <view class="bottom-bar">
            <view class="submit-btn" @click="submitReview">
                <text class="submit-text">发布评价</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { getErshouDetail, createReview } from '@/api/ershou.uts'

    type ItemInfo = {
        id: number
        title: string
        cover_image: string
        price: number
    }
    type RatingTag = {
        label: string
        selected: boolean
    }
    type MediaItem = {
        type: string
        url: string
        thumb: string
    }

    const orderId = ref(0)
    const itemId = ref(0)
    const item = ref({ id: 0, title: '', cover_image: '', price: 0 } as ItemInfo)
    const rating = ref(5)
    const content = ref('')
    const isAnonymous = ref(false)
    const mediaList = ref([] as MediaItem[])
    const ratingTags = ref([
        { label: '质量好', selected: false },
        { label: '价格合理', selected: false },
        { label: '描述相符', selected: false },
        { label: '卖家热情', selected: false },
        { label: '发货快', selected: false },
        { label: '物流快', selected: false },
        { label: '包装好', selected: false },
        { label: '性价比高', selected: false }
    ] as RatingTag[])

    onLoad((options: OnLoadOptions) => {
        const oid = options['order_id']
        const iid = options['item_id']
        if (oid != null) orderId.value = parseInt(oid as string)
        if (iid != null) {
            itemId.value = parseInt(iid as string)
            loadItem()
        }
    })

    const loadItem = () => {
        getErshouDetail(itemId.value).then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                item.value = {
                    id: (d['id'] as number) ?? 0,
                    title: (d['title'] as string) ?? '',
                    cover_image: (d['cover_image'] as string) ?? '',
                    price: (d['price'] as number) ?? 0
                } as ItemInfo
            }
        })
    }

    const setRating = (val: number) => {
        rating.value = val
    }

    const toggleTag = (idx: number) => {
        ratingTags.value[idx].selected = !ratingTags.value[idx].selected
    }

    const onMediaChange = (e: any) => {
        mediaList.value = e.detail as MediaItem[]
    }

    const onAnonymousChange = (e: any) => {
        isAnonymous.value = e.detail.value as boolean
    }

    const formatPrice = (price: number): string => {
        return (price / 100).toFixed(2)
    }

    const submitReview = () => {
        if (rating.value == 0) {
            uni.showToast({ title: '请选择评分', icon: 'none' })
            return
        }
        if (content.value.trim().length == 0) {
            uni.showToast({ title: '请填写评价内容', icon: 'none' })
            return
        }

        const tags = ratingTags.value.filter((t) => t.selected).map((t) => t.label).join('，')
        const params: UTSJSONObject = {
            item_id: itemId.value,
            rating: rating.value,
            content: content.value,
            tags: tags,
            is_anonymous: isAnonymous.value,
            images: mediaList.value.filter((m) => m.type == 'image').map((m) => m.url)
        } as UTSJSONObject

        uni.showLoading({ title: '提交中' })
        createReview(orderId.value, params).then((res: ApiResult) => {
            uni.hideLoading()
            if (res.code == 200) {
                uni.showToast({ title: '评价成功', icon: 'success' })
                setTimeout(() => { uni.navigateBack() }, 1500)
            } else {
                uni.showToast({ title: res.message || '提交失败', icon: 'none' })
            }
        }).catch(() => {
            uni.hideLoading()
        })
    }
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
        padding: 12px;
    }

    .card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
    }

    .item-card {
        flex-direction: row;
        align-items: center;
    }

    .item-img {
        width: 70px;
        height: 70px;
        border-radius: 8px;
        background-color: #F5F5F5;
    }

    .item-info {
        flex: 1;
        margin-left: 12px;
    }

    .item-title {
        font-size: 14px;
        color: #333;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .item-price {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 600;
        margin-top: 8px;
    }

    .card-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .card-title-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }

    .card-sub {
        font-size: 12px;
        color: #999;
    }

    .star-row {
        flex-direction: row;
        margin-bottom: 16px;
    }

    .star-item {
        margin-right: 12px;
    }

    .star {
        font-size: 32px;
        color: #E5E5E5;
    }

    .star.active {
        color: #FF6B35;
    }

    .rating-tags {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .rating-tag {
        background-color: #F5F5F5;
        border-radius: 16px;
        padding: 6px 14px;
        margin-right: 8px;
        margin-bottom: 8px;
        border: 1px solid transparent;
    }

    .rating-tag.active {
        background-color: #FFF5F0;
        border: 1px solid #FF6B35;
    }

    .tag-text {
        font-size: 13px;
        color: #666;
    }

    .rating-tag.active .tag-text {
        color: #FF6B35;
    }

    .review-textarea {
        width: 100%;
        height: 120px;
        background-color: #F8F8F8;
        border-radius: 8px;
        padding: 12px;
        font-size: 14px;
        color: #333;
    }

    .char-count {
        align-items: flex-end;
        margin-top: 4px;
    }

    .char-count-text {
        font-size: 12px;
        color: #999;
    }

    .anon-card {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .anon-label {
        font-size: 15px;
        color: #333;
    }

    .bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background-color: #FFFFFF;
        padding: 12px 16px;
        border-top: 1px solid #E5E5E5;
    }

    .submit-btn {
        background-color: #FF6B35;
        border-radius: 24px;
        height: 44px;
        align-items: center;
        justify-content: center;
    }

    .submit-text {
        font-size: 16px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
