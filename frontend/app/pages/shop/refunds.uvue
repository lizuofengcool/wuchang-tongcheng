<template>
    <view class="page">
        <scroll-view class="tabs" scroll-x>
            <view class="tab-item" v-for="tab in tabs" :key="tab.id" @click="switchTab(tab.id)">
                <text :class="tab.id == activeTab ? 'tab-text tab-active' : 'tab-text'">{{ tab.name }}</text>
            </view>
        </scroll-view>

        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <shop-loading :text="'加载中...'" v-if="loading && list.length == 0" />
            <view class="list-wrap" v-if="list.length > 0">
                <view class="refund-card" v-for="item in list" :key="item.id" @click="goDetail(item.id)">
                    <view class="header-row">
                        <text class="refund-no">退款单号：{{ item.refund_no }}</text>
                        <shop-status-tag :status="item.status" :text="item.status_text" />
                    </view>
                    <view class="product-row">
                        <image class="p-cover" :src="item.product_cover" mode="aspectFill" lazy-load="true" v-if="item.product_cover.length > 0" />
                        <view class="p-cover-placeholder" v-else>
                            <text class="p-cover-text">{{ item.product_title.length > 0 ? item.product_title.charAt(0) : '商' }}</text>
                        </view>
                        <view class="p-info">
                            <text class="p-title">{{ item.product_title }}</text>
                            <text class="p-reason">原因：{{ item.reason }}</text>
                            <text class="p-time">{{ item.created_at }}</text>
                        </view>
                    </view>
                    <view class="amount-row">
                        <text class="amount-label">退款金额</text>
                        <text class="amount-value">¥{{ item.amount }}</text>
                    </view>
                    <view class="action-row" v-if="item.status == 'pending'">
                        <view class="action-btn" @click.stop="onProcess(item.id, 'reject')">
                            <text class="action-text">拒绝</text>
                        </view>
                        <view class="action-btn primary" @click.stop="onProcess(item.id, 'approve')">
                            <text class="action-text primary">同意退款</text>
                        </view>
                    </view>
                </view>
            </view>
            <view class="load-more" v-if="loading && list.length > 0">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <shop-empty
                v-if="list.length == 0 && !loading"
                icon="↩️"
                text="暂无退款申请" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { guardMerchant } from '@/utils/auth.uts'
    import { listMerchantRefunds, processMerchantRefund } from '@/api/business/merchant.uts'

    type Tab = { id: number, name: string, value: string }

    type ListItem = {
        id: number
        refund_no: string
        status: string
        status_text: string
        product_title: string
        product_cover: string
        reason: string
        amount: string
        created_at: string
    }

    const tabs = ref([
        { id: 0, name: '全部', value: '' },
        { id: 1, name: '待处理', value: 'pending' },
        { id: 2, name: '已同意', value: 'approved' },
        { id: 3, name: '已拒绝', value: 'rejected' },
        { id: 4, name: '已完成', value: 'completed' }
    ] as Tab[])

    const activeTab = ref(0)
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const switchTab = (id: number) => {
        if (activeTab.value == id) return
        activeTab.value = id
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        const tab = tabs.value[activeTab.value]
        if (tab.value.length > 0) {
            params['status'] = tab.value
        }

        listMerchantRefunds(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.showToast({ title: '退款详情开发中', icon: 'none' })
    }

    const onProcess = (id: number, action: string) => {
        const text = action == 'approve' ? '同意' : '拒绝'
        uni.showModal({
            title: '提示',
            content: '确定要' + text + '此退款申请吗？',
            success: (r: ShowModalRes) => {
                if (r.confirm) {
                    processMerchantRefund(id, { action: action } as UTSJSONObject).then((res: ApiResult) => {
                        if (res.code == 200) {
                            uni.showToast({ title: text + '成功', icon: 'success' })
                            loadList(true)
                        }
                    }).catch(() => {})
                }
            }
        })
    }

    onLoad(() => {
        if (!guardMerchant()) return
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tabs {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 0 8px;
        border-bottom: 1px solid #F0F0F0;
    }

    .tab-item {
        padding: 12px 14px;
        align-items: center;
    }

    .tab-text {
        font-size: 14px;
        color: #666;
    }

    .tab-active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .refund-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 8px;
        border-bottom: 1px solid #F5F5F5;
    }

    .refund-no {
        font-size: 12px;
        color: #999;
        flex: 1;
    }

    .product-row {
        flex-direction: row;
        padding: 8px 0;
    }

    .p-cover {
        width: 56px;
        height: 56px;
        border-radius: 6px;
        background-color: #F5F5F5;
    }

    .p-cover-placeholder {
        width: 56px;
        height: 56px;
        border-radius: 6px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .p-cover-text {
        font-size: 22px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .p-info {
        flex: 1;
        margin-left: 10px;
    }

    .p-title {
        font-size: 13px;
        color: #333;
        font-weight: 500;
    }

    .p-reason {
        font-size: 12px;
        color: #666;
        margin-top: 4px;
    }

    .p-time {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
    }

    .amount-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding-top: 8px;
        border-top: 1px solid #F5F5F5;
    }

    .amount-label {
        font-size: 12px;
        color: #999;
    }

    .amount-value {
        font-size: 15px;
        color: #FF6B35;
        font-weight: 700;
    }

    .action-row {
        flex-direction: row;
        justify-content: flex-end;
        margin-top: 10px;
    }

    .action-btn {
        padding: 6px 14px;
        border-radius: 16px;
        border: 1px solid #DDDDDD;
        margin-left: 8px;
    }

    .action-btn.primary {
        background-color: #FF6B35;
        border-color: #FF6B35;
    }

    .action-text {
        font-size: 12px;
        color: #666;
    }

    .action-text.primary {
        color: #FFFFFF;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
