<template>
    <view class="page">
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <shop-loading :text="'加载中...'" v-if="loading && list.length == 0" />
            <view class="list-wrap" v-if="list.length > 0">
                <shop-staff-card
                    v-for="item in list"
                    :key="item.id"
                    :staff="transformCard(item)"
                    :actions="getActions(item)"
                    @click="goDetail"
                    @action="onAction" />
            </view>
            <view class="load-more" v-if="loading && list.length > 0">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <shop-empty
                v-if="list.length == 0 && !loading"
                icon="👥"
                text="暂无员工"
                btn-text="添加员工"
                @click="goAdd" />
        </scroll-view>

        <view class="fab" @click="goAdd">
            <text class="fab-icon">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { guardMerchant } from '@/utils/auth.uts'
    import { listMerchantStaff, deleteMerchantStaff } from '@/api/business/merchant.uts'

    type ListItem = {
        id: number
        name: string
        avatar: string
        phone: string
        role_text: string
        status: string
        status_text: string
        permissions: string[]
    }

    type CardData = {
        id: number
        name: string
        avatar: string
        phone: string
        role_text: string
        status: string
        status_text: string
        permissions: string[]
    }

    type Action = { text: string, type: string, primary: boolean }

    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            name: item.name,
            avatar: item.avatar,
            phone: item.phone,
            role_text: item.role_text,
            status: item.status,
            status_text: item.status_text,
            permissions: item.permissions
        } as CardData
    }

    const getActions = (item: ListItem) : Action[] => {
        const arr = [] as Action[]
        arr.push({ text: '编辑', type: 'edit', primary: false } as Action)
        arr.push({ text: '权限', type: 'permission', primary: false } as Action)
        arr.push({ text: '删除', type: 'delete', primary: false } as Action)
        return arr
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listMerchantStaff(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goAdd = () => {
        uni.showToast({ title: '添加员工开发中', icon: 'none' })
    }

    const goDetail = (id: number) => {
        uni.showToast({ title: '员工详情开发中', icon: 'none' })
    }

    const onAction = (staffId: number, actionType: string) => {
        if (actionType == 'edit' || actionType == 'permission') {
            uni.showToast({ title: actionType == 'edit' ? '编辑员工开发中' : '权限管理开发中', icon: 'none' })
            return
        }
        if (actionType == 'delete') {
            uni.showModal({
                title: '提示',
                content: '确定要删除此员工吗？',
                confirmColor: '#F44336',
                success: (r: ShowModalRes) => {
                    if (r.confirm) {
                        deleteMerchantStaff(staffId).then((res: ApiResult) => {
                            if (res.code == 200) {
                                uni.showToast({ title: '删除成功', icon: 'success' })
                                loadList(true)
                            }
                        }).catch(() => {})
                    }
                }
            })
        }
    }

    onLoad(() => {
        if (!guardMerchant()) return
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .fab {
        position: fixed;
        right: 16px;
        bottom: 32px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.4);
    }

    .fab-icon {
        font-size: 28px;
        color: #FFFFFF;
    }
</style>
