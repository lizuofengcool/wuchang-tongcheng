<template>
    <view class="page">
        <!-- 状态筛选 -->
        <scroll-view class="tabs" scroll-x>
            <view class="tab-item" v-for="tab in tabs" :key="tab.id" @click="switchTab(tab.id)">
                <text :class="tab.id == activeTab ? 'tab-text tab-active' : 'tab-text'">{{ tab.name }}</text>
            </view>
        </scroll-view>

        <!-- 优惠券列表 -->
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <shop-loading :text="'加载中...'" v-if="loading && list.length == 0" />
            <view class="list-wrap" v-if="list.length > 0">
                <shop-coupon-card
                    v-for="item in list"
                    :key="item.id"
                    :coupon="transformCard(item)"
                    action-text="发放"
                    @click="goDetail"
                    @action="onDistribute" />
            </view>
            <view class="load-more" v-if="loading && list.length > 0">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <shop-empty
                v-if="list.length == 0 && !loading"
                icon="🎫"
                text="暂无优惠券"
                btn-text="去创建"
                @click="goCreate" />
        </scroll-view>

        <!-- 创建按钮 -->
        <view class="fab" @click="goCreate">
            <text class="fab-icon">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { guardMerchant } from '@/utils/auth.uts'
    import { listMerchantCoupons, updateMerchantCoupon } from '@/api/business/merchant.uts'

    type Tab = { id: number, name: string, value: string }

    type ListItem = {
        id: number
        title: string
        amount: number
        threshold_text: string
        validity_text: string
        status: string
        status_text: string
    }

    type CardData = {
        id: number
        title: string
        amount: number
        threshold_text: string
        validity_text: string
        status: string
        status_text: string
    }

    const tabs = ref([
        { id: 0, name: '全部', value: '' },
        { id: 1, name: '进行中', value: 'active' },
        { id: 2, name: '已过期', value: 'expired' },
        { id: 3, name: '已停用', value: 'disabled' }
    ] as Tab[])

    const activeTab = ref(0)
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            amount: item.amount,
            threshold_text: item.threshold_text,
            validity_text: item.validity_text,
            status: item.status,
            status_text: item.status_text
        } as CardData
    }

    const switchTab = (id: number) => {
        if (activeTab.value == id) return
        activeTab.value = id
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        const tab = tabs.value[activeTab.value]
        if (tab.value.length > 0) {
            params['status'] = tab.value
        }

        listMerchantCoupons(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.showToast({ title: '优惠券详情开发中', icon: 'none' })
    }

    const goCreate = () => {
        uni.showToast({ title: '创建优惠券开发中', icon: 'none' })
    }

    const onDistribute = (id: number) => {
        uni.showModal({
            title: '发放优惠券',
            content: '确定要发放此优惠券给关注店铺的用户吗？',
            success: (r: ShowModalRes) => {
                if (r.confirm) {
                    updateMerchantCoupon(id, { action: 'distribute' } as UTSJSONObject).then((res: ApiResult) => {
                        if (res.code == 200) {
                            uni.showToast({ title: '发放成功', icon: 'success' })
                        }
                    }).catch(() => {})
                }
            }
        })
    }

    onLoad(() => {
        if (!guardMerchant()) return
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tabs {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 0 8px;
        border-bottom: 1px solid #F0F0F0;
    }

    .tab-item {
        padding: 12px 14px;
        align-items: center;
    }

    .tab-text {
        font-size: 14px;
        color: #666;
    }

    .tab-active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .fab {
        position: fixed;
        right: 16px;
        bottom: 32px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.4);
    }

    .fab-icon {
        font-size: 28px;
        color: #FFFFFF;
    }
</style>
