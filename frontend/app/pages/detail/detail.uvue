<template>
    <view class="page">
        <view class="content">
            <text class="placeholder">详情页开发中</text>
            <text class="id-text">ID: {{ detailId }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    const detailId = ref('')

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            detailId.value = id as string
        }
    })
</script>

