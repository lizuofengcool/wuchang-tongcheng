<template>
    <view class="page">
        <view class="header">
            <text class="header-text">选择发布类型</text>
        </view>
        <view class="grid">
            <view class="grid-item" v-for="item in publishTypes" :key="item.id" @click="onTap(item.name)">
                <text class="grid-icon">{{ item.icon }}</text>
                <text class="grid-name">{{ item.name }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type PublishType = {
        id: number
        name: string
        icon: string
    }

    const publishTypes = ref([
        { id: 1, name: '二手', icon: '📦' },
        { id: 2, name: '招聘', icon: '💼' },
        { id: 3, name: '房屋', icon: '🏠' },
        { id: 4, name: '拼车', icon: '🚗' },
        { id: 5, name: '相亲', icon: '❤️' },
        { id: 6, name: '车辆', icon: '🚙' },
        { id: 7, name: '零工', icon: '⚒️' },
        { id: 8, name: '活动', icon: '🎉' }
    ] as PublishType[])

    const onTap = (name: string) => {
        uni.showToast({ title: `${name}发布功能开发中`, icon: 'none' })
    }
</script>

