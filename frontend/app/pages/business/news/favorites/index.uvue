<template>
    <view class="page">
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <view class="fav-item" v-for="item in list" :key="item.id">
                    <news-card :news="transformCard(item)" :show-footer="false" @click="goDetail" />
                    <view class="fav-action" @click="onCancelFav(item.id)">
                        <text class="fav-action-text">取消收藏</text>
                    </view>
                </view>
            </view>
            <news-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <news-empty v-if="list.length == 0 && !loading" icon="⭐" text="暂无收藏" sub-text="收藏的头条会显示在这里" btn-text="去逛逛" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { requireLogin } from '@/utils/auth.uts'
    import { listMyFavorites, favNews } from '@/api/business/news.uts'

    type ListItem = {
        id: number
        title: string
        summary: string
        cover_image: string
        author_name: string
        category_id: number
        listing_type: string
        condition: string
        is_urgent: boolean
        view_count: number
        like_count: number
        fav_count: number
        comment_count: number
        distance: number
        published_at: string
    }
    type CardData = {
        id: number
        title: string
        summary: string
        cover_image: string
        author_name: string
        category_id: number
        listing_type: string
        condition: string
        is_urgent: boolean
        view_count: number
        like_count: number
        fav_count: number
        comment_count: number
        distance: number
        published_at: string
    }

    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            summary: item.summary,
            cover_image: item.cover_image,
            author_name: item.author_name,
            category_id: item.category_id,
            listing_type: item.listing_type,
            condition: item.condition,
            is_urgent: item.is_urgent,
            view_count: item.view_count,
            like_count: item.like_count,
            fav_count: item.fav_count,
            comment_count: item.comment_count,
            distance: item.distance,
            published_at: item.published_at
        } as CardData
    }

    const loadList = (reset: boolean = false) => {
        if (!requireLogin()) return
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listMyFavorites(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const onCancelFav = (id: number) => {
        uni.showModal({
            title: '提示',
            content: '确认取消收藏？',
            success: (r) => {
                if (r.confirm) {
                    favNews(id).then((res: ApiResult) => {
                        if (res.code == 200) {
                            uni.showToast({ title: '已取消收藏', icon: 'success' })
                            list.value = list.value.filter((item: ListItem) : boolean => item.id != id)
                        } else {
                            uni.showToast({ title: res.message || '操作失败', icon: 'none' })
                        }
                    })
                }
            }
        })
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/news/detail/index?id=' + id })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/news/list/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .fav-item {
        margin-bottom: 10px;
    }

    .fav-action {
        flex-direction: row;
        justify-content: flex-end;
        padding: 6px 0;
        margin-top: -4px;
    }

    .fav-action-text {
        font-size: 12px;
        color: #EE0A24;
        padding: 4px 12px;
        border-radius: 12px;
        background-color: #FFEEEE;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
