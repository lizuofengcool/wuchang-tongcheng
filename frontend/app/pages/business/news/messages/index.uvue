<template>
    <view class="page">
        <view class="top-bar">
            <view class="unread-info" v-if="unreadCount > 0">
                <text class="unread-text">{{ unreadCount }} 条未读消息</text>
                <text class="read-all" @click="onMarkAllRead">全部已读</text>
            </view>
            <view class="unread-info" v-else>
                <text class="unread-text muted">暂无未读消息</text>
            </view>
        </view>
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <view class="msg-item" v-for="item in list" :key="item.id" :class="{ unread: !item.is_read }" @click="onItemClick(item)">
                    <view class="msg-icon-wrap">
                        <text class="msg-icon">{{ typeIcon(item.type) }}</text>
                        <view class="msg-dot" v-if="!item.is_read"></view>
                    </view>
                    <view class="msg-main">
                        <view class="msg-header">
                            <text class="msg-type">{{ typeName(item.type) }}</text>
                            <text class="msg-time">{{ item.created_at }}</text>
                        </view>
                        <text class="msg-content">{{ item.content }}</text>
                    </view>
                </view>
            </view>
            <news-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <news-empty v-if="list.length == 0 && !loading" icon="🔔" text="暂无消息" sub-text="新的消息会显示在这里" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { requireLogin } from '@/utils/auth.uts'
    import { listMessages, getUnreadCount, markRead } from '@/api/business/news.uts'

    type Message = {
        id: number
        from_user_id: number
        to_user_id: number
        news_id: number
        type: string
        content: string
        is_read: boolean
        created_at: string
    }

    const list = ref([] as Message[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20
    const unreadCount = ref(0)

    const typeIcon = (type: string) : string => {
        if (type == 'comment') return '💬'
        if (type == 'reply') return '💬'
        if (type == 'like') return '👍'
        if (type == 'fav') return '⭐'
        if (type == 'system') return '📢'
        return '🔔'
    }

    const typeName = (type: string) : string => {
        if (type == 'comment') return '评论通知'
        if (type == 'reply') return '回复通知'
        if (type == 'like') return '点赞通知'
        if (type == 'fav') return '收藏通知'
        if (type == 'system') return '系统通知'
        return '消息通知'
    }

    const loadList = (reset: boolean = false) => {
        if (!requireLogin()) return
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listMessages(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as Message[]) ?? ([] as Message[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const loadUnread = () => {
        if (!state.checkLogin()) return
        getUnreadCount().then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                unreadCount.value = (d['count'] as number) ?? 0
            }
        })
    }

    const onItemClick = (item: Message) => {
        if (!item.is_read) {
            markRead({ id: item.id } as UTSJSONObject).then((res: ApiResult) => {
                if (res.code == 200) {
                    item.is_read = true
                    unreadCount.value = Math.max(0, unreadCount.value - 1)
                }
            })
        }
        if (item.news_id > 0) {
            uni.navigateTo({ url: '/pages/business/news/detail/index?id=' + item.news_id })
        }
    }

    const onMarkAllRead = () => {
        uni.showModal({
            title: '提示',
            content: '确认将所有消息标记为已读？',
            success: (r) => {
                if (r.confirm) {
                    markRead({ all: true } as UTSJSONObject).then((res: ApiResult) => {
                        if (res.code == 200) {
                            uni.showToast({ title: '已全部标记已读', icon: 'success' })
                            for (let i = 0; i < list.value.length; i++) {
                                list.value[i].is_read = true
                            }
                            unreadCount.value = 0
                        } else {
                            uni.showToast({ title: res.message || '操作失败', icon: 'none' })
                        }
                    })
                }
            }
        })
    }

    onLoad(() => {
        loadList(true)
        loadUnread()
    })

    onPullDownRefresh(() => {
        loadList(true)
        loadUnread()
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .top-bar {
        background-color: #FFFFFF;
        padding: 10px 16px;
        margin-bottom: 8px;
    }

    .unread-info {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .unread-text {
        font-size: 13px;
        color: #FF6B35;
        font-weight: 600;
    }

    .unread-text.muted {
        color: #999;
        font-weight: 400;
    }

    .read-all {
        font-size: 13px;
        color: #FF6B35;
        padding: 4px 12px;
        border-radius: 12px;
        background-color: #FFF5F0;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .msg-item {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
        flex-direction: row;
    }

    .msg-item.unread {
        border-left-width: 3px;
        border-left-color: #FF6B35;
    }

    .msg-icon-wrap {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background-color: #FFF5F0;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        position: relative;
    }

    .msg-icon {
        font-size: 20px;
    }

    .msg-dot {
        position: absolute;
        top: 0;
        right: 0;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background-color: #EE0A24;
    }

    .msg-main {
        flex: 1;
    }

    .msg-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .msg-type {
        font-size: 13px;
        color: #333;
        font-weight: 600;
    }

    .msg-time {
        font-size: 11px;
        color: #BBB;
    }

    .msg-content {
        font-size: 13px;
        color: #666;
        margin-top: 4px;
        line-height: 1.5;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
