<template>
    <view class="page">
        <view class="search-bar" @click="goSearch">
            <text class="search-icon">🔍</text>
            <text class="search-placeholder">搜索同城头条</text>
        </view>
        <news-category-tabs :categories="categories" :current-id="currentCategoryId" @change="changeCategory" />
        <view class="action-bar">
            <view class="action-item" :class="{ active: currentSort == 'time' }" @click="changeSort('time')">
                <text class="action-text" :class="{ active: currentSort == 'time' }">最新</text>
            </view>
            <view class="action-item" :class="{ active: currentSort == 'views' }" @click="changeSort('views')">
                <text class="action-text" :class="{ active: currentSort == 'views' }">最热</text>
            </view>
            <view class="action-item" @click="goPublish">
                <text class="action-text publish">📝 发布</text>
            </view>
        </view>
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <news-card v-for="item in list" :key="item.id" :news="transformCard(item)" @click="goDetail" />
            </view>
            <news-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <news-empty v-if="list.length == 0 && !loading" icon="📰" text="暂无头条" btn-text="去发布" @click="goPublish" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { listNews } from '@/api/business/news.uts'

    type Category = {
        id: number
        name: string
    }
    type ListItem = {
        id: number
        title: string
        summary: string
        cover_image: string
        author_name: string
        category_id: number
        listing_type: string
        condition: string
        is_urgent: boolean
        view_count: number
        like_count: number
        fav_count: number
        comment_count: number
        distance: number
        published_at: string
    }
    type CardData = {
        id: number
        title: string
        summary: string
        cover_image: string
        author_name: string
        category_id: number
        listing_type: string
        condition: string
        is_urgent: boolean
        view_count: number
        like_count: number
        fav_count: number
        comment_count: number
        distance: number
        published_at: string
    }

    // 分类映射：id -> listing_type（0=全部）
    const listingTypeMap = ['', 'sell', 'buy', 'rent', 'service', 'job']

    const categories = ref([
        { id: 0, name: '全部' },
        { id: 1, name: '出售' },
        { id: 2, name: '求购' },
        { id: 3, name: '出租' },
        { id: 4, name: '服务' },
        { id: 5, name: '招聘' }
    ] as Category[])

    const currentCategoryId = ref(0)
    const currentSort = ref('time')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            summary: item.summary,
            cover_image: item.cover_image,
            author_name: item.author_name,
            category_id: item.category_id,
            listing_type: item.listing_type,
            condition: item.condition,
            is_urgent: item.is_urgent,
            view_count: item.view_count,
            like_count: item.like_count,
            fav_count: item.fav_count,
            comment_count: item.comment_count,
            distance: item.distance,
            published_at: item.published_at
        } as CardData
    }

    const changeCategory = (id: number) => {
        if (currentCategoryId.value == id) return
        currentCategoryId.value = id
        loadList(true)
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value,
            status: 1
        } as UTSJSONObject
        const listingType = listingTypeMap[currentCategoryId.value]
        if (listingType.length > 0) {
            params['listing_type'] = listingType
        }

        listNews(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/news/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/news/search/index' })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/news/publish/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        margin: 8px 12px;
        padding: 8px 12px;
        border-radius: 20px;
        background-color: #F5F5F5;
    }

    .search-icon {
        font-size: 14px;
        color: #999;
        margin-right: 6px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
    }

    .action-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .action-item {
        margin-right: 24px;
    }

    .action-text {
        font-size: 13px;
        color: #666;
    }

    .action-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .action-text.publish {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
