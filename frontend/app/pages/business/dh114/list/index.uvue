<template>
    <view class="page">
        <view class="search-bar" @click="goSearch">
            <text class="search-icon">🔍</text>
            <text class="search-placeholder">搜索商家/服务/分类</text>
        </view>
        <dh114-filter :items="filterItems" :active-key="activeFilterKey" :panel-visible="showFilterPanel" :selected="selectedFilters" @tap="onTapFilter" />
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="sort-bar">
                <text class="sort-text" :class="{ active: currentSort == 'popular' }" @click="changeSort('popular')">综合</text>
                <text class="sort-text" :class="{ active: currentSort == 'latest' }" @click="changeSort('latest')">最新</text>
                <text class="sort-text" :class="{ active: currentSort == 'rating' }" @click="changeSort('rating')">评分</text>
                <text class="sort-text" :class="{ active: currentSort == 'nearby' }" @click="changeSort('nearby')">附近</text>
            </view>
            <view class="list-wrap">
                <dh114-card v-for="item in list" :key="item.id" :business="transformCard(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <dh114-empty v-if="list.length == 0 && !loading" icon="🏪" text="暂无商家" btn-text="去入驻" @click="goPublish" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { listDh114s, listNearbyDh114s } from '@/api/business/dh114.uts'

    type ListItem = {
        id: number
        name: string
        cover_image: string
        category_name: string
        rating: number
        avg_price: number
        distance: string
        address: string
        view_count: number
        is_verified: boolean
        is_hot: boolean
        is_open: boolean
    }
    type CardData = {
        id: number
        name: string
        cover_image: string
        category_name: string
        rating: number
        avg_price: number
        distance: string
        address: string
        view_count: number
        is_verified: boolean
        is_hot: boolean
        is_open: boolean
    }
    type FilterItem = { key: string, label: string, options: string[] }

    const filterItems = [
        { key: 'category', label: '分类', options: [] as string[] },
        { key: 'sort', label: '排序', options: [] as string[] },
        { key: 'price', label: '人均', options: [] as string[] },
        { key: 'filter', label: '筛选', options: [] as string[] }
    ] as FilterItem[]

    const activeFilterKey = ref('')
    const showFilterPanel = ref(false)
    const selectedFilters = ref({} as UTSJSONObject)
    const currentSort = ref('popular')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            name: item.name,
            cover_image: item.cover_image,
            category_name: item.category_name,
            rating: item.rating,
            avg_price: item.avg_price,
            distance: item.distance,
            address: item.address,
            view_count: item.view_count,
            is_verified: item.is_verified,
            is_hot: item.is_hot,
            is_open: item.is_open
        } as CardData
    }

    const onTapFilter = (key: string) => {
        if (activeFilterKey.value == key && showFilterPanel.value) {
            showFilterPanel.value = false
            activeFilterKey.value = ''
        } else {
            activeFilterKey.value = key
            showFilterPanel.value = true
            const optionMap: UTSJSONObject = {
                category: '全部,美食,酒店,休闲娱乐,购物,生活服务',
                sort: '全部,智能排序,离我最近,评分最高',
                price: '全部,50以下,50-100,100-200,200以上',
                filter: '全部,营业中,认证商户,有优惠券'
            } as UTSJSONObject
            const opts = ((optionMap[key] as string) ?? '全部').split(',')
            uni.showActionSheet({
                itemList: opts,
                success: (res) => {
                    const picked = opts[res.tapIndex]
                    selectedFilters.value[key] = picked == '全部' ? '' : picked
                    showFilterPanel.value = false
                    activeFilterKey.value = ''
                    loadList(true)
                }
            })
        }
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value
        } as UTSJSONObject
        const keys = Object.keys(selectedFilters.value)
        for (let i = 0; i < keys.length; i++) {
            const k = keys[i]
            const v = (selectedFilters.value[k] as string) ?? ''
            if (v.length > 0) params[k] = v
        }

        const useNearby = currentSort.value == 'nearby'
        const reqFn = useNearby ? listNearbyDh114s(params) : listDh114s(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/dh114/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/dh114/search/index' })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/dh114/publish/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        margin: 8px 12px;
        padding: 8px 12px;
        border-radius: 20px;
        background-color: #F5F5F5;
    }

    .search-icon {
        font-size: 14px;
        color: #999;
        margin-right: 6px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
    }

    .list-scroll {
        flex: 1;
    }

    .sort-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .sort-text {
        flex: 1;
        font-size: 13px;
        color: #666;
        text-align: center;
    }

    .sort-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
