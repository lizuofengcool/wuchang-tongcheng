<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <dh114-card v-for="item in favList" :key="item.id" :business="transformCard(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && favList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <dh114-empty v-if="favList.length == 0 && !loading" icon="★" text="暂无收藏" btn-text="去找商家" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listFavorites, listFavoritesByType, deleteFavorite } from '@/api/business/dh114.uts'

    type Tab = { key: string, name: string }
    type FavItem = {
        id: number
        target_id: number
        type: string
        name: string
        cover_image: string
        category_name: string
        rating: number
        avg_price: number
        distance: string
        address: string
        view_count: number
        is_verified: boolean
        is_hot: boolean
        is_open: boolean
    }
    type CardData = {
        id: number
        name: string
        cover_image: string
        category_name: string
        rating: number
        avg_price: number
        distance: string
        address: string
        view_count: number
        is_verified: boolean
        is_hot: boolean
        is_open: boolean
    }

    const tabs = ref([
        { key: 'all', name: '全部' },
        { key: 'dh114', name: '商家' },
        { key: 'menu', name: '菜单' },
        { key: 'groupbuy', name: '团购' }
    ] as Tab[])
    const currentTab = ref(0)
    const favList = ref([] as FavItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: FavItem) : CardData => {
        return {
            id: item.target_id > 0 ? item.target_id : item.id,
            name: item.name,
            cover_image: item.cover_image,
            category_name: item.category_name,
            rating: item.rating,
            avg_price: item.avg_price,
            distance: item.distance,
            address: item.address,
            view_count: item.view_count,
            is_verified: item.is_verified,
            is_hot: item.is_hot,
            is_open: item.is_open
        } as CardData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const tabKey = tabs.value[currentTab.value].key
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        let reqFn
        if (tabKey == 'all') {
            reqFn = listFavorites(params)
        } else {
            reqFn = listFavoritesByType(tabKey)
        }
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as FavItem[]) ?? ([] as FavItem[])
                if (reset) {
                    favList.value = newList
                } else {
                    favList.value = favList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/dh114/detail/index?id=' + id })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/dh114/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
