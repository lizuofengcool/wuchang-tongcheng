<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <dh114-groupbuy-card v-for="item in groupbuyList" :key="item.id" :groupbuy="item" @buy="onBuy" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && groupbuyList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <dh114-empty v-if="groupbuyList.length == 0 && !loading" icon="🛒" text="暂无团购" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listGroupbuys, listHotGroupbuys, listGroupbuysByDh114 } from '@/api/business/dh114.uts'

    type Tab = { key: string, name: string }
    type GroupbuyItem = {
        id: number
        title: string
        description: string
        original_price: number
        groupbuy_price: number
        sold_count: number
        validity: string
    }

    const tabs = ref([
        { key: 'all', name: '全部团购' },
        { key: 'hot', name: '热门' },
        { key: 'mine', name: '我的团购' }
    ] as Tab[])
    const currentTab = ref(0)
    const groupbuyList = ref([] as GroupbuyItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20
    const dh114Id = ref(0)

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const tabKey = tabs.value[currentTab.value].key
        let reqFn
        if (tabKey == 'hot') {
            reqFn = listHotGroupbuys()
        } else if (dh114Id.value > 0) {
            reqFn = listGroupbuysByDh114(dh114Id.value)
        } else {
            const params: UTSJSONObject = { page: page.value, page_size: pageSize } as UTSJSONObject
            reqFn = listGroupbuys(params)
        }
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const newList = (res.data as GroupbuyItem[]) ?? ([] as GroupbuyItem[])
                if (reset) {
                    groupbuyList.value = newList
                } else {
                    groupbuyList.value = groupbuyList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const onBuy = (id: number) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        uni.showModal({
            title: '购买团购',
            content: '确认购买该团购套餐？',
            success: (res) => {
                if (res.confirm) {
                    uni.showToast({ title: '购买成功', icon: 'success' })
                }
            }
        })
    }

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            dh114Id.value = parseInt(id as string)
        }
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
