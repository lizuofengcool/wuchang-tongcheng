        padding: 4px 0;
    }

    .bottom-icon {
        font-size: 20px;
    }

    .bottom-text {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
    }

    .btn-cart {
        flex: 1;
        height: 44px;
        border-radius: 22px 0 0 22px;
        background-color: #FFB340;
