        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-bottom: 8px;
    }

    .price-row {
        flex-direction: row;
        align-items: baseline;
    }

    .price {
        font-size: 22px;
        color: #FF6B35;
        font-weight: 700;
    }

    .origin-price {
        font-size: 13px;
        color: #BBB;
        text-decoration: line-through;
        margin-left: 8px;
    }

    .title {
        font-size: 16px;
        color: #333;
        font-weight: 600;
        margin-top: 8px;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
    }

    .meta {
        font-size: 12px;
        color: #999;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .shop-section {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 12px 16px;
        margin-bottom: 8px;
    }

    .shop-logo {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        margin-right: 10px;
    }

    .shop-logo-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
    }

    .shop-logo-text {
        font-size: 18px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .shop-info {
        flex: 1;
    }

    .shop-name {
        font-size: 14px;
        color: #333;
        font-weight: 600;
    }

    .shop-meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 4px;
    }

    .shop-rating {
        font-size: 12px;
        color: #FF6B35;
        margin-right: 8px;
    }

    .shop-sales {
        font-size: 12px;
        color: #999;
    }

    .enter-text {
        font-size: 12px;
        color: #FF6B35;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-bottom: 8px;
        flex-direction: row;
        align-items: center;
    }

    .section-label {
        font-size: 13px;
        color: #999;
        margin-right: 12px;
    }

    .section-value {
        flex: 1;
        font-size: 13px;
        color: #333;
    }

    .section-arrow {
        font-size: 16px;
        color: #CCC;
    }

    .section-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .more-text {
        font-size: 12px;
        color: #FF6B35;
    }

    .section-content {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
    }

    .bottom-bar {
        flex-direction: row;
        background-color: #FFFFFF;
