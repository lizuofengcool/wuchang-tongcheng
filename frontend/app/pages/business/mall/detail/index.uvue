<template>
    <view class="page">
        <scroll-view class="content" scroll-y>
            <view class="banner-wrap" v-if="detail.images.length > 0">
                <swiper class="swiper" :indicator-dots="true" :autoplay="true" :circular="true">
                    <swiper-item v-for="(img, idx) in detail.images" :key="idx">
                        <image class="banner-img" :src="img" mode="aspectFill" @click="onPreviewImage(idx)" />
                    </swiper-item>
                </swiper>
            </view>
            <view class="image-banner" v-else-if="detail.cover_image.length > 0">
                <image class="banner-img" :src="detail.cover_image" mode="aspectFill" />
            </view>
            <view class="header-section">
                <view class="price-row">
                    <text class="price">¥{{ detail.price }}</text>
                    <text class="origin-price" v-if="detail.origin_price > detail.price">¥{{ detail.origin_price }}</text>
                </view>
                <text class="title">{{ detail.title }}</text>
                <view class="meta-row">
                    <text class="meta">已售 {{ detail.sales_count }}</text>
                    <text class="meta-dot">·</text>
                    <text class="meta">{{ detail.view_count }} 浏览</text>
                    <text class="meta-dot" v-if="detail.stock > 0">·</text>
                    <text class="meta" v-if="detail.stock > 0">库存 {{ detail.stock }}</text>
                </view>
            </view>
            <view class="shop-section" v-if="detail.shop_id > 0" @click="goShop">
                <image class="shop-logo" :src="detail.shop_logo" mode="aspectFill" lazy-load="true" v-if="detail.shop_logo.length > 0" />
                <view class="shop-logo-placeholder" v-else>
                    <text class="shop-logo-text">{{ detail.shop_name.length > 0 ? detail.shop_name.charAt(0) : '店' }}</text>
                </view>
                <view class="shop-info">
                    <text class="shop-name">{{ detail.shop_name }}</text>
                    <view class="shop-meta-row">
                        <text class="shop-rating" v-if="detail.shop_rating > 0">★ {{ detail.shop_rating }}</text>
                        <text class="shop-sales">{{ detail.shop_sales_count }} 人关注</text>
                    </view>
                </view>
                <text class="enter-text">进店 ›</text>
            </view>
            <view class="section" v-if="skuGroups.length > 0" @click="openSkuPanel">
                <text class="section-label">选择</text>
                <text class="section-value">{{ skuSelectedText }}</text>
                <text class="section-arrow">›</text>
            </view>
            <view class="section" v-if="detail.description.length > 0">
                <text class="section-title">商品详情</text>
                <text class="section-content">{{ detail.description }}</text>
            </view>
            <view class="section" v-if="reviewList.length > 0">
                <view class="section-header">
                    <text class="section-title">用户评价 ({{ reviewTotal }})</text>
                    <text class="more-text" @click="goReviews">查看全部 ></text>
                </view>
                <mall-review-card v-for="item in reviewList" :key="item.id" :review="item" @like="onLikeReview" />
            </view>
        </scroll-view>
        <view class="bottom-bar">
            <view class="bottom-btn" @click="goCart">
                <text class="bottom-icon">🛒</text>
                <text class="bottom-text">购物车</text>
            </view>
            <view class="bottom-btn" @click="openSkuPanel('cart')">
                <text class="bottom-icon">🛍</text>
                <text class="bottom-text">加购</text>
            </view>
            <view class="btn-cart" @click="openSkuPanel('cart')">
                <text class="btn-cart-text">加入购物车</text>
            </view>
            <view class="btn-buy" @click="openSkuPanel('buy')">
                <text class="btn-buy-text">立即购买</text>
            </view>
        </view>
        <view class="sku-mask" v-if="showSkuPanel" @click="closeSkuPanel">
            <view class="sku-panel" @click.stop="noop">
                <mall-sku-selector :groups="skuGroups" :stock="detail.stock" @add-cart="onAddCart" @buy-now="onBuyNow" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import {
        getMallProductDetail, listMallSkusByProduct, listMallReviewsByProduct,
        incrMallProductView, addMallCart, likeMallReview
    } from '@/api/business/mall.uts'

    type Detail = {
        id: number
        title: string
        cover_image: string
        images: string[]
        price: number
        origin_price: number
        sales_count: number
        view_count: number
        stock: number
        description: string
        shop_id: number
        shop_name: string
        shop_logo: string
        shop_rating: number
        shop_sales_count: number
    }
    type SkuGroup = {
        key: string
        name: string
        values: string[]
    }
    type ReviewItem = {
        id: number
        user_name: string
        user_avatar: string
        rating: number
        content: string
        images: string[]
        sku_name: string
        reply_content: string
        like_count: number
        dislike_count: number
        is_liked: boolean
        is_disliked: boolean
        created_at: string
    }

    const productId = ref(0)
    const detail = ref({
        id: 0, title: '', cover_image: '', images: [] as string[], price: 0, origin_price: 0,
        sales_count: 0, view_count: 0, stock: 0, description: '',
        shop_id: 0, shop_name: '', shop_logo: '', shop_rating: 0, shop_sales_count: 0
    } as Detail)
    const skuGroups = ref([] as SkuGroup[])
    const reviewList = ref([] as ReviewItem[])
    const reviewTotal = ref(0)
    const showSkuPanel = ref(false)
    const skuAction = ref('cart')
    const skuSelected = ref({} as UTSJSONObject)

    const skuSelectedText = computed(() : string => {
        const keys = Object.keys(skuSelected.value)
        if (keys.length == 0) return '请选择规格'
        const arr = [] as string[]
        for (let i = 0; i < keys.length; i++) {
            const v = (skuSelected.value[keys[i]] as string) ?? ''
            if (v.length > 0) arr.push(v)
        }
        return arr.join(' / ')
    })

    const loadDetail = () => {
        getMallProductDetail(productId.value).then((res: ApiResult) => {
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                detail.value = {
                    id: (d['id'] as number) ?? 0,
                    title: (d['title'] as string) ?? '',
                    cover_image: (d['cover_image'] as string) ?? '',
                    images: (d['images'] as string[]) ?? ([] as string[]),
                    price: (d['price'] as number) ?? 0,
                    origin_price: (d['origin_price'] as number) ?? 0,
                    sales_count: (d['sales_count'] as number) ?? 0,
                    view_count: (d['view_count'] as number) ?? 0,
                    stock: (d['stock'] as number) ?? 0,
                    description: (d['description'] as string) ?? '',
                    shop_id: (d['shop_id'] as number) ?? 0,
                    shop_name: (d['shop_name'] as string) ?? '',
                    shop_logo: (d['shop_logo'] as string) ?? '',
                    shop_rating: (d['shop_rating'] as number) ?? 0,
                    shop_sales_count: (d['shop_sales_count'] as number) ?? 0
                } as Detail
            }
        })
        listMallSkusByProduct(productId.value).then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                skuGroups.value = (res.data as SkuGroup[]) ?? ([] as SkuGroup[])
            }
        })
        loadReviews()
        incrMallProductView(productId.value)
    }

    const loadReviews = () => {
        const params: UTSJSONObject = {
            product_id: productId.value,
            page: 1,
            page_size: 3
        } as UTSJSONObject
        listMallReviewsByProduct(productId.value, params).then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                reviewList.value = (d['list'] as ReviewItem[]) ?? ([] as ReviewItem[])
                reviewTotal.value = (d['total'] as number) ?? 0
            }
        })
    }

    const onPreviewImage = (idx: number) => {
        uni.previewImage({
            urls: detail.value.images,
            current: detail.value.images[idx]
        })
    }

    const openSkuPanel = (action: string = 'cart') => {
        skuAction.value = action
        showSkuPanel.value = true
    }

    const closeSkuPanel = () => {
        showSkuPanel.value = false
    }

    const noop = () => {}

    const onAddCart = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        const data: UTSJSONObject = {
            product_id: productId.value,
            quantity: 1
        } as UTSJSONObject
        addMallCart(data).then((res: ApiResult) => {
            if (res.code == 200) {
                uni.showToast({ title: '已加入购物车', icon: 'success' })
                closeSkuPanel()
            } else {
                uni.showToast({ title: res.message || '加购失败', icon: 'none' })
            }
        })
    }

    const onBuyNow = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        closeSkuPanel()
        uni.navigateTo({ url: '/pages/business/mall/checkout/index?product_id=' + productId.value + '&qty=1' })
    }

    const onLikeReview = (id: number) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        likeMallReview(id).then((res: ApiResult) => {
            if (res.code == 200) {
                uni.showToast({ title: '点赞成功', icon: 'success' })
            }
        })
    }

    const goShop = () => {
        if (detail.value.shop_id > 0) {
            uni.navigateTo({ url: '/pages/business/mall/shop/index?id=' + detail.value.shop_id })
        }
    }

    const goCart = () => {
        uni.navigateTo({ url: '/pages/business/mall/cart/index' })
    }

    const goReviews = () => {
        uni.navigateTo({ url: '/pages/business/mall/reviews/index?product_id=' + productId.value })
    }

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            productId.value = parseInt(id as string)
            loadDetail()
        }
    })

    onPullDownRefresh(() => {
        loadDetail()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
    }

    .banner-wrap {
        width: 100%;
        height: 320px;
        background-color: #FFFFFF;
    }

