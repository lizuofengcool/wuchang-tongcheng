<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <love-story-card v-for="item in list" :key="item.id"
                    :story="transformStory(item)"
                    @click="goStoryDetail"
                    @like="onLike"
                    @comment="onComment"
                    @share="onShare"
                    @preview="onPreview" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <love-empty v-if="list.length == 0 && !loading" icon="📝" text="暂无动态" btn-text="发布动态" @click="goPublish" />
        </scroll-view>
        <view class="fab-btn" @click="goPublish">
            <text class="fab-icon">+</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { listLoveStories, listLoveStoriesFeatured, likeLoveStory, shareLoveStory } from '@/api/business/love.uts'

    type Tab = { key: string, name: string }
    type StoryItem = {
        id: number
        author_id: number
        author_name: string
        author_avatar: string
        content: string
        images: string[]
        topic: string
        like_count: number
        comment_count: number
        share_count: number
        view_count: number
        is_liked: boolean
        time_text: string
    }
    type StoryData = {
        id: number
        author_id: number
        author_name: string
        author_avatar: string
        content: string
        images: string[]
        topic: string
        like_count: number
        comment_count: number
        share_count: number
        view_count: number
        is_liked: boolean
        time_text: string
    }

    const tabs = ref([
        { key: 'latest', name: '最新' },
        { key: 'featured', name: '精选' }
    ] as Tab[])
    const currentTab = ref(0)
    const list = ref([] as StoryItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformStory = (item: StoryItem) : StoryData => {
        return {
            id: item.id,
            author_id: item.author_id,
            author_name: item.author_name,
            author_avatar: item.author_avatar,
            content: item.content,
            images: item.images,
            topic: item.topic,
            like_count: item.like_count,
            comment_count: item.comment_count,
            share_count: item.share_count,
            view_count: item.view_count,
            is_liked: item.is_liked,
            time_text: item.time_text
        } as StoryData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        const tabKey = tabs.value[currentTab.value].key
        const reqFn = tabKey == 'featured' ? listLoveStoriesFeatured(params) : listLoveStories(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as StoryItem[]) ?? ([] as StoryItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const onLike = (id: number) => {
        const item = list.value.find((it: StoryItem) : boolean => it.id == id)
        if (item == null) return
        if (item.is_liked) {
            uni.showToast({ title: '已点赞过', icon: 'none' })
            return
        }
        likeLoveStory(id).then((res: ApiResult) => {
            if (res.code == 200) {
                item.is_liked = true
                item.like_count++
                uni.showToast({ title: '点赞成功', icon: 'success' })
            }
        })
    }

    const onComment = (id: number) => {
        uni.showToast({ title: '评论功能开发中', icon: 'none' })
    }

    const onShare = (id: number) => {
        shareLoveStory(id).then((res: ApiResult) => {
            if (res.code == 200) {
                uni.showToast({ title: '分享成功', icon: 'success' })
            }
        })
    }

    const onPreview = (idx: number) => {
        // 由于 preview 在卡片内是单条事件，这里需要根据 story 上下文预览
        uni.showToast({ title: '预览图片', icon: 'none' })
    }

    const goStoryDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/love/stories/index?id=' + id })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/love/profile/edit.uvue' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .fab-btn {
        position: absolute;
        right: 20px;
        bottom: 30px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.4);
    }

    .fab-icon {
        font-size: 28px;
        color: #FFFFFF;
        font-weight: 300;
    }
</style>
