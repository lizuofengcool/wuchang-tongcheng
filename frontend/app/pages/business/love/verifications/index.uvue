        font-size: 13px;
        color: #666;
        width: 100px;
    }

    .required {
        color: #EE0A24;
    }

    .input {
        flex: 1;
        font-size: 14px;
        color: #333;
    }

    .id-card-wrap {
        flex-direction: row;
        margin-top: 8px;
    }

    .id-card-item {
        width: 140px;
        height: 90px;
        margin-right: 12px;
    }

    .id-card-img {
        width: 140px;
        height: 90px;
        border-radius: 6px;
    }

    .id-card-placeholder {
        width: 140px;
        height: 90px;
        border-width: 1px;
        border-color: #DDDDDD;
        border-style: dashed;
        border-radius: 6px;
        align-items: center;
        justify-content: center;
    }

    .id-card-icon {
        font-size: 24px;
    }

    .id-card-text {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
    }

    .cert-upload {
        margin-top: 8px;
    }

    .cert-img {
        width: 140px;
        height: 90px;
