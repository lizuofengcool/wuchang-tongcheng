        border-color: #DDDDDD;
        border-style: dashed;
        border-radius: 6px;
        align-items: center;
        justify-content: center;
    }

    .cert-icon {
        font-size: 24px;
    }

    .cert-text {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
    }

    .video-upload {
        margin-top: 8px;
        width: 140px;
        height: 90px;
        border-width: 1px;
        border-color: #DDDDDD;
        border-style: dashed;
        border-radius: 6px;
        align-items: center;
        justify-content: center;
    }

    .video-icon {
        font-size: 24px;
    }

    .video-text {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
    }

    .tips-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 80px;
    }

    .tips-title {
        font-size: 13px;
        color: #666;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .tips-text {
        font-size: 12px;
        color: #999;
        line-height: 1.8;
    }

    .bottom-bar {
        background-color: #FFFFFF;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .btn-submit {
        height: 44px;
        border-radius: 22px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .btn-text-white {
        font-size: 15px;
