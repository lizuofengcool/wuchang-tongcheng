<template>
    <view class="page">
        <groupbuy-filter
            :categories="categories"
            :current-category-id="currentCategoryId"
            :current-sort="currentSort"
            @search-click="goSearch"
            @category-change="changeCategory"
            @sort-change="changeSort"
        />
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <groupbuy-loading v-if="loading && list.length == 0" />
            <view class="list-wrap" v-if="list.length > 0">
                <groupbuy-card v-for="item in list" :key="item.id" :groupbuy="transformCard(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading && list.length > 0">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <groupbuy-empty v-if="list.length == 0 && !loading" icon="🎫" text="暂无团购" btn-text="去搜索" @click="goSearch" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { listGroupBuys } from '@/api/business/groupbuy.uts'

    type ListItem = {
        id: number
        title: string
        sub_title: string
        cover_image: string
        price: number
        origin_price: number
        sales_count: number
        stock: number
        shop_name: string
        status: number
        is_featured: boolean
        is_hot: boolean
    }
    type CardData = {
        id: number
        title: string
        sub_title: string
        cover_image: string
        price: number
        origin_price: number
        sales_count: number
        stock: number
        shop_name: string
        status: number
        is_featured: boolean
        is_hot: boolean
    }
    type Category = {
        id: number
        name: string
    }

    const categories = ref([] as Category[])
    const currentCategoryId = ref(0)
    const currentSort = ref('popular')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            sub_title: item.sub_title,
            cover_image: item.cover_image,
            price: item.price,
            origin_price: item.origin_price,
            sales_count: item.sales_count,
            stock: item.stock,
            shop_name: item.shop_name,
            status: item.status,
            is_featured: item.is_featured,
            is_hot: item.is_hot
        } as CardData
    }

    const changeCategory = (id: number) => {
        if (currentCategoryId.value == id) return
        currentCategoryId.value = id
        loadList(true)
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value
        } as UTSJSONObject
        if (currentCategoryId.value > 0) {
            params['category_id'] = currentCategoryId.value
        }

        listGroupBuys(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/groupbuy/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/groupbuy/search/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 8px 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
