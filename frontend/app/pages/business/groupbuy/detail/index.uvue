<template>
    <view class="page">
        <groupbuy-loading v-if="loading" />
        <scroll-view class="content" scroll-y v-if="!loading && detail.id > 0">
            <groupbuy-detail-header :detail="detail" @preview="onPreviewImage" @shop-click="goShop" />
            <view class="section" v-if="detail.description.length > 0">
                <text class="section-title">图文详情</text>
                <text class="section-content">{{ detail.description }}</text>
            </view>
            <view class="section" v-if="detail.validity_text.length > 0 || detail.usage_text.length > 0">
                <text class="section-title">购买须知</text>
                <text class="section-content" v-if="detail.validity_text.length > 0">有效期：{{ detail.validity_text }}</text>
                <text class="section-content" v-if="detail.usage_text.length > 0">使用规则：{{ detail.usage_text }}</text>
            </view>
            <view class="section" v-if="reviews.length > 0">
                <view class="section-header">
                    <text class="section-title">用户评价 ({{ reviewTotal }})</text>
                </view>
                <view class="review-item" v-for="(r, idx) in reviews" :key="idx">
                    <view class="review-user-row">
                        <text class="review-user">{{ r.user_name }}</text>
                        <text class="review-rating">{{ ratingText(r.rating) }}</text>
                    </view>
                    <text class="review-content">{{ r.content }}</text>
                </view>
            </view>
        </scroll-view>
        <groupbuy-empty v-if="!loading && detail.id == 0" icon="😕" text="团购不存在或已下架" btn-text="返回列表" @click="goBack" />
        <view class="bottom-bar" v-if="!loading && detail.id > 0">
            <view class="bottom-btn" @click="goCoupons">
                <text class="bottom-icon">🎟</text>
                <text class="bottom-text">优惠券</text>
            </view>
            <view class="btn-buy" @click="onBuy">
                <text class="btn-buy-text">¥{{ detail.price }} 立即购买</text>
            </view>
        </view>
        <view class="buy-mask" v-if="showBuyPanel" @click="closeBuyPanel">
            <view class="buy-panel" @click.stop="noop">
                <view class="buy-header">
                    <image class="buy-cover" :src="detail.cover_image" mode="aspectFill" v-if="detail.cover_image.length > 0" />
                    <view class="buy-cover-placeholder" v-else>
                        <text class="buy-cover-text">团</text>
                    </view>
                    <view class="buy-info">
                        <text class="buy-title">{{ detail.title }}</text>
                        <text class="buy-price">¥{{ detail.price }}</text>
                    </view>
                    <text class="buy-close" @click="closeBuyPanel">✕</text>
                </view>
                <view class="qty-row">
                    <text class="qty-label">购买数量</text>
                    <view class="qty-control">
                        <text class="qty-btn" @click="onMinus">-</text>
                        <text class="qty-value">{{ quantity }}</text>
                        <text class="qty-btn" @click="onPlus">+</text>
                    </view>
                </view>
                <view class="buy-action" @click="onConfirmBuy">
                    <text class="buy-action-text">确认购买</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { requireLogin } from '@/utils/auth.uts'
    import { getGroupBuyDetail, createGroupBuyOrder } from '@/api/business/groupbuy.uts'

    type Detail = {
        id: number
        title: string
        sub_title: string
        cover_image: string
        images: string[]
        price: number
        origin_price: number
        sales_count: number
        stock: number
        description: string
        validity_text: string
        usage_text: string
        shop_id: number
        shop_name: string
        shop_logo: string
        shop_address: string
        status: number
    }
    type Review = {
        user_name: string
        rating: number
        content: string
    }

    const groupbuyId = ref(0)
    const detail = ref({
        id: 0, title: '', sub_title: '', cover_image: '', images: [] as string[],
        price: 0, origin_price: 0, sales_count: 0, stock: 0,
        description: '', validity_text: '', usage_text: '',
        shop_id: 0, shop_name: '', shop_logo: '', shop_address: '', status: 0
    } as Detail)
    const reviews = ref([] as Review[])
    const reviewTotal = ref(0)
    const loading = ref(true)
    const showBuyPanel = ref(false)
    const quantity = ref(1)

    const ratingText = (rating: number) : string => {
        return '★'.repeat(rating)
    }

    const loadDetail = () => {
        loading.value = true
        getGroupBuyDetail(groupbuyId.value).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                detail.value = {
                    id: (d['id'] as number) ?? 0,
                    title: (d['title'] as string) ?? '',
                    sub_title: (d['sub_title'] as string) ?? '',
                    cover_image: (d['cover_image'] as string) ?? '',
                    images: (d['images'] as string[]) ?? ([] as string[]),
                    price: (d['price'] as number) ?? 0,
                    origin_price: (d['origin_price'] as number) ?? 0,
                    sales_count: (d['sales_count'] as number) ?? 0,
                    stock: (d['stock'] as number) ?? 0,
                    description: (d['description'] as string) ?? '',
                    validity_text: (d['validity_text'] as string) ?? '',
                    usage_text: (d['usage_text'] as string) ?? '',
                    shop_id: (d['shop_id'] as number) ?? 0,
                    shop_name: (d['shop_name'] as string) ?? '',
                    shop_logo: (d['shop_logo'] as string) ?? '',
                    shop_address: (d['shop_address'] as string) ?? '',
                    status: (d['status'] as number) ?? 0
                } as Detail
                reviews.value = (d['reviews'] as Review[]) ?? ([] as Review[])
                reviewTotal.value = (d['review_total'] as number) ?? 0
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const onPreviewImage = (idx: number) => {
        if (detail.value.images.length == 0) return
        uni.previewImage({
            urls: detail.value.images,
            current: detail.value.images[idx]
        })
    }

    const goShop = () => {
        if (detail.value.shop_id > 0) {
            uni.navigateTo({ url: '/pages/business/dh114/detail/index?id=' + detail.value.shop_id })
        }
    }

    const goCoupons = () => {
        uni.navigateTo({ url: '/pages/business/groupbuy/coupons/index' })
    }

    const goBack = () => {
        uni.navigateBack()
    }

    const noop = () => {}

    const onBuy = () => {
        if (!requireLogin()) return
        if (detail.value.status == 2) {
            uni.showToast({ title: '团购已售罄', icon: 'none' })
            return
        }
        if (detail.value.stock > 0 && detail.value.stock < quantity.value) {
            uni.showToast({ title: '库存不足', icon: 'none' })
            return
        }
        showBuyPanel.value = true
    }

    const closeBuyPanel = () => {
        showBuyPanel.value = false
    }

    const onMinus = () => {
        if (quantity.value > 1) quantity.value--
    }

    const onPlus = () => {
        if (detail.value.stock > 0 && quantity.value >= detail.value.stock) {
            uni.showToast({ title: '库存不足', icon: 'none' })
            return
        }
        quantity.value++
    }

    const onConfirmBuy = () => {
        const data: UTSJSONObject = {
            groupbuy_id: groupbuyId.value,
            quantity: quantity.value,
            address_id: 0
        } as UTSJSONObject
        createGroupBuyOrder(data).then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const orderId = (d['id'] as number) ?? 0
                uni.showToast({ title: '下单成功', icon: 'success' })
                closeBuyPanel()
                if (orderId > 0) {
                    setTimeout(() => {
                        uni.navigateTo({ url: '/pages/business/groupbuy/orders/detail?id=' + orderId })
                    }, 800)
                }
            } else {
                uni.showToast({ title: res.message || '下单失败', icon: 'none' })
            }
        }).catch(() => {})
    }

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            groupbuyId.value = parseInt(id as string)
            loadDetail()
        } else {
            loading.value = false
        }
    })

    onPullDownRefresh(() => {
        loadDetail()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-top: 8px;
    }

    .section-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .section-content {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
        margin-top: 4px;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .review-item {
        padding: 10px 0;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .review-user-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .review-user {
        font-size: 13px;
        color: #333;
        font-weight: 600;
    }

    .review-rating {
        font-size: 12px;
        color: #FF6B35;
    }

    .review-content {
        font-size: 12px;
        color: #666;
        line-height: 1.6;
    }

    .bottom-bar {
        flex-direction: row;
        background-color: #FFFFFF;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
        align-items: center;
    }

    .bottom-btn {
        align-items: center;
        justify-content: center;
        width: 60px;
        padding: 4px 0;
    }

    .bottom-icon {
        font-size: 20px;
    }

    .bottom-text {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
    }

    .btn-buy {
        flex: 1;
        height: 44px;
        border-radius: 22px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-left: 8px;
    }

    .btn-buy-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .buy-mask {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        justify-content: flex-end;
    }

    .buy-panel {
        background-color: #FFFFFF;
        border-top-left-radius: 16px;
        border-top-right-radius: 16px;
        padding: 16px;
    }

    .buy-header {
        flex-direction: row;
        align-items: center;
        padding-bottom: 12px;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .buy-cover {
        width: 80px;
        height: 80px;
        border-radius: 6px;
    }

    .buy-cover-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 6px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .buy-cover-text {
        font-size: 28px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .buy-info {
        flex: 1;
        margin-left: 10px;
    }

    .buy-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .buy-price {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
        margin-top: 6px;
    }

    .buy-close {
        font-size: 18px;
        color: #999;
        padding: 8px;
    }

    .qty-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 16px 0;
    }

    .qty-label {
        font-size: 14px;
        color: #333;
    }

    .qty-control {
        flex-direction: row;
        align-items: center;
    }

    .qty-btn {
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background-color: #F5F5F5;
        text-align: center;
        font-size: 18px;
        color: #333;
        line-height: 32px;
    }

    .qty-value {
        width: 50px;
        text-align: center;
        font-size: 14px;
        color: #333;
    }

    .buy-action {
        height: 44px;
        border-radius: 22px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-top: 8px;
    }

    .buy-action-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
