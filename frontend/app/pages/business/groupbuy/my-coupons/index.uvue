<template>
    <view class="page">
        <view class="tabs-bar">
            <view class="tab-item" v-for="(t, idx) in tabs" :key="idx"
                :class="{ active: currentTab == t.value }" @click="changeTab(t.value)">
                <text class="tab-text" :class="{ active: currentTab == t.value }">{{ t.label }}</text>
            </view>
        </view>
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <groupbuy-loading v-if="loading && list.length == 0" />
            <view class="list-wrap" v-if="list.length > 0">
                <groupbuy-coupon-card
                    v-for="item in list"
                    :key="item.id"
                    :coupon="transformCard(item)"
                />
            </view>
            <view class="load-more" v-if="loading && list.length > 0">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <groupbuy-empty v-if="list.length == 0 && !loading" :icon="emptyIcon" :text="emptyText" btn-text="去领券" @click="goCoupons" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { requireLogin } from '@/utils/auth.uts'
    import { getMyCoupons } from '@/api/business/groupbuy.uts'

    type Tab = { label: string, value: number }

    type ListItem = {
        id: number
        title: string
        amount: number
        threshold: number
        applicable_text: string
        start_time: string
        end_time: string
        status: number
        stock: number
        received: boolean
    }
    type CardData = {
        id: number
        title: string
        amount: number
        threshold: number
        applicable_text: string
        start_time: string
        end_time: string
        status: number
        stock: number
        received: boolean
    }

    const tabs = ref([
        { label: '未使用', value: 0 } as Tab,
        { label: '已使用', value: 1 } as Tab,
        { label: '已过期', value: 2 } as Tab
    ] as Tab[])
    const currentTab = ref(0)
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const emptyIcon = computed(() : string => {
        if (currentTab.value == 0) return '🎟'
        if (currentTab.value == 1) return '📋'
        return '⏰'
    })

    const emptyText = computed(() : string => {
        if (currentTab.value == 0) return '暂无未使用优惠券'
        if (currentTab.value == 1) return '暂无已使用优惠券'
        return '暂无已过期优惠券'
    })

    const transformCard = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            amount: item.amount,
            threshold: item.threshold,
            applicable_text: item.applicable_text,
            start_time: item.start_time,
            end_time: item.end_time,
            status: item.status,
            stock: item.stock,
            received: item.received
        } as CardData
    }

    const changeTab = (val: number) => {
        if (currentTab.value == val) return
        currentTab.value = val
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            status: currentTab.value
        } as UTSJSONObject

        getMyCoupons(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goCoupons = () => {
        uni.navigateTo({ url: '/pages/business/groupbuy/coupons/index' })
    }

    onLoad(() => {
        if (!requireLogin()) return
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tabs-bar {
        flex-direction: row;
        background-color: #FFFFFF;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .tab-item {
        flex: 1;
        padding: 12px 0;
        align-items: center;
    }

    .tab-text {
        font-size: 14px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-item.active {
        border-bottom-width: 2px;
        border-bottom-color: #FF6B35;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
