<template>
    <view class="page">
        <view class="search-bar">
            <text class="back-arrow" @click="goBack">‹</text>
            <input class="search-input" type="text" v-model="keyword" placeholder="搜索起点/终点/车主" :focus="true" @confirm="doSearch" />
            <text class="search-btn" @click="doSearch">搜索</text>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view v-if="!hasSearched">
                <view class="section" v-if="hotKeywords.length > 0">
                    <text class="section-title">热门路线</text>
                    <view class="tag-wrap">
                        <view class="tag" v-for="(k, idx) in hotKeywords" :key="idx" @click="onTag(k)">
                            <text class="tag-text">{{ k }}</text>
                        </view>
                    </view>
                </view>
                <view class="section" v-if="historyKeywords.length > 0">
                    <view class="section-header">
                        <text class="section-title">搜索历史</text>
                        <text class="clear-text" @click="clearHistory">清空</text>
                    </view>
                    <view class="history-list">
                        <view class="history-item" v-for="(k, idx) in historyKeywords" :key="idx" @click="onTag(k)">
                            <text class="history-time">🕒</text>
                            <text class="history-text">{{ k }}</text>
                        </view>
                    </view>
                </view>
                <view class="section">
                    <text class="section-title">常用筛选</text>
                    <view class="quick-row">
                        <view class="quick-tag" @click="quickSearch('today')">今天出发</view>
                        <view class="quick-tag" @click="quickSearch('tomorrow')">明天出发</view>
                        <view class="quick-tag" @click="quickSearch('nearby')">附近行程</view>
                    </view>
                </view>
            </view>
            <view v-else>
                <view class="list-wrap">
                    <pinche-card v-for="item in resultList" :key="item.id" :pinche="transformPinche(item)" @click="goDetail" />
                </view>
                <view class="load-more" v-if="loading">
                    <text class="load-text">加载中...</text>
                </view>
                <view class="no-more" v-if="!hasMore && resultList.length > 0">
                    <text class="no-more-text">已经到底啦~</text>
                </view>
                <pinche-empty v-if="resultList.length == 0 && !loading" icon="🔍" text="未找到相关行程" btn-text="换个关键词" @click="clearSearch" />
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { searchPinches, listNearbyPinches } from '@/api/business/pinche.uts'

    type ResultItem = {
        id: number
        origin: string
        destination: string
        departure_time: string
        price: number
        seats_available: number
        vehicle_model: string
        driver_name: string
        driver_avatar: string
        driver_rating: number
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_verified: boolean
    }
    type PincheCardData = {
        id: number
        origin: string
        destination: string
        departure_time: string
        price: number
        seats_available: number
        vehicle_model: string
        driver_name: string
        driver_avatar: string
        driver_rating: number
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_verified: boolean
    }

    const keyword = ref('')
    const hotKeywords = ref([] as string[])
    const historyKeywords = ref([] as string[])
    const hasSearched = ref(false)
    const resultList = ref([] as ResultItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20
    const searchType = ref('')

    const transformPinche = (item: ResultItem) : PincheCardData => {
        return {
            id: item.id,
            origin: item.origin,
            destination: item.destination,
            departure_time: item.departure_time,
            price: item.price,
            seats_available: item.seats_available,
            vehicle_model: item.vehicle_model,
            driver_name: item.driver_name,
            driver_avatar: item.driver_avatar,
            driver_rating: item.driver_rating,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_verified: item.is_verified
        } as PincheCardData
    }

    const loadInit = () => {
        const hot = uni.getStorageSync('pinche_hot_keywords')
        if (hot instanceof Array) hotKeywords.value = hot as string[]
        const his = uni.getStorageSync('pinche_search_history')
        if (his instanceof Array) historyKeywords.value = his as string[]
    }

    const doSearch = () => {
        const kw = keyword.value.trim()
        if (kw.length == 0) {
            uni.showToast({ title: '请输入关键词', icon: 'none' })
            return
        }
        searchType.value = 'keyword'
        hasSearched.value = true
        addHistory(kw)
        loadResult(true)
    }

    const quickSearch = (type: string) => {
        searchType.value = type
        hasSearched.value = true
        if (type == 'today') {
            keyword.value = '今天'
        } else if (type == 'tomorrow') {
            keyword.value = '明天'
        } else if (type == 'nearby') {
            keyword.value = '附近'
        }
        loadResult(true)
    }

    const loadResult = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        if (searchType.value == 'keyword') {
            params['keyword'] = keyword.value
        } else if (searchType.value == 'today') {
            params['date'] = 'today'
        } else if (searchType.value == 'tomorrow') {
            params['date'] = 'tomorrow'
        } else if (searchType.value == 'nearby') {
            params['nearby'] = true
        }

        const reqFn = searchType.value == 'nearby' ? listNearbyPinches(params) : searchPinches(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ResultItem[]) ?? ([] as ResultItem[])
                if (reset) {
                    resultList.value = newList
                } else {
                    resultList.value = resultList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadResult(false)
    }

    const addHistory = (k: string) => {
        if (k.length == 0) return
        const idx = historyKeywords.value.indexOf(k)
        if (idx >= 0) historyKeywords.value.splice(idx, 1)
        historyKeywords.value.unshift(k)
        if (historyKeywords.value.length > 20) historyKeywords.value.splice(20)
        uni.setStorageSync('pinche_search_history', historyKeywords.value)
    }

    const onTag = (k: string) => {
        keyword.value = k
        doSearch()
    }

    const clearHistory = () => {
        uni.showModal({
            title: '提示',
            content: '确认清空搜索历史？',
            success: (res) => {
                if (res.confirm) {
                    historyKeywords.value = [] as string[]
                    uni.removeStorageSync('pinche_search_history')
                    uni.showToast({ title: '已清空', icon: 'success' })
                }
            }
        })
    }

    const clearSearch = () => {
        keyword.value = ''
        hasSearched.value = false
        resultList.value = [] as ResultItem[]
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/pinche/detail/index?id=' + id })
    }

    const goBack = () => {
        uni.navigateBack()
    }

    onLoad(() => {
        loadInit()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
    }

    .back-arrow {
        font-size: 24px;
        color: #333;
        padding: 0 8px;
    }

    .search-input {
        flex: 1;
        background-color: #F5F5F5;
        border-radius: 18px;
        padding: 8px 12px;
        font-size: 13px;
        color: #333;
    }

    .search-btn {
        font-size: 14px;
        color: #FF6B35;
        margin-left: 12px;
    }

    .content {
        flex: 1;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-top: 8px;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .clear-text {
        font-size: 12px;
        color: #999;
    }

    .tag-wrap {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .tag {
        background-color: #F5F5F5;
        border-radius: 14px;
        padding: 4px 12px;
        margin-right: 8px;
        margin-top: 8px;
    }

    .tag-text {
        font-size: 12px;
        color: #666;
    }

    .history-list {
        flex-direction: column;
    }

    .history-item {
        flex-direction: row;
        align-items: center;
        padding: 10px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .history-time {
        font-size: 13px;
        color: #CCC;
        margin-right: 8px;
    }

    .history-text {
        font-size: 13px;
        color: #333;
    }

    .quick-row {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .quick-tag {
        background-color: #FFF5F0;
        border-radius: 14px;
        padding: 6px 14px;
        margin-right: 8px;
        margin-top: 8px;
        font-size: 12px;
        color: #FF6B35;
    }

    .list-wrap {
        padding: 8px 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
