<template>
    <view class="page">
        <view class="role-bar">
            <view class="role-item" :class="{ active: role == 'driver' }" @click="switchRole('driver')">
                <text class="role-text" :class="{ active: role == 'driver' }">🚗 车主视角</text>
            </view>
            <view class="role-item" :class="{ active: role == 'passenger' }" @click="switchRole('passenger')">
                <text class="role-text" :class="{ active: role == 'passenger' }">🧍 乘客视角</text>
            </view>
        </view>
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="stats-card" v-if="stats.total >= 0">
                <view class="stat-item">
                    <text class="stat-num">{{ stats.total }}</text>
                    <text class="stat-label">总行程</text>
                </view>
                <view class="stat-item">
                    <text class="stat-num">{{ stats.ongoing }}</text>
                    <text class="stat-label">进行中</text>
                </view>
                <view class="stat-item">
                    <text class="stat-num">{{ stats.completed }}</text>
                    <text class="stat-label">已完成</text>
                </view>
                <view class="stat-item" v-if="role == 'driver'">
                    <text class="stat-num">¥{{ stats.revenue }}</text>
                    <text class="stat-label">总收入</text>
                </view>
                <view class="stat-item" v-else>
                    <text class="stat-num">¥{{ stats.cost }}</text>
                    <text class="stat-label">总花费</text>
                </view>
            </view>
            <view class="list-wrap">
                <pinche-trip-card v-for="item in list" :key="item.id" :trip="transformTrip(item)" @click="goTripDetail" @share="onShare" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <pinche-empty v-if="list.length == 0 && !loading" icon="🛣️" :text="role == 'driver' ? '暂无车主行程' : '暂无乘客行程'" btn-text="去找行程" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listMyTrips, shareTrip } from '@/api/business/pinche.uts'

    type Tab = { key: string, name: string }
    type Stats = {
        total: number
        ongoing: number
        completed: number
        revenue: number
        cost: number
    }
    type ListItem = {
        id: number
        trip_no: string
        origin: string
        destination: string
        status: string
        start_time: string
        end_time: string
        passenger_count: number
        revenue: number
        cost: number
    }
    type TripCardData = {
        id: number
        trip_no: string
        origin: string
        destination: string
        status: string
        start_time: string
        end_time: string
        passenger_count: number
        revenue: number
        cost: number
    }

    const role = ref('driver')
    const tabs = ref([
        { key: 'all', name: '全部' },
        { key: 'ongoing', name: '进行中' },
        { key: 'completed', name: '已完成' },
        { key: 'cancelled', name: '已取消' }
    ] as Tab[])
    const currentTab = ref(0)
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const stats = ref({ total: 0, ongoing: 0, completed: 0, revenue: 0, cost: 0 } as Stats)

    const transformTrip = (item: ListItem) : TripCardData => {
        return {
            id: item.id,
            trip_no: item.trip_no,
            origin: item.origin,
            destination: item.destination,
            status: item.status,
            start_time: item.start_time,
            end_time: item.end_time,
            passenger_count: item.passenger_count,
            revenue: item.revenue,
            cost: item.cost
        } as TripCardData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        listMyTrips().then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                let allList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                const tabKey = tabs.value[currentTab.value].key
                if (tabKey != 'all') {
                    allList = allList.filter((item: ListItem) : boolean => item.status == tabKey)
                }
                const s: Stats = {
                    total: allList.length,
                    ongoing: allList.filter((item: ListItem) : boolean => item.status == 'ongoing').length,
                    completed: allList.filter((item: ListItem) : boolean => item.status == 'completed').length,
                    revenue: 0,
                    cost: 0
                } as Stats
                for (let i = 0; i < allList.length; i++) {
                    const item = allList[i]
                    s.revenue += item.revenue
                    s.cost += item.cost
                }
                stats.value = s
                list.value = allList
                hasMore.value = false
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchRole = (r: string) => {
        if (role.value == r) return
        role.value = r
        loadList(true)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const goTripDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/pinche/detail/index?id=' + id })
    }

    const onShare = (id: number) => {
        uni.showLoading({ title: '生成分享链接...' })
        shareTrip(id).then((res: ApiResult) => {
            uni.hideLoading()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const token = (d['share_token'] as string) ?? ''
                const url = 'http://localhost:8088/share/trip/' + token
                uni.setClipboardData({
                    data: url,
                    success: () => {
                        uni.showToast({ title: '链接已复制', icon: 'success' })
                    }
                })
            } else {
                uni.showToast({ title: res.message || '分享失败', icon: 'none' })
            }
        }).catch(() => {
            uni.hideLoading()
        })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/pinche/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .role-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 8px 12px;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .role-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        padding: 8px 0;
        margin: 0 4px;
        border-radius: 18px;
        background-color: #F5F5F5;
    }

    .role-item.active {
        background-color: #FF6B35;
    }

    .role-text {
        font-size: 13px;
        color: #666;
    }

    .role-text.active {
        color: #FFFFFF;
        font-weight: 600;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .stats-card {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 16px 12px;
        margin: 8px 12px;
        border-radius: 12px;
    }

    .stat-item {
        flex: 1;
        align-items: center;
    }

    .stat-num {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .stat-label {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
