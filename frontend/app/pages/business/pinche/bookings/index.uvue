<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <pinche-booking-card v-for="item in list" :key="item.id" :booking="transformBooking(item)" :actions="getActions(item)" @click="goDetail" @action="onAction" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <pinche-empty v-if="list.length == 0 && !loading" icon="📋" text="暂无预订记录" btn-text="去找行程" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listMyBookings, cancelBooking, confirmBoarding } from '@/api/business/pinche.uts'

    type Tab = { key: string, name: string }
    type Action = { key: string, label: string, type: string }
    type ListItem = {
        id: number
        origin: string
        destination: string
        departure_time: string
        seats: number
        price: number
        status: string
        peer_name: string
        peer_avatar: string
        peer_phone: string
        created_at: string
    }
    type BookingCardData = {
        id: number
        origin: string
        destination: string
        departure_time: string
        seats: number
        price: number
        status: string
        peer_name: string
        peer_avatar: string
        peer_phone: string
        created_at: string
    }

    const tabs = ref([
        { key: 'ongoing', name: '进行中' },
        { key: 'completed', name: '已完成' },
        { key: 'cancelled', name: '已取消' }
    ] as Tab[])
    const currentTab = ref(0)
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformBooking = (item: ListItem) : BookingCardData => {
        return {
            id: item.id,
            origin: item.origin,
            destination: item.destination,
            departure_time: item.departure_time,
            seats: item.seats,
            price: item.price,
            status: item.status,
            peer_name: item.peer_name,
            peer_avatar: item.peer_avatar,
            peer_phone: item.peer_phone,
            created_at: item.created_at
        } as BookingCardData
    }

    const getActions = (item: ListItem) : Action[] => {
        const arr = [] as Action[]
        if (item.status == 'pending' || item.status == 'confirmed') {
            arr.push({ key: 'cancel', label: '取消', type: 'danger' } as Action)
        }
        if (item.status == 'confirmed') {
            arr.push({ key: 'boarding', label: '确认上车', type: 'primary' } as Action)
        }
        if (item.status == 'completed') {
            arr.push({ key: 'rate', label: '去评价', type: 'primary' } as Action)
        }
        return arr
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            status: tabs.value[currentTab.value].key
        } as UTSJSONObject

        listMyBookings().then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                let allList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                const tabKey = tabs.value[currentTab.value].key
                if (tabKey == 'ongoing') {
                    allList = allList.filter((item: ListItem) : boolean => item.status == 'pending' || item.status == 'confirmed' || item.status == 'boarding')
                } else if (tabKey == 'completed') {
                    allList = allList.filter((item: ListItem) : boolean => item.status == 'completed')
                } else if (tabKey == 'cancelled') {
                    allList = allList.filter((item: ListItem) : boolean => item.status == 'cancelled' || item.status == 'expired')
                }
                if (reset) {
                    list.value = allList
                } else {
                    list.value = list.value.concat(allList)
                }
                hasMore.value = allList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const onAction = (id: number, key: string) => {
        if (key == 'cancel') {
            uni.showModal({
                title: '取消预订',
                content: '确认取消该预订？',
                success: (res) => {
                    if (res.confirm) {
                        uni.showLoading({ title: '处理中...' })
                        cancelBooking(id).then((r: ApiResult) => {
                            uni.hideLoading()
                            if (r.code == 200) {
                                uni.showToast({ title: '已取消', icon: 'success' })
                                loadList(true)
                            } else {
                                uni.showToast({ title: r.message || '操作失败', icon: 'none' })
                            }
                        }).catch(() => {
                            uni.hideLoading()
                        })
                    }
                }
            })
        } else if (key == 'boarding') {
            uni.showModal({
                title: '确认上车',
                content: '确认已上车？',
                success: (res) => {
                    if (res.confirm) {
                        uni.showLoading({ title: '处理中...' })
                        confirmBoarding(id).then((r: ApiResult) => {
                            uni.hideLoading()
                            if (r.code == 200) {
                                uni.showToast({ title: '已确认上车', icon: 'success' })
                                loadList(true)
                            } else {
                                uni.showToast({ title: r.message || '操作失败', icon: 'none' })
                            }
                        }).catch(() => {
                            uni.hideLoading()
                        })
                    }
                }
            })
        } else if (key == 'rate') {
            uni.navigateTo({ url: '/pages/business/pinche/ratings/index?booking_id=' + id })
        }
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/pinche/detail/index?id=' + id })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/pinche/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
