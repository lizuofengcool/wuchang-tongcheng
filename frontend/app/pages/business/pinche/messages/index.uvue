<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="session-card" v-for="item in sessionList" :key="item.id" @click="goChat(item)">
                <image class="avatar" :src="item.peer_avatar" mode="aspectFill" lazy-load="true" v-if="item.peer_avatar.length > 0" />
                <view class="avatar-placeholder" v-else>
                    <text class="avatar-text">{{ item.peer_name.length > 0 ? item.peer_name.charAt(0) : 'U' }}</text>
                </view>
                <view class="info">
                    <view class="header-row">
                        <text class="name">{{ item.peer_name }}</text>
                        <text class="time">{{ item.last_time }}</text>
                    </view>
                    <view class="preview-row">
                        <text class="preview">{{ item.last_message || '暂无消息' }}</text>
                        <view class="unread-badge" v-if="item.unread_count > 0">
                            <text class="unread-text">{{ item.unread_count }}</text>
                        </view>
                    </view>
                </view>
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && sessionList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <pinche-empty v-if="sessionList.length == 0 && !loading" icon="💬" text="暂无行程消息" btn-text="去找行程" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'

    type Tab = { key: string, name: string }
    type Session = {
        id: number
        pinche_id: number
        trip_info: string
        peer_id: number
        peer_name: string
        peer_avatar: string
        last_message: string
        last_time: string
        unread_count: number
    }

    const tabs = ref([
        { key: 'all', name: '全部' },
        { key: 'unread', name: '未读' },
        { key: 'trip', name: '行程' }
    ] as Tab[])
    const currentTab = ref(0)
    const sessionList = ref([] as Session[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        // 行程消息复用本地存储 + 后端拉取（后端 pinche 模块预留 messages 表）
        // 此处直接使用本地会话缓存演示，实际可调用 listMessages API
        const localData = uni.getStorageSync('pinche_sessions') as UTSJSONObject[]
        if (localData instanceof Array) {
            let allList = [] as Session[]
            for (let i = 0; i < localData.length; i++) {
                const obj = localData[i] as UTSJSONObject
                allList.push({
                    id: (obj['id'] as number) ?? 0,
                    pinche_id: (obj['pinche_id'] as number) ?? 0,
                    trip_info: (obj['trip_info'] as string) ?? '',
                    peer_id: (obj['peer_id'] as number) ?? 0,
                    peer_name: (obj['peer_name'] as string) ?? '',
                    peer_avatar: (obj['peer_avatar'] as string) ?? '',
                    last_message: (obj['last_message'] as string) ?? '',
                    last_time: (obj['last_time'] as string) ?? '',
                    unread_count: (obj['unread_count'] as number) ?? 0
                } as Session)
            }
            const tabKey = tabs.value[currentTab.value].key
            if (tabKey == 'unread') {
                allList = allList.filter((s: Session) : boolean => s.unread_count > 0)
            }
            sessionList.value = allList
            hasMore.value = false
        } else {
            sessionList.value = [] as Session[]
            hasMore.value = false
        }
        loading.value = false
        uni.stopPullDownRefresh()
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const goChat = (item: Session) => {
        uni.navigateTo({ url: '/pages/business/pinche/messages/chat?session_id=' + item.id + '&pinche_id=' + item.pinche_id + '&peer_id=' + item.peer_id + '&peer_name=' + encodeURIComponent(item.peer_name) })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/pinche/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .session-card {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 12px 16px;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        margin-right: 12px;
    }

    .avatar-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .avatar-text {
        font-size: 20px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .info {
        flex: 1;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .name {
        font-size: 15px;
        color: #333;
        font-weight: 500;
        flex: 1;
    }

    .time {
        font-size: 11px;
        color: #999;
    }

    .preview-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 4px;
    }

    .preview {
        font-size: 12px;
        color: #999;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .unread-badge {
        background-color: #EE0A24;
        border-radius: 10px;
        padding: 1px 6px;
        margin-left: 8px;
    }

    .unread-text {
        font-size: 10px;
        color: #FFFFFF;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
