<template>
    <view class="page">
        <scroll-view class="msg-list" scroll-y :scroll-top="scrollTop" :scroll-into-view="scrollToId">
            <view class="msg-item" v-for="(msg, idx) in messageList" :key="idx" :id="'msg-' + idx">
                <view class="msg-bubble" :class="{ mine: msg.is_mine, peer: !msg.is_mine }">
                    <text class="msg-sender" v-if="!msg.is_mine">{{ peerName }}</text>
                    <text class="msg-content">{{ msg.content }}</text>
                    <text class="msg-time">{{ msg.created_at }}</text>
                </view>
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && messageList.length > 0">
                <text class="no-more-text">没有更多消息了</text>
            </view>
            <view class="empty-msg" v-if="messageList.length == 0 && !loading">
                <text class="empty-text">暂无消息，发起对话吧~</text>
            </view>
        </scroll-view>
        <view class="input-bar">
            <input class="msg-input" type="text" v-model="inputText" placeholder="请输入消息" :confirm-type="'send'" @confirm="onSend" />
            <view class="send-btn" @click="onSend">
                <text class="send-text">发送</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { recordPincheView } from '@/api/business/pinche.uts'

    type Message = {
        id: number
        session_id: number
        sender_id: number
        content: string
        type: string
        is_mine: boolean
        created_at: string
    }

    const sessionId = ref(0)
    const pincheId = ref(0)
    const peerId = ref(0)
    const peerName = ref('')
    const messageList = ref([] as Message[])
    const inputText = ref('')
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 50
    const scrollTop = ref(0)
    const scrollToId = ref('')

    const loadMessages = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        // 行程消息使用本地存储演示（后端 pinche 模块预留 messages 表，待对接）
        const key = 'pinche_messages_' + sessionId.value
        const localData = uni.getStorageSync(key) as UTSJSONObject[]
        if (localData instanceof Array) {
            const list = [] as Message[]
            for (let i = 0; i < localData.length; i++) {
                const obj = localData[i] as UTSJSONObject
                list.push({
                    id: (obj['id'] as number) ?? 0,
                    session_id: (obj['session_id'] as number) ?? sessionId.value,
                    sender_id: (obj['sender_id'] as number) ?? 0,
                    content: (obj['content'] as string) ?? '',
                    type: (obj['type'] as string) ?? 'text',
                    is_mine: (obj['is_mine'] as boolean) ?? false,
                    created_at: (obj['created_at'] as string) ?? ''
                } as Message)
            }
            messageList.value = list
            hasMore.value = false
        } else {
            messageList.value = [] as Message[]
            hasMore.value = false
        }
        loading.value = false
        if (reset && messageList.value.length > 0) {
            nextTick(() => {
                scrollToBottom()
            })
        }
    }

    const scrollToBottom = () => {
        if (messageList.value.length == 0) return
        scrollToId.value = 'msg-' + (messageList.value.length - 1)
    }

    const onSend = () => {
        const text = inputText.value.trim()
        if (text.length == 0) {
            uni.showToast({ title: '请输入消息', icon: 'none' })
            return
        }
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }

        const newMsg: Message = {
            id: messageList.value.length + 1,
            session_id: sessionId.value,
            sender_id: state.userInfo != null ? state.userInfo.userId : 0,
            content: text,
            type: 'text',
            is_mine: true,
            created_at: formatNow()
        } as Message
        messageList.value.push(newMsg)

        const key = 'pinche_messages_' + sessionId.value
        uni.setStorageSync(key, messageList.value)

        // 同步会话列表
        updateSessionList(text)

        inputText.value = ''
        nextTick(() => {
            scrollToBottom()
        })

        // 触发浏览量上报
        if (pincheId.value > 0) {
            const data: UTSJSONObject = { pinche_id: pincheId.value } as UTSJSONObject
            recordPincheView(data).catch(() => {})
        }
    }

    const updateSessionList = (lastMsg: string) => {
        const sessKey = 'pinche_sessions'
        const data = uni.getStorageSync(sessKey) as UTSJSONObject[]
        let list: UTSJSONObject[] = []
        if (data instanceof Array) list = data as UTSJSONObject[]
        let found = false
        for (let i = 0; i < list.length; i++) {
            if ((list[i]['id'] as number) == sessionId.value) {
                list[i]['last_message'] = lastMsg
                list[i]['last_time'] = formatNow()
                found = true
                break
            }
        }
        if (!found) {
            const obj: UTSJSONObject = {
                id: sessionId.value,
                pinche_id: pincheId.value,
                trip_info: '',
                peer_id: peerId.value,
                peer_name: peerName.value,
                peer_avatar: '',
                last_message: lastMsg,
                last_time: formatNow(),
                unread_count: 0
            } as UTSJSONObject
            list.unshift(obj)
        }
        uni.setStorageSync(sessKey, list)
    }

    const formatNow = () : string => {
        const d = new Date()
        const h = d.getHours().toString().padStart(2, '0')
        const m = d.getMinutes().toString().padStart(2, '0')
        return h + ':' + m
    }

    onLoad((options: OnLoadOptions) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        const sid = options['session_id']
        const pid = options['pinche_id']
        const peerIdStr = options['peer_id']
        const pn = options['peer_name']
        if (sid != null) {
            sessionId.value = parseInt(sid as string)
        }
        if (pid != null) {
            pincheId.value = parseInt(pid as string)
        }
        if (peerIdStr != null) {
            peerId.value = parseInt(peerIdStr as string)
        }
        if (pn != null) {
            peerName.value = decodeURIComponent(pn as string)
        }
        if (sessionId.value == 0) {
            sessionId.value = pincheId.value * 1000 + peerId.value
        }
        uni.setNavigationBarTitle({ title: peerName.value })
        loadMessages(true)
    })

    onShow(() => {
        if (sessionId.value > 0) {
            loadMessages(true)
        }
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .msg-list {
        flex: 1;
        padding: 8px 12px;
    }

    .msg-item {
        padding: 6px 0;
        align-items: flex-start;
    }

    .msg-bubble {
        max-width: 280px;
        padding: 8px 12px;
        border-radius: 12px;
        background-color: #FFFFFF;
    }

    .msg-bubble.mine {
        align-self: flex-end;
        background-color: #FF6B35;
    }

    .msg-bubble.peer {
        align-self: flex-start;
        background-color: #FFFFFF;
    }

    .msg-sender {
        font-size: 11px;
        color: #999;
        margin-bottom: 2px;
    }

    .msg-content {
        font-size: 14px;
        color: #333;
    }

    .msg-bubble.mine .msg-content {
        color: #FFFFFF;
    }

    .msg-time {
        font-size: 10px;
        color: #BBB;
        margin-top: 4px;
    }

    .msg-bubble.mine .msg-time {
        color: rgba(255, 255, 255, 0.7);
    }

    .input-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .msg-input {
        flex: 1;
        background-color: #F5F5F5;
        border-radius: 18px;
        padding: 8px 12px;
        font-size: 13px;
        color: #333;
    }

    .send-btn {
        background-color: #FF6B35;
        border-radius: 18px;
        padding: 8px 16px;
        margin-left: 8px;
    }

    .send-text {
        font-size: 13px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .load-more, .no-more {
        padding: 12px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .empty-msg {
        padding: 80px 0;
        align-items: center;
    }

    .empty-text {
        font-size: 13px;
        color: #999;
    }
</style>
