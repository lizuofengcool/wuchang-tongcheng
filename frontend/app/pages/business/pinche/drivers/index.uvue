<template>
    <view class="page">
        <scroll-view class="content" scroll-y>
            <view class="status-banner" v-if="driverStatus.length > 0" :class="driverStatus">
                <text class="banner-text">{{ statusText }}</text>
                <text class="banner-sub" v-if="driverStatus == 'pending'">审核中，请耐心等待</text>
                <text class="banner-sub" v-if="driverStatus == 'rejected'">请修改后重新提交</text>
            </view>

            <view class="form-card">
                <text class="card-title">身份证信息</text>
                <view class="form-row">
                    <text class="label">真实姓名<text class="required">*</text></text>
                    <input class="input" v-model="form.real_name" placeholder="请输入真实姓名" />
                </view>
                <view class="form-row">
                    <text class="label">身份证号<text class="required">*</text></text>
                    <input class="input" v-model="form.id_card" placeholder="请输入身份证号" />
                </view>
                <view class="form-row column">
                    <text class="label">身份证照片</text>
                    <view class="image-row">
                        <view class="image-box" @click="uploadImage('id_card_front')">
                            <image class="id-image" :src="form.id_card_front" mode="aspectFill" v-if="form.id_card_front.length > 0" />
                            <text class="placeholder-text" v-else>+ 正面</text>
                        </view>
                        <view class="image-box" @click="uploadImage('id_card_back')">
                            <image class="id-image" :src="form.id_card_back" mode="aspectFill" v-if="form.id_card_back.length > 0" />
                            <text class="placeholder-text" v-else>+ 反面</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="form-card">
                <text class="card-title">驾驶证信息</text>
                <view class="form-row">
                    <text class="label">驾驶证号<text class="required">*</text></text>
                    <input class="input" v-model="form.license_no" placeholder="请输入驾驶证号" />
                </view>
                <view class="form-row">
                    <text class="label">准驾车型</text>
                    <input class="input" v-model="form.license_type" placeholder="如 C1" />
                </view>
                <view class="form-row column">
                    <text class="label">驾驶证照片</text>
                    <view class="image-row">
                        <view class="image-box" @click="uploadImage('license_front')">
                            <image class="id-image" :src="form.license_front" mode="aspectFill" v-if="form.license_front.length > 0" />
                            <text class="placeholder-text" v-else>+ 正面</text>
                        </view>
                        <view class="image-box" @click="uploadImage('license_back')">
                            <image class="id-image" :src="form.license_back" mode="aspectFill" v-if="form.license_back.length > 0" />
                            <text class="placeholder-text" v-else>+ 反面</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="form-card">
                <text class="card-title">车辆信息</text>
                <view class="form-row">
                    <text class="label">车型<text class="required">*</text></text>
                    <input class="input" v-model="form.vehicle_model" placeholder="如 大众朗逸" />
                </view>
                <view class="form-row">
                    <text class="label">车牌号<text class="required">*</text></text>
                    <input class="input" v-model="form.vehicle_plate" placeholder="如 鄂A12345" />
                </view>
                <view class="form-row">
                    <text class="label">座位数<text class="required">*</text></text>
                    <input class="input" type="number" v-model="form.vehicle_seats" placeholder="如 5" />
                </view>
                <view class="form-row">
                    <text class="label">颜色</text>
                    <input class="input" v-model="form.vehicle_color" placeholder="如 白色" />
                </view>
                <view class="form-row column">
                    <text class="label">行驶证照片</text>
                    <view class="image-row">
                        <view class="image-box" @click="uploadImage('vehicle_license')">
                            <image class="id-image" :src="form.vehicle_license" mode="aspectFill" v-if="form.vehicle_license.length > 0" />
                            <text class="placeholder-text" v-else>+ 行驶证</text>
                        </view>
                        <view class="image-box" @click="uploadImage('vehicle_photo')">
                            <image class="id-image" :src="form.vehicle_photo" mode="aspectFill" v-if="form.vehicle_photo.length > 0" />
                            <text class="placeholder-text" v-else>+ 车辆照片</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="form-card">
                <text class="card-title">联系方式</text>
                <view class="form-row">
                    <text class="label">手机号<text class="required">*</text></text>
                    <input class="input" v-model="form.phone" placeholder="请输入手机号" />
                </view>
                <view class="form-row">
                    <text class="label">紧急联系人</text>
                    <input class="input" v-model="form.emergency_contact" placeholder="请输入紧急联系人电话" />
                </view>
            </view>
        </scroll-view>
        <view class="bottom-bar">
            <view class="btn-submit" @click="onSubmit">
                <text class="btn-text-white">{{ driverStatus == 'approved' ? '更新信息' : '提交认证' }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { createDriver, getMyDriver, updateDriver, createVehicle } from '@/api/business/pinche.uts'

    type Form = {
        id: number
        real_name: string
        id_card: string
        id_card_front: string
        id_card_back: string
        license_no: string
        license_type: string
        license_front: string
        license_back: string
        vehicle_model: string
        vehicle_plate: string
        vehicle_seats: string
        vehicle_color: string
        vehicle_license: string
        vehicle_photo: string
        phone: string
        emergency_contact: string
    }

    const form = ref({
        id: 0,
        real_name: '',
        id_card: '',
        id_card_front: '',
        id_card_back: '',
        license_no: '',
        license_type: '',
        license_front: '',
        license_back: '',
        vehicle_model: '',
        vehicle_plate: '',
        vehicle_seats: '',
        vehicle_color: '',
        vehicle_license: '',
        vehicle_photo: '',
        phone: '',
        emergency_contact: ''
    } as Form)

    const driverStatus = ref('')

    const statusText = computed(() : string => {
        const s = driverStatus.value
        if (s == 'pending') return '⏳ 审核中'
        if (s == 'approved') return '✓ 已通过认证'
        if (s == 'rejected') return '✗ 认证未通过'
        if (s == 'frozen') return '🔒 账号已冻结'
        return s
    })

    const uploadImage = (field: string) => {
        uni.chooseImage({
            count: 1,
            success: (res) => {
                if (res.tempFilePaths.length > 0) {
                    const path = res.tempFilePaths[0]
                    uni.uploadFile({
                        url: 'http://localhost:8088/api/v1/upload',
                        filePath: path,
                        name: 'file',
                        success: (r) => {
                            try {
                                const data = JSON.parse(r.data) as UTSJSONObject
                                const url = (data['url'] as string) ?? ''
                                if (url.length > 0) {
                                    setFormField(field, url)
                                    uni.showToast({ title: '上传成功', icon: 'success' })
                                }
                            } catch (e) {
                                uni.showToast({ title: '上传失败', icon: 'none' })
                            }
                        }
                    })
                }
            }
        })
    }

    const setFormField = (field: string, value: string) => {
        if (field == 'id_card_front') form.value.id_card_front = value
        else if (field == 'id_card_back') form.value.id_card_back = value
        else if (field == 'license_front') form.value.license_front = value
        else if (field == 'license_back') form.value.license_back = value
        else if (field == 'vehicle_license') form.value.vehicle_license = value
        else if (field == 'vehicle_photo') form.value.vehicle_photo = value
    }

    const onSubmit = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        if (form.value.real_name.length == 0) {
            uni.showToast({ title: '请输入真实姓名', icon: 'none' })
            return
        }
        if (form.value.id_card.length == 0) {
            uni.showToast({ title: '请输入身份证号', icon: 'none' })
            return
        }
        if (form.value.license_no.length == 0) {
            uni.showToast({ title: '请输入驾驶证号', icon: 'none' })
            return
        }
        if (form.value.vehicle_model.length == 0) {
            uni.showToast({ title: '请输入车型', icon: 'none' })
            return
        }
        if (form.value.vehicle_plate.length == 0) {
            uni.showToast({ title: '请输入车牌号', icon: 'none' })
            return
        }
        if (form.value.phone.length == 0) {
            uni.showToast({ title: '请输入手机号', icon: 'none' })
            return
        }

        const data: UTSJSONObject = {
            real_name: form.value.real_name,
            id_card: form.value.id_card,
            id_card_front: form.value.id_card_front,
            id_card_back: form.value.id_card_back,
            license_no: form.value.license_no,
            license_type: form.value.license_type,
            license_front: form.value.license_front,
            license_back: form.value.license_back,
            phone: form.value.phone,
            emergency_contact: form.value.emergency_contact,
            vehicle_model: form.value.vehicle_model,
            vehicle_plate: form.value.vehicle_plate,
            vehicle_seats: parseInt(form.value.vehicle_seats),
            vehicle_color: form.value.vehicle_color,
            vehicle_license: form.value.vehicle_license,
            vehicle_photo: form.value.vehicle_photo
        } as UTSJSONObject

        uni.showLoading({ title: '提交中...' })
        const reqFn = form.value.id > 0 ? updateDriver(form.value.id, data) : createDriver(data)
        reqFn.then((res: ApiResult) => {
            uni.hideLoading()
            if (res.code == 200) {
                if (form.value.id == 0) {
                    const vehicleData: UTSJSONObject = {
                        model: form.value.vehicle_model,
                        license_plate: form.value.vehicle_plate,
                        seats: parseInt(form.value.vehicle_seats),
                        color: form.value.vehicle_color,
                        license_image: form.value.vehicle_license,
                        photo: form.value.vehicle_photo
                    } as UTSJSONObject
                    createVehicle(vehicleData).catch(() => {})
                }
                uni.showToast({ title: '提交成功', icon: 'success' })
                setTimeout(() => {
                    uni.navigateBack()
                }, 1000)
            } else {
                uni.showToast({ title: res.message || '提交失败', icon: 'none' })
            }
        }).catch(() => {
            uni.hideLoading()
        })
    }

    const loadDriver = () => {
        getMyDriver().then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                form.value = {
                    id: (d['id'] as number) ?? 0,
                    real_name: (d['real_name'] as string) ?? '',
                    id_card: (d['id_card'] as string) ?? '',
                    id_card_front: (d['id_card_front'] as string) ?? '',
                    id_card_back: (d['id_card_back'] as string) ?? '',
                    license_no: (d['license_no'] as string) ?? '',
                    license_type: (d['license_type'] as string) ?? '',
                    license_front: (d['license_front'] as string) ?? '',
                    license_back: (d['license_back'] as string) ?? '',
                    vehicle_model: (d['vehicle_model'] as string) ?? '',
                    vehicle_plate: (d['vehicle_plate'] as string) ?? '',
                    vehicle_seats: ((d['vehicle_seats'] as number) ?? 0).toString(),
                    vehicle_color: (d['vehicle_color'] as string) ?? '',
                    vehicle_license: (d['vehicle_license'] as string) ?? '',
                    vehicle_photo: (d['vehicle_photo'] as string) ?? '',
                    phone: (d['phone'] as string) ?? '',
                    emergency_contact: (d['emergency_contact'] as string) ?? ''
                } as Form
                driverStatus.value = (d['status'] as string) ?? ''
            }
        })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadDriver()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
        padding: 12px;
    }

    .status-banner {
        background-color: #FFF5E5;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 12px;
    }

    .status-banner.approved {
        background-color: #E5F8FF;
    }

    .status-banner.rejected {
        background-color: #FFE5E5;
    }

    .status-banner.frozen {
        background-color: #F0F0F0;
    }

    .banner-text {
        font-size: 15px;
        color: #FF9900;
        font-weight: 600;
    }

    .status-banner.approved .banner-text {
        color: #1989FA;
    }

    .status-banner.rejected .banner-text {
        color: #EE0A24;
    }

    .banner-sub {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
    }

    .form-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 12px;
    }

    .card-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-row {
        flex-direction: row;
        align-items: center;
        padding: 10px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .form-row.column {
        flex-direction: column;
        align-items: stretch;
    }

    .label {
        font-size: 13px;
        color: #666;
        width: 100px;
    }

    .required {
        color: #EE0A24;
    }

    .input {
        flex: 1;
        font-size: 14px;
        color: #333;
    }

    .image-row {
        flex-direction: row;
        margin-top: 8px;
    }

    .image-box {
        width: 130px;
        height: 80px;
        background-color: #F5F5F5;
        border-radius: 8px;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
        border-width: 1px;
        border-color: #E5E5E5;
        border-style: dashed;
    }

    .id-image {
        width: 130px;
        height: 80px;
        border-radius: 8px;
    }

    .placeholder-text {
        font-size: 13px;
        color: #CCC;
    }

    .bottom-bar {
        background-color: #FFFFFF;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .btn-submit {
        height: 44px;
        border-radius: 22px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .btn-text-white {
        font-size: 15px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
