<template>
    <view class="page">
        <view class="search-bar" @click="goSearch">
            <text class="search-icon">🔍</text>
            <text class="search-placeholder">搜索起点/终点/车主</text>
        </view>
        <pinche-filter :items="filterItems" :active-key="activeFilterKey" :panel-visible="showFilterPanel" :selected="selectedFilters" @tap="onTapFilter" />
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="sort-bar">
                <text class="sort-text" :class="{ active: currentSort == 'latest' }" @click="changeSort('latest')">最新</text>
                <text class="sort-text" :class="{ active: currentSort == 'price_low' }" @click="changeSort('price_low')">价格低</text>
                <text class="sort-text" :class="{ active: currentSort == 'price_high' }" @click="changeSort('price_high')">价格高</text>
                <text class="sort-text" :class="{ active: currentSort == 'nearby' }" @click="changeSort('nearby')">附近</text>
            </view>
            <view class="list-wrap">
                <pinche-card v-for="item in list" :key="item.id" :pinche="transformPinche(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <pinche-empty v-if="list.length == 0 && !loading" icon="🚗" text="暂无行程" btn-text="去发布" @click="goPublish" />
        </scroll-view>
        <view class="fab" @click="goPublish">
            <text class="fab-text">+ 发布</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { listPinches, listNearbyPinches } from '@/api/business/pinche.uts'

    type ListItem = {
        id: number
        origin: string
        destination: string
        departure_time: string
        price: number
        seats_available: number
        vehicle_model: string
        driver_name: string
        driver_avatar: string
        driver_rating: number
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_verified: boolean
    }
    type PincheCardData = {
        id: number
        origin: string
        destination: string
        departure_time: string
        price: number
        seats_available: number
        vehicle_model: string
        driver_name: string
        driver_avatar: string
        driver_rating: number
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_verified: boolean
    }
    type FilterItem = { key: string, label: string, options: string[] }

    const filterItems = [
        { key: 'city', label: '城市', options: [] as string[] },
        { key: 'seats', label: '座位', options: [] as string[] },
        { key: 'price', label: '价格', options: [] as string[] },
        { key: 'time', label: '时间', options: [] as string[] }
    ] as FilterItem[]

    const activeFilterKey = ref('')
    const showFilterPanel = ref(false)
    const selectedFilters = ref({} as UTSJSONObject)
    const currentSort = ref('latest')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformPinche = (item: ListItem) : PincheCardData => {
        return {
            id: item.id,
            origin: item.origin,
            destination: item.destination,
            departure_time: item.departure_time,
            price: item.price,
            seats_available: item.seats_available,
            vehicle_model: item.vehicle_model,
            driver_name: item.driver_name,
            driver_avatar: item.driver_avatar,
            driver_rating: item.driver_rating,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_verified: item.is_verified
        } as PincheCardData
    }

    const onTapFilter = (key: string) => {
        if (activeFilterKey.value == key && showFilterPanel.value) {
            showFilterPanel.value = false
            activeFilterKey.value = ''
        } else {
            activeFilterKey.value = key
            showFilterPanel.value = true
            let itemList = [] as string[]
            if (key == 'seats') {
                itemList = ['全部', '1座', '2座', '3座', '4座及以上']
            } else if (key == 'price') {
                itemList = ['全部', '50元以下', '50-100元', '100-200元', '200元以上']
            } else if (key == 'time') {
                itemList = ['全部', '今天', '明天', '本周', '本月']
            } else {
                itemList = ['全部', '今天', '明天', '本周']
            }
            uni.showActionSheet({
                itemList: itemList,
                success: (res) => {
                    selectedFilters.value[key] = itemList[res.tapIndex]
                    if (selectedFilters.value[key] == '全部') selectedFilters.value[key] = ''
                    showFilterPanel.value = false
                    activeFilterKey.value = ''
                    loadList(true)
                }
            })
        }
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value
        } as UTSJSONObject
        const keys = Object.keys(selectedFilters.value)
        for (let i = 0; i < keys.length; i++) {
            const k = keys[i]
            const v = (selectedFilters.value[k] as string) ?? ''
            if (v.length > 0) params[k] = v
        }

        const useNearby = currentSort.value == 'nearby'
        const reqFn = useNearby ? listNearbyPinches(params) : listPinches(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/pinche/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/pinche/search/index' })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/pinche/publish/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        margin: 8px 12px;
        padding: 8px 12px;
        border-radius: 20px;
        background-color: #F5F5F5;
    }

    .search-icon {
        font-size: 14px;
        color: #999;
        margin-right: 6px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
    }

    .list-scroll {
        flex: 1;
    }

    .sort-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .sort-text {
        flex: 1;
        font-size: 13px;
        color: #666;
        text-align: center;
    }

    .sort-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }

    .fab {
        position: absolute;
        bottom: 24px;
        right: 16px;
        background-color: #FF6B35;
        border-radius: 24px;
        padding: 12px 20px;
        box-shadow: 0 2px 8px rgba(255, 107, 53, 0.4);
    }

    .fab-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
