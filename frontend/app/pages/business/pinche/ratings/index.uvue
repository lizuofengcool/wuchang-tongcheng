<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view v-if="currentTab == 0">
                <view class="form-card">
                    <text class="card-title">评价行程</text>
                    <view class="rate-row">
                        <text class="rate-label">总体评分</text>
                        <view class="star-row">
                            <text class="star" v-for="(s, idx) in 5" :key="idx" :class="{ active: form.rating > idx }" @click="form.rating = idx + 1">★</text>
                        </view>
                    </view>
                    <view class="rate-row">
                        <text class="rate-label">车主服务</text>
                        <view class="star-row">
                            <text class="star" v-for="(s, idx) in 5" :key="idx" :class="{ active: form.service_rating > idx }" @click="form.service_rating = idx + 1">★</text>
                        </view>
                    </view>
                    <view class="rate-row">
                        <text class="rate-label">车辆状况</text>
                        <view class="star-row">
                            <text class="star" v-for="(s, idx) in 5" :key="idx" :class="{ active: form.vehicle_rating > idx }" @click="form.vehicle_rating = idx + 1">★</text>
                        </view>
                    </view>
                    <view class="rate-row">
                        <text class="rate-label">准时程度</text>
                        <view class="star-row">
                            <text class="star" v-for="(s, idx) in 5" :key="idx" :class="{ active: form.punctuality_rating > idx }" @click="form.punctuality_rating = idx + 1">★</text>
                        </view>
                    </view>
                    <view class="form-row column">
                        <text class="label">评价内容</text>
                        <textarea class="textarea" v-model="form.content" placeholder="说说本次行程的感受..." />
                    </view>
                    <view class="tag-row">
                        <text class="tag-label">快速标签</text>
                        <view class="tag-wrap">
                            <view class="tag" v-for="(t, idx) in quickTags" :key="idx" :class="{ active: form.tags.includes(t) }" @click="toggleTag(t)">
                                <text class="tag-text" :class="{ active: form.tags.includes(t) }">{{ t }}</text>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="submit-btn" @click="onSubmit">
                    <text class="submit-text">提交评价</text>
                </view>
            </view>
            <view v-else>
                <view class="stats-card" v-if="stats.total > 0">
                    <view class="stat-item">
                        <text class="stat-num">{{ stats.avg_rating }}</text>
                        <text class="stat-label">平均评分</text>
                    </view>
                    <view class="stat-item">
                        <text class="stat-num">{{ stats.total }}</text>
                        <text class="stat-label">总评价数</text>
                    </view>
                    <view class="stat-item">
                        <text class="stat-num">{{ stats.good_rate }}%</text>
                        <text class="stat-label">好评率</text>
                    </view>
                </view>
                <view class="rating-list">
                    <view class="rating-item" v-for="(item, idx) in ratingList" :key="idx">
                        <view class="rating-header">
                            <image class="avatar" :src="item.rater_avatar" mode="aspectFill" lazy-load="true" v-if="item.rater_avatar.length > 0" />
                            <view class="avatar-placeholder" v-else>
                                <text class="avatar-text">{{ item.rater_name.length > 0 ? item.rater_name.charAt(0) : 'U' }}</text>
                            </view>
                            <view class="rater-info">
                                <text class="rater-name">{{ item.rater_name }}</text>
                                <view class="star-row">
                                    <text class="star small" v-for="(s, idx2) in 5" :key="idx2" :class="{ active: item.rating > idx2 }">★</text>
                                </view>
                            </view>
                            <text class="rating-time">{{ item.created_at }}</text>
                        </view>
                        <text class="rating-content" v-if="item.content.length > 0">{{ item.content }}</text>
                        <view class="rating-tags" v-if="item.tags.length > 0">
                            <view class="rating-tag" v-for="(t, idx2) in item.tags" :key="idx2">
                                <text class="rating-tag-text">{{ t }}</text>
                            </view>
                        </view>
                        <view class="rating-actions">
                            <text class="action-like" @click="onLike(item.id)">👍 {{ item.like_count }}</text>
                            <text class="action-reply" @click="onReply(item.id)">回复</text>
                        </view>
                        <view class="reply-box" v-if="item.reply.length > 0">
                            <text class="reply-text">车主回复：{{ item.reply }}</text>
                        </view>
                    </view>
                </view>
                <view class="load-more" v-if="loading">
                    <text class="load-text">加载中...</text>
                </view>
                <view class="no-more" v-if="!hasMore && ratingList.length > 0">
                    <text class="no-more-text">已经到底啦~</text>
                </view>
                <pinche-empty v-if="ratingList.length == 0 && !loading" icon="⭐" text="暂无评价" btn-text="去评价" @click="switchTab(0)" />
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { createRating, listRatings, likeRating, replyRating, listRatingsByPinche } from '@/api/business/pinche.uts'

    type Tab = { key: string, name: string }
    type Form = {
        pinche_id: number
        booking_id: number
        rating: number
        service_rating: number
        vehicle_rating: number
        punctuality_rating: number
        content: string
        tags: string[]
    }
    type RatingItem = {
        id: number
        rater_name: string
        rater_avatar: string
        rating: number
        content: string
        tags: string[]
        reply: string
        like_count: number
        created_at: string
    }
    type Stats = {
        avg_rating: number
        total: number
        good_rate: number
    }

    const tabs = ref([
        { key: 'form', name: '写评价' },
        { key: 'list', name: '看评价' }
    ] as Tab[])
    const currentTab = ref(0)
    const form = ref({
        pinche_id: 0,
        booking_id: 0,
        rating: 5,
        service_rating: 5,
        vehicle_rating: 5,
        punctuality_rating: 5,
        content: '',
        tags: [] as string[]
    } as Form)
    const quickTags = ['驾驶平稳', '车辆整洁', '准时到达', '态度友好', '路线熟悉', '价格合理', '响应迅速', '安全可靠']
    const ratingList = ref([] as RatingItem[])
    const stats = ref({ avg_rating: 0, total: 0, good_rate: 0 } as Stats)
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const toggleTag = (t: string) => {
        const idx = form.value.tags.indexOf(t)
        if (idx >= 0) {
            form.value.tags.splice(idx, 1)
        } else {
            form.value.tags.push(t)
        }
    }

    const onSubmit = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        if (form.value.rating == 0) {
            uni.showToast({ title: '请选择总体评分', icon: 'none' })
            return
        }
        if (form.value.content.length == 0 && form.value.tags.length == 0) {
            uni.showToast({ title: '请填写评价内容或选择标签', icon: 'none' })
            return
        }

        const data: UTSJSONObject = {
            pinche_id: form.value.pinche_id,
            booking_id: form.value.booking_id,
            rating: form.value.rating,
            service_rating: form.value.service_rating,
            vehicle_rating: form.value.vehicle_rating,
            punctuality_rating: form.value.punctuality_rating,
            content: form.value.content,
            tags: form.value.tags
        } as UTSJSONObject

        uni.showLoading({ title: '提交中...' })
        createRating(data).then((res: ApiResult) => {
            uni.hideLoading()
            if (res.code == 200) {
                uni.showToast({ title: '评价成功', icon: 'success' })
                form.value = {
                    pinche_id: form.value.pinche_id,
                    booking_id: form.value.booking_id,
                    rating: 5,
                    service_rating: 5,
                    vehicle_rating: 5,
                    punctuality_rating: 5,
                    content: '',
                    tags: [] as string[]
                } as Form
                setTimeout(() => {
                    currentTab.value = 1
                    loadRatingList(true)
                }, 1000)
            } else {
                uni.showToast({ title: res.message || '评价失败', icon: 'none' })
            }
        }).catch(() => {
            uni.hideLoading()
        })
    }

    const loadRatingList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        if (form.value.pinche_id > 0) {
            params['pinche_id'] = form.value.pinche_id
        }

        const reqFn = form.value.pinche_id > 0 ? listRatingsByPinche(form.value.pinche_id) : listRatings(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as RatingItem[]) ?? ([] as RatingItem[])
                if (reset) {
                    ratingList.value = newList
                } else {
                    ratingList.value = ratingList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
                const s = (d['stats'] as UTSJSONObject)
                if (s != null) {
                    stats.value = {
                        avg_rating: (s['avg_rating'] as number) ?? 0,
                        total: (s['total'] as number) ?? 0,
                        good_rate: (s['good_rate'] as number) ?? 0
                    } as Stats
                }
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadRatingList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        if (idx == 1) {
            loadRatingList(true)
        }
    }

    const onLike = (id: number) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        likeRating(id).then((res: ApiResult) => {
            if (res.code == 200) {
                uni.showToast({ title: '已点赞', icon: 'success' })
                loadRatingList(true)
            }
        })
    }

    const onReply = (id: number) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        uni.showModal({
            title: '回复评价',
            editable: true,
            placeholderText: '请输入回复内容',
            success: (res) => {
                if (res.confirm && res.content.length > 0) {
                    const data: UTSJSONObject = { content: res.content } as UTSJSONObject
                    replyRating(id, data).then((r: ApiResult) => {
                        if (r.code == 200) {
                            uni.showToast({ title: '回复成功', icon: 'success' })
                            loadRatingList(true)
                        } else {
                            uni.showToast({ title: r.message || '回复失败', icon: 'none' })
                        }
                    })
                }
            }
        })
    }

    onLoad((options: OnLoadOptions) => {
        const pid = options['pinche_id']
        const bid = options['booking_id']
        if (pid != null) {
            form.value.pinche_id = parseInt(pid as string)
        }
        if (bid != null) {
            form.value.booking_id = parseInt(bid as string)
        }
        if (form.value.pinche_id > 0) {
            loadRatingList(true)
        }
    })

    onPullDownRefresh(() => {
        if (currentTab.value == 1) {
            loadRatingList(true)
        } else {
            uni.stopPullDownRefresh()
        }
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .form-card {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin: 12px;
        border-radius: 12px;
    }

    .card-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .rate-row {
        flex-direction: row;
        align-items: center;
        padding: 8px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .rate-label {
        font-size: 13px;
        color: #666;
        width: 100px;
    }

    .star-row {
        flex-direction: row;
    }

    .star {
        font-size: 22px;
        color: #DDD;
        margin-right: 4px;
    }

    .star.active {
        color: #FF6B35;
    }

    .star.small {
        font-size: 14px;
    }

    .form-row {
        flex-direction: row;
        align-items: center;
        padding: 10px 0;
    }

    .form-row.column {
        flex-direction: column;
        align-items: stretch;
    }

    .label {
        font-size: 13px;
        color: #666;
        margin-bottom: 8px;
    }

    .textarea {
        font-size: 14px;
        color: #333;
        height: 100px;
        padding: 8px;
        background-color: #F9F9F9;
        border-radius: 8px;
    }

    .tag-row {
        padding: 10px 0;
    }

    .tag-label {
        font-size: 13px;
        color: #666;
        margin-bottom: 8px;
    }

    .tag-wrap {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .tag {
        background-color: #F5F5F5;
        border-radius: 14px;
        padding: 4px 12px;
        margin-right: 8px;
        margin-top: 8px;
        border-width: 1px;
        border-color: #F5F5F5;
    }

    .tag.active {
        background-color: #FFF5F0;
        border-color: #FF6B35;
    }

    .tag-text {
        font-size: 12px;
        color: #666;
    }

    .tag-text.active {
        color: #FF6B35;
    }

    .submit-btn {
        background-color: #FF6B35;
        border-radius: 22px;
        padding: 12px 0;
        margin: 12px;
        align-items: center;
        justify-content: center;
    }

    .submit-text {
        font-size: 15px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .stats-card {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 16px 12px;
        margin: 12px;
        border-radius: 12px;
    }

    .stat-item {
        flex: 1;
        align-items: center;
    }

    .stat-num {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .stat-label {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
    }

    .rating-list {
        padding: 0 12px 12px 12px;
    }

    .rating-item {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .rating-header {
        flex-direction: row;
        align-items: center;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        margin-right: 8px;
    }

    .avatar-placeholder {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
    }

    .avatar-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .rater-info {
        flex: 1;
    }

    .rater-name {
        font-size: 14px;
        color: #333;
        font-weight: 500;
    }

    .rating-time {
        font-size: 11px;
        color: #BBB;
    }

    .rating-content {
        font-size: 13px;
        color: #333;
        line-height: 1.6;
        margin-top: 8px;
    }

    .rating-tags {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .rating-tag {
        background-color: #FFF5F0;
        border-radius: 3px;
        padding: 2px 6px;
        margin-right: 4px;
        margin-top: 4px;
    }

    .rating-tag-text {
        font-size: 11px;
        color: #FF6B35;
    }

    .rating-actions {
        flex-direction: row;
        margin-top: 8px;
        padding-top: 8px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .action-like, .action-reply {
        font-size: 12px;
        color: #666;
        margin-right: 16px;
    }

    .reply-box {
        background-color: #F9F9F9;
        border-radius: 6px;
        padding: 8px;
        margin-top: 8px;
    }

    .reply-text {
        font-size: 12px;
        color: #666;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
