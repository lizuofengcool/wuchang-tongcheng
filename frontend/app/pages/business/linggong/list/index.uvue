<template>
    <view class="page">
        <view class="search-bar" @click="goSearch">
            <text class="search-icon">🔍</text>
            <text class="search-placeholder">搜索兼职/工种/地点</text>
        </view>
        <linggong-filter :items="filterItems" :active-key="activeFilterKey" :panel-visible="showFilterPanel" :selected="selectedFilters" @tap="onTapFilter" />
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="sort-bar">
                <text class="sort-text" :class="{ active: currentSort == 'popular' }" @click="changeSort('popular')">综合</text>
                <text class="sort-text" :class="{ active: currentSort == 'latest' }" @click="changeSort('latest')">最新</text>
                <text class="sort-text" :class="{ active: currentSort == 'salary' }" @click="changeSort('salary')">薪资</text>
                <text class="sort-text" :class="{ active: currentSort == 'nearby' }" @click="changeSort('nearby')">附近</text>
            </view>
            <view class="list-wrap">
                <linggong-card v-for="item in list" :key="item.id" :linggong="transformItem(item)" @click="goDetail" />
            </view>
            <linggong-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <linggong-empty v-if="list.length == 0 && !loading" icon="📋" text="暂无兼职岗位" btn-text="去发布" @click="goPublish" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { listLinggongs, listNearbyLinggongs } from '@/api/business/linggong.uts'

    type ListItem = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
        view_count: number
        fav_count: number
        application_count: number
    }
    type CardData = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
    }
    type FilterItem = { key: string, label: string, options: string[] }

    const filterItems = [
        { key: 'city', label: '地点', options: [] as string[] },
        { key: 'work_type', label: '工种', options: [] as string[] },
        { key: 'salary', label: '薪资', options: [] as string[] },
        { key: 'duration', label: '时长', options: [] as string[] }
    ] as FilterItem[]

    const activeFilterKey = ref('')
    const showFilterPanel = ref(false)
    const selectedFilters = ref({} as UTSJSONObject)
    const currentSort = ref('popular')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformItem = (item: ListItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            salary_range: item.salary_range,
            city: item.city,
            work_type: item.work_type,
            duration: item.duration,
            employer_id: item.employer_id,
            employer_name: item.employer_name,
            employer_logo: item.employer_logo,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_remote: item.is_remote
        } as CardData
    }

    const onTapFilter = (key: string) => {
        if (activeFilterKey.value == key && showFilterPanel.value) {
            showFilterPanel.value = false
            activeFilterKey.value = ''
        } else {
            activeFilterKey.value = key
            showFilterPanel.value = true
            let itemList = [] as string[]
            if (key == 'city') itemList = ['全部', '武昌区', '洪山区', '江岸区', '硚口区', '汉阳区', '青山区']
            else if (key == 'work_type') itemList = ['全部', '派发', '服务员', '促销', '家教', '搬运', '配送', '其他']
            else if (key == 'salary') itemList = ['全部', '100以下', '100-200', '200-400', '400-800', '800以上']
            else if (key == 'duration') itemList = ['全部', '短期', '周末', '日结', '周结', '月结']
            else itemList = ['全部']
            uni.showActionSheet({
                itemList: itemList,
                success: (res) => {
                    selectedFilters.value[key] = itemList[res.tapIndex]
                    if (selectedFilters.value[key] == '全部') selectedFilters.value[key] = ''
                    showFilterPanel.value = false
                    activeFilterKey.value = ''
                    loadList(true)
                },
                fail: () => {
                    showFilterPanel.value = false
                    activeFilterKey.value = ''
                }
            })
        }
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value
        } as UTSJSONObject
        const keys = Object.keys(selectedFilters.value)
        for (let i = 0; i < keys.length; i++) {
            const k = keys[i]
            const v = (selectedFilters.value[k] as string) ?? ''
            if (v.length > 0) params[k] = v
        }

        const useNearby = currentSort.value == 'nearby'
        const reqFn = useNearby ? listNearbyLinggongs(params) : listLinggongs(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/linggong/search/index' })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/linggong/publish/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        margin: 8px 12px;
        padding: 8px 12px;
        border-radius: 20px;
        background-color: #F5F5F5;
    }

    .search-icon {
        font-size: 14px;
        color: #999;
        margin-right: 6px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
    }

    .list-scroll {
        flex: 1;
    }

    .sort-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .sort-text {
        flex: 1;
        font-size: 13px;
        color: #666;
        text-align: center;
    }

    .sort-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
