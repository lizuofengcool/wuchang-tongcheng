<template>
    <view class="page">
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <linggong-card v-for="item in favList" :key="item.id" :linggong="transformItem(item)" @click="goDetail" />
            </view>
            <linggong-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && favList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <linggong-empty v-if="favList.length == 0 && !loading" icon="★" text="暂无收藏兼职" btn-text="去找兼职" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listLinggongs } from '@/api/business/linggong.uts'

    type FavItem = {
        id: number
        linggong_id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
        view_count: number
        fav_count: number
        application_count: number
        fav_time: string
    }
    type CardData = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
    }

    const favList = ref([] as FavItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformItem = (item: FavItem) : CardData => {
        return {
            id: item.linggong_id > 0 ? item.linggong_id : item.id,
            title: item.title,
            salary_range: item.salary_range,
            city: item.city,
            work_type: item.work_type,
            duration: item.duration,
            employer_id: item.employer_id,
            employer_name: item.employer_name,
            employer_logo: item.employer_logo,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_remote: item.is_remote
        } as CardData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            fav_only: true
        } as UTSJSONObject

        listLinggongs(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as FavItem[]) ?? ([] as FavItem[])
                if (reset) {
                    favList.value = newList
                } else {
                    favList.value = favList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/detail/index?id=' + id })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/linggong/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
