<template>
    <view class="page">
        <scroll-view class="content" scroll-y>
            <view class="image-banner" v-if="detail.cover_image.length > 0">
                <image class="banner-img" :src="detail.cover_image" mode="aspectFill" lazy-load="true" />
            </view>
            <view class="header-card">
                <view class="title-row">
                    <text class="title">{{ detail.title }}</text>
                </view>
                <text class="salary">{{ detail.salary_range }}</text>
                <view class="meta-row">
                    <text class="meta">{{ detail.city }}</text>
                    <text class="meta-dot">·</text>
                    <text class="meta">{{ detail.work_type }}</text>
                    <text class="meta-dot" v-if="detail.duration.length > 0">·</text>
                    <text class="meta" v-if="detail.duration.length > 0">{{ detail.duration }}</text>
                </view>
                <view class="tag-row" v-if="tags.length > 0">
                    <view class="tag" v-for="(t, idx) in tags" :key="idx" :class="t.type">
                        <text class="tag-text">{{ t.text }}</text>
                    </view>
                </view>
                <view class="stats-row">
                    <text class="stat">{{ detail.view_count }}浏览</text>
                    <text class="stat-dot">·</text>
                    <text class="stat">{{ detail.application_count }}报名</text>
                    <text class="stat-dot">·</text>
                    <text class="stat">{{ detail.fav_count }}收藏</text>
                </view>
            </view>

            <view class="section" v-if="detail.description.length > 0">
                <text class="section-title">岗位描述</text>
                <text class="section-content">{{ detail.description }}</text>
            </view>
            <view class="section" v-if="detail.requirements.length > 0">
                <text class="section-title">任职要求</text>
                <text class="section-content">{{ detail.requirements }}</text>
            </view>
            <view class="section" v-if="detail.welfare.length > 0">
                <text class="section-title">福利待遇</text>
                <text class="section-content">{{ detail.welfare }}</text>
            </view>
            <view class="section" v-if="detail.address.length > 0">
                <text class="section-title">工作地址</text>
                <text class="section-content">{{ detail.address }}</text>
            </view>
            <view class="section" v-if="detail.employer_id > 0">
                <text class="section-title">雇主信息</text>
                <linggong-employer-card :employer="employerData" @click="goEmployer" />
            </view>
        </scroll-view>
        <view class="bottom-bar">
            <view class="bottom-btn icon-btn" @click="toggleFav">
                <text class="bottom-icon">{{ detail.is_faved ? '★' : '☆' }}</text>
                <text class="bottom-icon-text">{{ detail.is_faved ? '已收藏' : '收藏' }}</text>
            </view>
            <view class="bottom-btn icon-btn" @click="onShare">
                <text class="bottom-icon">↗</text>
                <text class="bottom-icon-text">分享</text>
            </view>
            <view class="bottom-btn primary-btn" @click="onApply">
                <text class="primary-btn-text">立即报名</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { getLinggongDetail, createApplication, incrLinggongView, incrLinggongShare } from '@/api/business/linggong.uts'

    type Tag = { text: string, type: string }
    type Detail = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        cover_image: string
        description: string
        requirements: string
        welfare: string
        address: string
        employer_id: number
        employer_name: string
        employer_logo: string
        employer_industry: string
        employer_size: string
        employer_is_verified: boolean
        view_count: number
        fav_count: number
        application_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
        is_faved: boolean
    }
    type EmployerData = {
        id: number
        name: string
        logo: string
        industry: string
        size: string
        city: string
        is_verified: boolean
        job_count: number
        rating_count: number
    }

    const linggongId = ref(0)
    const detail = ref({
        id: 0, title: '', salary_range: '', city: '', work_type: '', duration: '',
        cover_image: '', description: '', requirements: '', welfare: '', address: '',
        employer_id: 0, employer_name: '', employer_logo: '', employer_industry: '', employer_size: '',
        employer_is_verified: false,
        view_count: 0, fav_count: 0, application_count: 0,
        is_urgent: false, is_hot: false, is_remote: false, is_faved: false
    } as Detail)

    const tags = computed(() : Tag[] => {
        const list = [] as Tag[]
        if (detail.value.is_urgent) list.push({ text: '急招', type: 'urgent' } as Tag)
        if (detail.value.is_hot) list.push({ text: '热门', type: 'hot' } as Tag)
        if (detail.value.is_remote) list.push({ text: '远程', type: 'remote' } as Tag)
        return list
    })

    const employerData = computed(() : EmployerData => {
        return {
            id: detail.value.employer_id,
            name: detail.value.employer_name,
            logo: detail.value.employer_logo,
            industry: detail.value.employer_industry,
            size: detail.value.employer_size,
            city: detail.value.city,
            is_verified: detail.value.employer_is_verified,
            job_count: 0,
            rating_count: 0
        } as EmployerData
    })

    const loadDetail = () => {
        getLinggongDetail(linggongId.value).then((res: ApiResult) => {
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                detail.value = mapDetail(d)
            }
        })
        incrLinggongView(linggongId.value).then((_: ApiResult) => {})
    }

    const mapDetail = (d: UTSJSONObject) : Detail => {
        return {
            id: (d['id'] as number) ?? 0,
            title: (d['title'] as string) ?? '',
            salary_range: (d['salary_range'] as string) ?? '',
            city: (d['city'] as string) ?? '',
            work_type: (d['work_type'] as string) ?? '',
            duration: (d['duration'] as string) ?? '',
            cover_image: (d['cover_image'] as string) ?? '',
            description: (d['description'] as string) ?? '',
            requirements: (d['requirements'] as string) ?? '',
            welfare: (d['welfare'] as string) ?? '',
            address: (d['address'] as string) ?? '',
            employer_id: (d['employer_id'] as number) ?? 0,
            employer_name: (d['employer_name'] as string) ?? '',
            employer_logo: (d['employer_logo'] as string) ?? '',
            employer_industry: (d['employer_industry'] as string) ?? '',
            employer_size: (d['employer_size'] as string) ?? '',
            employer_is_verified: (d['employer_is_verified'] as boolean) ?? false,
            view_count: (d['view_count'] as number) ?? 0,
            fav_count: (d['fav_count'] as number) ?? 0,
            application_count: (d['application_count'] as number) ?? 0,
            is_urgent: (d['is_urgent'] as boolean) ?? false,
            is_hot: (d['is_hot'] as boolean) ?? false,
            is_remote: (d['is_remote'] as boolean) ?? false,
            is_faved: detail.value.is_faved
        } as Detail
    }

    const toggleFav = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        detail.value.is_faved = !detail.value.is_faved
        uni.showToast({
            title: detail.value.is_faved ? '收藏成功' : '已取消收藏',
            icon: 'none'
        })
    }

    const onShare = () => {
        incrLinggongShare(linggongId.value).then((_: ApiResult) => {})
        uni.showToast({ title: '已复制分享链接', icon: 'none' })
    }

    const onApply = () => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }
        uni.showModal({
            title: '立即报名',
            content: '确认报名该兼职岗位？',
            success: (res) => {
                if (res.confirm) {
                    const data: UTSJSONObject = { linggong_id: linggongId.value } as UTSJSONObject
                    createApplication(data).then((r: ApiResult) => {
                        if (r.code == 200) {
                            uni.showToast({ title: '报名成功', icon: 'success' })
                        } else {
                            uni.showToast({ title: r.message || '报名失败', icon: 'none' })
                        }
                    })
                }
            }
        })
    }

    const goEmployer = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/employers/index?id=' + id })
    }

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            linggongId.value = parseInt(id as string)
            loadDetail()
        }
    })

    onPullDownRefresh(() => {
        loadDetail()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
    }

    .image-banner {
        width: 100%;
        height: 200px;
        background-color: #F5F5F5;
    }

    .banner-img {
        width: 100%;
        height: 100%;
    }

    .header-card {
        background-color: #FFFFFF;
        padding: 16px;
        margin-bottom: 8px;
    }

    .title-row {
        flex-direction: row;
        align-items: center;
        margin-bottom: 8px;
    }

    .title {
        font-size: 18px;
        color: #333;
        font-weight: 700;
        flex: 1;
    }

    .salary {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 10px;
    }

    .meta {
        font-size: 13px;
        color: #666;
    }

    .meta-dot {
        font-size: 13px;
        color: #CCC;
        margin: 0 6px;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 10px;
    }

    .tag {
        border-radius: 3px;
        padding: 2px 6px;
        margin-right: 6px;
    }

    .tag.urgent {
        background-color: #FFE5E5;
    }

    .tag.hot {
        background-color: #FFF5F0;
    }

    .tag.remote {
        background-color: #E5F8FF;
    }

    .tag-text {
        font-size: 11px;
    }

    .tag.urgent .tag-text {
        color: #EE0A24;
    }

    .tag.hot .tag-text {
        color: #FF6B35;
    }

    .tag.remote .tag-text {
        color: #1989FA;
    }

    .stats-row {
        flex-direction: row;
        align-items: center;
        margin-top: 12px;
        padding-top: 12px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .stat {
        font-size: 12px;
        color: #999;
    }

    .stat-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-bottom: 8px;
    }

    .section-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .section-content {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
    }

    .bottom-bar {
        flex-direction: row;
        background-color: #FFFFFF;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .bottom-btn {
        align-items: center;
        justify-content: center;
    }

    .icon-btn {
        width: 60px;
        padding: 4px 0;
    }

    .bottom-icon {
        font-size: 18px;
        color: #FF6B35;
    }

    .bottom-icon-text {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
    }

    .primary-btn {
        flex: 1;
        background-color: #FF6B35;
        border-radius: 22px;
        height: 44px;
        align-items: center;
        justify-content: center;
        margin-left: 12px;
    }

    .primary-btn-text {
        font-size: 15px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
