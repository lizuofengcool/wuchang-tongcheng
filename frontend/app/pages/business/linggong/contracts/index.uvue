<template>
    <view class="page">
        <view class="tab-bar">
            <view class="tab-item" v-for="(tab, idx) in tabs" :key="idx" @click="switchTab(idx)">
                <text class="tab-text" :class="{ active: currentTab == idx }">{{ tab.name }}</text>
                <view class="tab-line" v-if="currentTab == idx"></view>
            </view>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap">
                <linggong-contract-card
                    v-for="item in contractList"
                    :key="item.id"
                    :contract="transformItem(item)"
                    @click="goDetail"
                    @sign="onSign" />
            </view>
            <linggong-loading v-if="loading" />
            <view class="no-more" v-if="!hasMore && contractList.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <linggong-empty v-if="contractList.length == 0 && !loading" icon="📄" text="暂无合同" btn-text="去找兼职" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listContracts, signContract } from '@/api/business/linggong.uts'

    type Tab = { key: string, name: string }
    type Contract = {
        id: number
        contract_no: string
        linggong_id: number
        linggong_title: string
        peer_id: number
        peer_name: string
        amount: string
        status: string
        can_sign: boolean
        created_at: string
    }
    type CardData = {
        id: number
        contract_no: string
        linggong_title: string
        peer_name: string
        amount: string
        status: string
        can_sign: boolean
        created_at: string
    }

    const tabs = ref([
        { key: 'all', name: '全部' },
        { key: 'pending', name: '待签署' },
        { key: 'executing', name: '执行中' },
        { key: 'completed', name: '已完成' }
    ] as Tab[])
    const currentTab = ref(0)
    const contractList = ref([] as Contract[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformItem = (item: Contract) : CardData => {
        return {
            id: item.id,
            contract_no: item.contract_no,
            linggong_title: item.linggong_title,
            peer_name: item.peer_name,
            amount: item.amount,
            status: item.status,
            can_sign: item.can_sign,
            created_at: item.created_at
        } as CardData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        const status = tabs.value[currentTab.value].key
        if (status != 'all') {
            params['status'] = status
        }

        listContracts(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as Contract[]) ?? ([] as Contract[])
                if (reset) {
                    contractList.value = newList
                } else {
                    contractList.value = contractList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (idx: number) => {
        if (currentTab.value == idx) return
        currentTab.value = idx
        loadList(true)
    }

    const onSign = (id: number) => {
        uni.showModal({
            title: '在线签署',
            content: '确认签署该合同？',
            success: (res) => {
                if (res.confirm) {
                    const data: UTSJSONObject = { sign: true } as UTSJSONObject
                    signContract(id, data).then((r: ApiResult) => {
                        if (r.code == 200) {
                            uni.showToast({ title: '签署成功', icon: 'success' })
                            loadList(true)
                        } else {
                            uni.showToast({ title: r.message || '签署失败', icon: 'none' })
                        }
                    })
                }
            }
        })
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/contracts/index?id=' + id })
    }

    const goList = () => {
        uni.navigateTo({ url: '/pages/business/linggong/list/index' })
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onShow(() => {
        if (state.checkLogin()) {
            loadList(true)
        }
    })

    onPullDownRefresh(() => {
        loadList(true)
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        height: 44px;
        align-items: center;
        border-bottom-width: 1px;
        border-bottom-color: #E5E5E5;
    }

    .tab-item {
        flex: 1;
        align-items: center;
        justify-content: center;
        height: 44px;
    }

    .tab-text {
        font-size: 13px;
        color: #666;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .tab-line {
        width: 20px;
        height: 2px;
        background-color: #FF6B35;
        margin-top: 4px;
        border-radius: 1px;
    }

    .content {
        flex: 1;
    }

    .list-wrap {
        padding: 12px;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
