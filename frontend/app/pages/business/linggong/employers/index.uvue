<template>
    <view class="page">
        <scroll-view class="content" scroll-y>
            <view class="employer-header" :style="{ backgroundColor: employer.logo.length > 0 ? '#F5F5F5' : '#FF6B35' }">
                <view class="logo-row">
                    <image class="logo" :src="employer.logo" mode="aspectFill" lazy-load="true" v-if="employer.logo.length > 0" />
                    <view class="logo-placeholder" v-else>
                        <text class="logo-text">{{ employer.name.length > 0 ? employer.name.charAt(0) : 'E' }}</text>
                    </view>
                    <view class="info">
                        <text class="name">{{ employer.name }}</text>
                        <view class="meta-row" v-if="metaText.length > 0">
                            <text class="meta">{{ metaText }}</text>
                        </view>
                        <view class="verified-row" v-if="employer.is_verified">
                            <text class="verified-text">✓ 企业认证</text>
                        </view>
                    </view>
                </view>
                <view class="stats-row">
                    <view class="stat-cell">
                        <text class="stat-value">{{ employer.job_count }}</text>
                        <text class="stat-label">在招岗位</text>
                    </view>
                    <view class="stat-cell">
                        <text class="stat-value">{{ employer.rating_count }}</text>
                        <text class="stat-label">评价</text>
                    </view>
                    <view class="stat-cell">
                        <text class="stat-value">{{ employer.avg_rating }}</text>
                        <text class="stat-label">评分</text>
                    </view>
                </view>
            </view>

            <view class="section" v-if="employer.description.length > 0">
                <text class="section-title">雇主简介</text>
                <text class="section-content">{{ employer.description }}</text>
            </view>

            <view class="section" v-if="employer.address.length > 0">
                <text class="section-title">公司地址</text>
                <text class="section-content">{{ employer.address }}</text>
            </view>

            <view class="section">
                <view class="section-header">
                    <text class="section-title">在招岗位</text>
                    <text class="count-text">共 {{ linggongList.length }} 个</text>
                </view>
                <linggong-card v-for="item in linggongList" :key="item.id" :linggong="transformItem(item)" @click="goLinggongDetail" />
                <linggong-empty v-if="linggongList.length == 0 && !loading" icon="📋" text="暂无在招岗位" />
            </view>

            <view class="section" v-if="ratingList.length > 0">
                <text class="section-title">工人评价</text>
                <view class="rating-card" v-for="item in ratingList" :key="item.id">
                    <view class="rating-header">
                        <text class="rating-user">{{ item.rater_name }}</text>
                        <text class="rating-score">{{ item.score }}分</text>
                    </view>
                    <text class="rating-content">{{ item.content }}</text>
                    <text class="rating-time">{{ item.created_at }}</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { getEmployerDetail, listLinggongs, listRatingsByLinggong } from '@/api/business/linggong.uts'

    type Employer = {
        id: number
        name: string
        logo: string
        industry: string
        size: string
        city: string
        address: string
        description: string
        is_verified: boolean
        job_count: number
        rating_count: number
        avg_rating: number
    }
    type LinggongItem = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
        view_count: number
        fav_count: number
        application_count: number
    }
    type CardData = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
    }
    type Rating = {
        id: number
        rater_name: string
        score: number
        content: string
        created_at: string
    }

    const employerId = ref(0)
    const employer = ref({
        id: 0, name: '', logo: '', industry: '', size: '', city: '',
        address: '', description: '', is_verified: false,
        job_count: 0, rating_count: 0, avg_rating: 0
    } as Employer)
    const linggongList = ref([] as LinggongItem[])
    const ratingList = ref([] as Rating[])
    const loading = ref(false)

    const metaText = computed(() : string => {
        const parts = [] as string[]
        if (employer.value.industry.length > 0) parts.push(employer.value.industry)
        if (employer.value.size.length > 0) parts.push(employer.value.size)
        if (employer.value.city.length > 0) parts.push(employer.value.city)
        return parts.join(' · ')
    })

    const transformItem = (item: LinggongItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            salary_range: item.salary_range,
            city: item.city,
            work_type: item.work_type,
            duration: item.duration,
            employer_id: item.employer_id,
            employer_name: item.employer_name,
            employer_logo: item.employer_logo,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_remote: item.is_remote
        } as CardData
    }

    const loadEmployer = () => {
        getEmployerDetail(employerId.value).then((res: ApiResult) => {
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                employer.value = {
                    id: (d['id'] as number) ?? 0,
                    name: (d['name'] as string) ?? '',
                    logo: (d['logo'] as string) ?? '',
                    industry: (d['industry'] as string) ?? '',
                    size: (d['size'] as string) ?? '',
                    city: (d['city'] as string) ?? '',
                    address: (d['address'] as string) ?? '',
                    description: (d['description'] as string) ?? '',
                    is_verified: (d['is_verified'] as boolean) ?? false,
                    job_count: (d['job_count'] as number) ?? 0,
                    rating_count: (d['rating_count'] as number) ?? 0,
                    avg_rating: (d['avg_rating'] as number) ?? 0
                } as Employer
            }
        })
        loadLinggongs()
    }

    const loadLinggongs = () => {
        loading.value = true
        const params: UTSJSONObject = {
            page: 1,
            page_size: 50,
            employer_id: employerId.value
        } as UTSJSONObject
        listLinggongs(params).then((res: ApiResult) => {
            loading.value = false
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                linggongList.value = (d['list'] as LinggongItem[]) ?? ([] as LinggongItem[])
            }
        }).catch(() => {
            loading.value = false
        })
    }

    const goLinggongDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/detail/index?id=' + id })
    }

    onLoad((options: OnLoadOptions) => {
        const id = options['id']
        if (id != null) {
            employerId.value = parseInt(id as string)
            loadEmployer()
        }
    })

    onPullDownRefresh(() => {
        loadEmployer()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .content {
        flex: 1;
    }

    .employer-header {
        background-color: #FFFFFF;
        padding: 16px;
        margin-bottom: 8px;
    }

    .logo-row {
        flex-direction: row;
        align-items: center;
    }

    .logo {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        margin-right: 12px;
    }

    .logo-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background-color: #FFFFFF;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .logo-text {
        font-size: 32px;
        color: #FF6B35;
        font-weight: 700;
    }

    .info {
        flex: 1;
    }

    .name {
        font-size: 18px;
        color: #333;
        font-weight: 700;
    }

    .meta-row {
        margin-top: 4px;
    }

    .meta {
        font-size: 12px;
        color: #999;
    }

    .verified-row {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
    }

    .verified-text {
        font-size: 11px;
        color: #07C160;
    }

    .stats-row {
        flex-direction: row;
        margin-top: 16px;
        padding-top: 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .stat-cell {
        flex: 1;
        align-items: center;
    }

    .stat-value {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .stat-label {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-bottom: 8px;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .count-text {
        font-size: 12px;
        color: #999;
    }

    .section-content {
        font-size: 13px;
        color: #666;
        line-height: 1.6;
    }

    .rating-card {
        background-color: #FAFAFA;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 8px;
    }

    .rating-header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .rating-user {
        font-size: 13px;
        color: #333;
        font-weight: 600;
    }

    .rating-score {
        font-size: 13px;
        color: #FF6B35;
        font-weight: 600;
    }

    .rating-content {
        font-size: 12px;
        color: #666;
        margin-top: 6px;
        line-height: 1.5;
    }

    .rating-time {
        font-size: 11px;
        color: #BBB;
        margin-top: 6px;
    }
</style>
