<template>
    <view class="page">
        <view class="search-bar">
            <text class="back-arrow" @click="goBack">‹</text>
            <input class="search-input" type="text" v-model="keyword" placeholder="搜索兼职/工种/地点" :focus="true" @confirm="doSearch" />
            <text class="search-btn" @click="doSearch">搜索</text>
        </view>
        <scroll-view class="content" scroll-y @scrolltolower="loadMore">
            <view v-if="!hasSearched">
                <view class="section" v-if="hotKeywords.length > 0">
                    <text class="section-title">热门搜索</text>
                    <view class="tag-wrap">
                        <view class="tag" v-for="(k, idx) in hotKeywords" :key="idx" @click="onTag(k)">
                            <text class="tag-text">{{ k }}</text>
                        </view>
                    </view>
                </view>
                <view class="section" v-if="historyKeywords.length > 0">
                    <view class="section-header">
                        <text class="section-title">搜索历史</text>
                        <text class="clear-text" @click="clearHistory">清空</text>
                    </view>
                    <view class="history-list">
                        <view class="history-item" v-for="(k, idx) in historyKeywords" :key="idx" @click="onTag(k)">
                            <text class="history-time">🕒</text>
                            <text class="history-text">{{ k }}</text>
                        </view>
                    </view>
                </view>
            </view>
            <view v-else>
                <view class="list-wrap">
                    <linggong-card v-for="item in resultList" :key="item.id" :linggong="transformItem(item)" @click="goDetail" />
                </view>
                <linggong-loading v-if="loading" />
                <view class="no-more" v-if="!hasMore && resultList.length > 0">
                    <text class="no-more-text">已经到底啦~</text>
                </view>
                <linggong-empty v-if="resultList.length == 0 && !loading" icon="🔍" text="未找到相关兼职" btn-text="换个关键词" @click="clearSearch" />
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { searchLinggongs, listHotSkills, getSearchHistory, clearSearchHistory, addSearchHistory } from '@/api/business/linggong.uts'

    type ResultItem = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
        view_count: number
        fav_count: number
        application_count: number
    }
    type CardData = {
        id: number
        title: string
        salary_range: string
        city: string
        work_type: string
        duration: string
        employer_id: number
        employer_name: string
        employer_logo: string
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
    }

    const keyword = ref('')
    const hotKeywords = ref([] as string[])
    const historyKeywords = ref([] as string[])
    const hasSearched = ref(false)
    const resultList = ref([] as ResultItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformItem = (item: ResultItem) : CardData => {
        return {
            id: item.id,
            title: item.title,
            salary_range: item.salary_range,
            city: item.city,
            work_type: item.work_type,
            duration: item.duration,
            employer_id: item.employer_id,
            employer_name: item.employer_name,
            employer_logo: item.employer_logo,
            view_count: item.view_count,
            is_urgent: item.is_urgent,
            is_hot: item.is_hot,
            is_remote: item.is_remote
        } as CardData
    }

    const loadInit = () => {
        listHotSkills().then((res: ApiResult) => {
            if (res.code == 200 && res.data) {
                const arr = (res.data as string[]) ?? ([] as string[])
                hotKeywords.value = arr
            }
        })
        historyKeywords.value = getSearchHistory()
    }

    const doSearch = () => {
        const kw = keyword.value.trim()
        if (kw.length == 0) {
            uni.showToast({ title: '请输入关键词', icon: 'none' })
            return
        }
        hasSearched.value = true
        addSearchHistory(kw)
        historyKeywords.value = getSearchHistory()
        loadResult(true)
    }

    const loadResult = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            keyword: keyword.value,
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        searchLinggongs(params).then((res: ApiResult) => {
            loading.value = false
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ResultItem[]) ?? ([] as ResultItem[])
                if (reset) {
                    resultList.value = newList
                } else {
                    resultList.value = resultList.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadResult(false)
    }

    const onTag = (k: string) => {
        keyword.value = k
        doSearch()
    }

    const clearHistory = () => {
        uni.showModal({
            title: '提示',
            content: '确认清空搜索历史？',
            success: (res) => {
                if (res.confirm) {
                    clearSearchHistory()
                    historyKeywords.value = [] as string[]
                    uni.showToast({ title: '已清空', icon: 'success' })
                }
            }
        })
    }

    const clearSearch = () => {
        keyword.value = ''
        hasSearched.value = false
        resultList.value = [] as ResultItem[]
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/linggong/detail/index?id=' + id })
    }

    const goBack = () => {
        uni.navigateBack()
    }

    onLoad(() => {
        loadInit()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
    }

    .back-arrow {
        font-size: 24px;
        color: #333;
        padding: 0 8px;
    }

    .search-input {
        flex: 1;
        background-color: #F5F5F5;
        border-radius: 18px;
        padding: 8px 12px;
        font-size: 13px;
        color: #333;
    }

    .search-btn {
        font-size: 14px;
        color: #FF6B35;
        margin-left: 12px;
    }

    .content {
        flex: 1;
    }

    .section {
        background-color: #FFFFFF;
        padding: 12px 16px;
        margin-top: 8px;
    }

    .section-header {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .section-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .clear-text {
        font-size: 12px;
        color: #999;
    }

    .tag-wrap {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .tag {
        background-color: #F5F5F5;
        border-radius: 14px;
        padding: 4px 12px;
        margin-right: 8px;
        margin-top: 8px;
    }

    .tag-text {
        font-size: 12px;
        color: #666;
    }

    .history-list {
        flex-direction: column;
    }

    .history-item {
        flex-direction: row;
        align-items: center;
        padding: 10px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .history-time {
        font-size: 13px;
        color: #CCC;
        margin-right: 8px;
    }

    .history-text {
        font-size: 13px;
        color: #333;
    }

    .list-wrap {
        padding: 8px 12px;
    }

    .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
