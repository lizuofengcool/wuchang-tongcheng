        font-size: 18px;
        color: #333;
        font-weight: 700;
    }

    .subtitle {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
    }

    .content {
        flex: 1;
        padding: 12px;
    }

    .info-card {
        background-color: #FFF5F0;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .info-title {
        font-size: 13px;
        color: #FF6B35;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .info-text {
        font-size: 12px;
        color: #666;
        line-height: 1.6;
    }

    .action-card {
        flex-direction: row;
        margin-bottom: 16px;
    }

    .action-btn {
        flex: 1;
        height: 44px;
        border-radius: 22px;
        align-items: center;
        justify-content: center;
        margin: 0 6px;
    }

    .action-btn.outline {
        background-color: #FFFFFF;
        border-width: 1px;
        border-color: #FF6B35;
    }

    .action-btn.primary {
        background-color: #FF6B35;
    }

    .btn-text {
        font-size: 14px;
        color: #FF6B35;
    }

    .btn-text-white {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .section-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .rate-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
    }

    .rate-row {
        flex-direction: row;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom-width: 1px;
        border-bottom-color: #F5F5F5;
    }

    .rate-name {
        font-size: 13px;
        color: #666;
        flex: 1;
    }

    .rate-value {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 600;
    }
</style>
