<template>
    <view class="page">
        <view class="search-bar" @click="goSearch">
            <text class="search-icon">🔍</text>
            <text class="search-placeholder">搜索小区/房源/位置</text>
        </view>
        <house-filter :items="filterItems" :active-key="activeFilterKey" :panel-visible="showFilterPanel" :selected="selectedFilters" @tap="onTapFilter" />
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="sort-bar">
                <text class="sort-text" :class="{ active: currentSort == 'popular' }" @click="changeSort('popular')">综合</text>
                <text class="sort-text" :class="{ active: currentSort == 'latest' }" @click="changeSort('latest')">最新</text>
                <text class="sort-text" :class="{ active: currentSort == 'price_asc' }" @click="changeSort('price_asc')">价格升</text>
                <text class="sort-text" :class="{ active: currentSort == 'price_desc' }" @click="changeSort('price_desc')">价格降</text>
                <text class="sort-text" :class="{ active: currentSort == 'nearby' }" @click="changeSort('nearby')">附近</text>
            </view>
            <view class="list-wrap">
                <house-card v-for="item in list" :key="item.id" :house="transformHouse(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <house-empty v-if="list.length == 0 && !loading" icon="🏠" text="暂无房源" btn-text="去发布" @click="goPublish" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { listHouses, listNearbyHouses } from '@/api/business/house.uts'

    type ListItem = {
        id: number
        title: string
        cover_image: string
        listing_type: string
        layout: string
        area_text: string
        floor_text: string
        orientation: string
        price: number
        community_name: string
        has_vr: boolean
        is_urgent: boolean
        is_featured: boolean
    }
    type HouseCardData = {
        id: number
        title: string
        cover_image: string
        listing_type: string
        layout: string
        area_text: string
        floor_text: string
        orientation: string
        price: number
        community_name: string
        has_vr: boolean
        is_urgent: boolean
        is_featured: boolean
    }
    type FilterItem = { key: string, label: string, options: string[] }

    const filterItems = [
        { key: 'listing_type', label: '租售', options: [] as string[] },
        { key: 'layout', label: '户型', options: [] as string[] },
        { key: 'price', label: '价格', options: [] as string[] },
        { key: 'area', label: '面积', options: [] as string[] }
    ] as FilterItem[]

    const activeFilterKey = ref('')
    const showFilterPanel = ref(false)
    const selectedFilters = ref({} as UTSJSONObject)
    const currentSort = ref('popular')
    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformHouse = (item: ListItem) : HouseCardData => {
        return {
            id: item.id,
            title: item.title,
            cover_image: item.cover_image,
            listing_type: item.listing_type,
            layout: item.layout,
            area_text: item.area_text,
            floor_text: item.floor_text,
            orientation: item.orientation,
            price: item.price,
            community_name: item.community_name,
            has_vr: item.has_vr,
            is_urgent: item.is_urgent,
            is_featured: item.is_featured
        } as HouseCardData
    }

    const onTapFilter = (key: string) => {
        if (activeFilterKey.value == key && showFilterPanel.value) {
            showFilterPanel.value = false
            activeFilterKey.value = ''
            return
        }
        activeFilterKey.value = key
        showFilterPanel.value = true
        let options = [] as string[]
        if (key == 'listing_type') options = ['全部', '出售', '出租']
        else if (key == 'layout') options = ['全部', '1室', '2室', '3室', '4室+']
        else if (key == 'price') options = ['全部', '50万以下', '50-100万', '100-200万', '200万以上']
        else if (key == 'area') options = ['全部', '50㎡以下', '50-90㎡', '90-120㎡', '120㎡以上']
        uni.showActionSheet({
            itemList: options,
            success: (res) => {
                const v = options[res.tapIndex]
                selectedFilters.value[key] = v == '全部' ? '' : v
                showFilterPanel.value = false
                activeFilterKey.value = ''
                loadList(true)
            }
        })
    }

    const changeSort = (s: string) => {
        if (currentSort.value == s) return
        currentSort.value = s
        loadList(true)
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize,
            sort: currentSort.value
        } as UTSJSONObject
        const keys = Object.keys(selectedFilters.value)
        for (let i = 0; i < keys.length; i++) {
            const k = keys[i]
            const v = (selectedFilters.value[k] as string) ?? ''
            if (v.length > 0) params[k] = v
        }

        const useNearby = currentSort.value == 'nearby'
        const reqFn = useNearby ? listNearbyHouses(params) : listHouses(params)
        reqFn.then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            } else {
                uni.showToast({ title: res.message || '加载失败', icon: 'none' })
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/fang/detail/index?id=' + id })
    }

    const goSearch = () => {
        uni.navigateTo({ url: '/pages/business/fang/search/index' })
    }

    const goPublish = () => {
        uni.navigateTo({ url: '/pages/business/fang/publish/index' })
    }

    onLoad(() => {
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .search-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        margin: 8px 12px;
        padding: 8px 12px;
        border-radius: 20px;
        background-color: #F5F5F5;
    }

    .search-icon {
        font-size: 14px;
        color: #999;
        margin-right: 6px;
    }

    .search-placeholder {
        font-size: 13px;
        color: #999;
    }

    .list-scroll {
        flex: 1;
    }

    .sort-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 8px 12px;
        margin-bottom: 8px;
    }

    .sort-text {
        flex: 1;
        font-size: 13px;
        color: #666;
        text-align: center;
    }

    .sort-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-wrap {
        padding: 0 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
