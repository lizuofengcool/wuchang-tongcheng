<template>
    <view class="page">
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap" v-if="list.length > 0">
                <house-card v-for="item in list" :key="item.id" :house="transformHouse(item)" @click="goDetail" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <house-empty v-if="list.length == 0 && !loading" icon="★" text="暂无收藏房源" btn-text="去发现" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listFavoriteHouses } from '@/api/business/house.uts'

    type ListItem = {
        id: number
        title: string
        cover_image: string
        listing_type: string
        layout: string
        area_text: string
        floor_text: string
        orientation: string
        price: number
        community_name: string
        has_vr: boolean
        is_urgent: boolean
        is_featured: boolean
    }
    type HouseCardData = {
        id: number
        title: string
        cover_image: string
        listing_type: string
        layout: string
        area_text: string
        floor_text: string
        orientation: string
        price: number
        community_name: string
        has_vr: boolean
        is_urgent: boolean
        is_featured: boolean
    }

    const list = ref([] as ListItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const transformHouse = (item: ListItem) : HouseCardData => {
        return {
            id: item.id,
            title: item.title,
            cover_image: item.cover_image,
            listing_type: item.listing_type,
            layout: item.layout,
            area_text: item.area_text,
            floor_text: item.floor_text,
            orientation: item.orientation,
            price: item.price,
            community_name: item.community_name,
            has_vr: item.has_vr,
            is_urgent: item.is_urgent,
            is_featured: item.is_featured
        } as HouseCardData
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listFavoriteHouses(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as ListItem[]) ?? ([] as ListItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/fang/detail/index?id=' + id })
    }

    const goList = () => {
        uni.navigateBack()
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 8px 12px;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
