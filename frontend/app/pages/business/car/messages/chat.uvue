<template>
    <view class="page">
        <view class="header">
            <view class="header-info">
                <image class="dealer-avatar" :src="dealerAvatar" mode="aspectFill" lazy-load="true" v-if="dealerAvatar.length > 0" />
                <view class="dealer-avatar-placeholder" v-else>
                    <text class="placeholder-text">{{ dealerName.charAt(0) }}</text>
                </view>
                <view class="header-text">
                    <text class="dealer-name">{{ dealerName }}</text>
                    <text class="car-title" v-if="carTitle.length > 0">{{ carTitle }}</text>
                </view>
            </view>
            <view class="header-actions">
                <view class="action-btn call" @click="onCall">
                    <text class="action-icon">📞</text>
                </view>
            </view>
        </view>
        <scroll-view class="content" scroll-y :scroll-top="scrollTop" :scroll-with-animation="true">
            <view class="message-list">
                <view class="msg-item" v-for="(msg, idx) in messages" :key="idx" :class="msg.from_me ? 'right' : 'left'">
                    <view class="bubble" :class="msg.from_me ? 'right-bubble' : 'left-bubble'">
                        <text class="msg-text">{{ msg.text }}</text>
                    </view>
                    <text class="msg-time">{{ msg.time }}</text>
                </view>
            </view>
            <view class="notice-card" v-if="messages.length == 0">
                <text class="notice-icon">💬</text>
                <text class="notice-title">暂无消息记录</text>
                <text class="notice-text">车辆模块暂未提供实时聊天功能</text>
                <text class="notice-text">您可以通过电话直接联系车商</text>
                <view class="notice-btn" @click="onCall" v-if="dealerPhone.length > 0">
                    <text class="notice-btn-text">📞 拨打 {{ dealerPhone }}</text>
                </view>
            </view>
        </scroll-view>
        <view class="input-bar">
            <input class="msg-input" v-model="inputText" placeholder="输入消息..." @confirm="onSend" />
            <view class="send-btn" @click="onSend">
                <text class="send-text">发送</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'

    type Message = {
        text: string
        time: string
        from_me: boolean
    }

    const dealerId = ref(0)
    const carId = ref(0)
    const sessionId = ref(0)
    const dealerName = ref('车商')
    const dealerAvatar = ref('')
    const dealerPhone = ref('')
    const carTitle = ref('')
    const messages = ref([] as Message[])
    const inputText = ref('')
    const scrollTop = ref(0)

    const onSend = () => {
        const text = inputText.value.trim()
        if (text.length == 0) return
        const now = formatNow()
        messages.value.push({
            text: text,
            time: now,
            from_me: true
        } as Message)
        inputText.value = ''
        scrollToBottom()
        // 模拟自动回复
        setTimeout(() => {
            messages.value.push({
                text: '您好，我已经收到您的消息，详细请电话联系。',
                time: formatNow(),
                from_me: false
            } as Message)
            scrollToBottom()
        }, 800)
    }

    const formatNow = () : string => {
        const d = new Date()
        const h = d.getHours()
        const m = d.getMinutes()
        return (h < 10 ? '0' + h : '' + h) + ':' + (m < 10 ? '0' + m : '' + m)
    }

    const scrollToBottom = () => {
        scrollTop.value = scrollTop.value == 99999 ? 99998 : 99999
    }

    const onCall = () => {
        if (dealerPhone.value.length > 0) {
            uni.makePhoneCall({ phoneNumber: dealerPhone.value })
        } else {
            uni.showToast({ title: '暂无联系电话', icon: 'none' })
        }
    }

    onLoad((options: OnLoadOptions) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        const did = options['dealer_id']
        const cid = options['car_id']
        const sid = options['session_id']
        if (did != null) dealerId.value = parseInt(did as string)
        if (cid != null) carId.value = parseInt(cid as string)
        if (sid != null) sessionId.value = parseInt(sid as string)
        // 信息从路由参数取（fallback）
        const dn = options['dealer_name']
        if (dn != null) dealerName.value = dn as string
        const dp = options['dealer_phone']
        if (dp != null) dealerPhone.value = dp as string
        const ct = options['car_title']
        if (ct != null) carTitle.value = ct as string
        scrollToBottom()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .header {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 10px 12px;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .header-info {
        flex: 1;
        flex-direction: row;
        align-items: center;
    }

    .dealer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        margin-right: 8px;
    }

    .dealer-avatar-placeholder {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
    }

    .placeholder-text {
        font-size: 16px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .header-text {
        flex: 1;
    }

    .dealer-name {
        font-size: 14px;
        color: #333;
        font-weight: 600;
    }

    .car-title {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .header-actions {
        flex-direction: row;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .action-icon {
        font-size: 16px;
    }

    .content {
        flex: 1;
    }

    .message-list {
        padding: 12px;
    }

    .msg-item {
        margin-bottom: 12px;
    }

    .msg-item.right {
        align-items: flex-end;
    }

    .msg-item.left {
        align-items: flex-start;
    }

    .bubble {
        max-width: 280px;
        padding: 10px 14px;
        border-radius: 12px;
    }

    .right-bubble {
        background-color: #FF6B35;
    }

    .left-bubble {
        background-color: #FFFFFF;
    }

    .msg-text {
        font-size: 14px;
        line-height: 1.4;
    }

    .right-bubble .msg-text {
        color: #FFFFFF;
    }

    .left-bubble .msg-text {
        color: #333;
    }

    .msg-time {
        font-size: 10px;
        color: #BBB;
        margin-top: 4px;
    }

    .notice-card {
        align-items: center;
        justify-content: center;
        padding: 60px 24px;
    }

    .notice-icon {
        font-size: 64px;
        margin-bottom: 16px;
    }

    .notice-title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .notice-text {
        font-size: 12px;
        color: #999;
        margin-bottom: 4px;
    }

    .notice-btn {
        background-color: #FF6B35;
        border-radius: 22px;
        padding: 10px 24px;
        margin-top: 16px;
    }

    .notice-btn-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .input-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .msg-input {
        flex: 1;
        background-color: #F5F5F5;
        border-radius: 18px;
        padding: 8px 14px;
        font-size: 13px;
        color: #333;
    }

    .send-btn {
        background-color: #FF6B35;
        border-radius: 18px;
        padding: 8px 16px;
        margin-left: 8px;
    }

    .send-text {
        font-size: 13px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
