<template>
    <view class="page">
        <view class="tab-bar">
            <text class="tab-text" v-for="(tab, idx) in tabs" :key="idx" :class="{ active: currentTab == tab.key }" @click="switchTab(tab.key)">{{ tab.name }}</text>
        </view>
        <scroll-view class="list-scroll" scroll-y @scrolltolower="loadMore">
            <view class="list-wrap" v-if="list.length > 0">
                <view class="test-card" v-for="item in list" :key="item.id" @click="goDetail(item.id)">
                    <view class="header-row">
                        <text class="title">{{ item.car_title }}</text>
                        <view class="status-tag" :class="item.status">
                            <text class="status-text">{{ statusText(item.status) }}</text>
                        </view>
                    </view>
                    <view class="info-row">
                        <text class="info-icon">🚗</text>
                        <text class="info-text">{{ item.car_brand }} {{ item.car_model }}</text>
                    </view>
                    <view class="info-row">
                        <text class="info-icon">🕒</text>
                        <text class="info-text">{{ item.appointment_time }}</text>
                    </view>
                    <view class="info-row" v-if="item.dealer_name.length > 0">
                        <text class="info-icon">🏪</text>
                        <text class="info-text">{{ item.dealer_name }}</text>
                    </view>
                    <view class="info-row" v-if="item.address.length > 0">
                        <text class="info-icon">📍</text>
                        <text class="info-text">{{ item.address }}</text>
                    </view>
                    <view class="action-row" v-if="item.status == 'pending'">
                        <view class="action-btn outline" @click.stop="onCancel(item.id)">
                            <text class="btn-text">取消预约</text>
                        </view>
                    </view>
                    <view class="action-row" v-else-if="item.status == 'completed' && !item.has_license">
                        <view class="action-btn primary" @click.stop="onUploadLicense(item.id)">
                            <text class="btn-text-white">上传驾照</text>
                        </view>
                    </view>
                </view>
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && list.length > 0">
                <text class="no-more-text">已经到底啦~</text>
            </view>
            <car-empty v-if="list.length == 0 && !loading" icon="📅" text="暂无试驾预约" btn-text="去试驾" @click="goList" />
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listMyTestDrives, cancelTestDrive, uploadTestDriveLicense } from '@/api/business/car.uts'

    type TestItem = {
        id: number
        car_id: number
        car_title: string
        car_brand: string
        car_model: string
        appointment_time: string
        dealer_name: string
        address: string
        status: string
        has_license: boolean
    }
    type Tab = { key: string, name: string }

    const tabs = [
        { key: 'all', name: '全部' },
        { key: 'pending', name: '待试驾' },
        { key: 'completed', name: '已完成' },
        { key: 'cancelled', name: '已取消' }
    ] as Tab[]

    const currentTab = ref('all')
    const list = ref([] as TestItem[])
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 20

    const statusText = (s: string) : string => {
        if (s == 'pending') return '待试驾'
        if (s == 'completed') return '已完成'
        if (s == 'cancelled') return '已取消'
        if (s == 'rejected') return '已拒绝'
        return s
    }

    const loadList = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject
        if (currentTab.value != 'all') params['status'] = currentTab.value

        listMyTestDrives(params).then((res: ApiResult) => {
            loading.value = false
            uni.stopPullDownRefresh()
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as TestItem[]) ?? ([] as TestItem[])
                if (reset) {
                    list.value = newList
                } else {
                    list.value = list.value.concat(newList)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
            }
        }).catch(() => {
            loading.value = false
            uni.stopPullDownRefresh()
        })
    }

    const loadMore = () => {
        if (!hasMore.value || loading.value) return
        loadList(false)
    }

    const switchTab = (k: string) => {
        if (currentTab.value == k) return
        currentTab.value = k
        loadList(true)
    }

    const onCancel = (id: number) => {
        uni.showModal({
            title: '提示',
            content: '确认取消该试驾预约？',
            success: (r) => {
                if (r.confirm) {
                    cancelTestDrive(id).then((res: ApiResult) => {
                        if (res.code == 200) {
                            uni.showToast({ title: '已取消', icon: 'success' })
                            loadList(true)
                        }
                    })
                }
            }
        })
    }

    const onUploadLicense = (id: number) => {
        uni.chooseImage({
            count: 1,
            success: (r) => {
                const path = r.tempFilePaths[0]
                const data: UTSJSONObject = {
                    license_image: path
                } as UTSJSONObject
                uploadTestDriveLicense(id, data).then((res: ApiResult) => {
                    if (res.code == 200) {
                        uni.showToast({ title: '上传成功', icon: 'success' })
                        loadList(true)
                    }
                })
            }
        })
    }

    const goDetail = (id: number) => {
        uni.navigateTo({ url: '/pages/business/car/test-drive/detail?id=' + id })
    }

    const goList = () => {
        uni.navigateBack()
    }

    onLoad(() => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        loadList(true)
    })

    onPullDownRefresh(() => {
        loadList(true)
    })

    onReachBottom(() => {
        loadMore()
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .tab-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        padding: 10px 8px;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .tab-text {
        flex: 1;
        font-size: 13px;
        color: #666;
        text-align: center;
        padding: 4px 0;
    }

    .tab-text.active {
        color: #FF6B35;
        font-weight: 600;
    }

    .list-scroll {
        flex: 1;
    }

    .list-wrap {
        padding: 8px 12px;
    }

    .test-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        flex: 1;
    }

    .status-tag {
        border-radius: 12px;
        padding: 2px 8px;
        margin-left: 8px;
    }

    .status-tag.pending {
        background-color: #FFF5F0;
    }

    .status-tag.completed {
        background-color: #F0FFF8;
    }

    .status-tag.cancelled {
        background-color: #FFE5E5;
    }

    .status-text {
        font-size: 11px;
    }

    .status-tag.pending .status-text {
        color: #FF6B35;
    }

    .status-tag.completed .status-text {
        color: #07C160;
    }

    .status-tag.cancelled .status-text {
        color: #EE0A24;
    }

    .info-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
    }

    .info-icon {
        font-size: 13px;
        margin-right: 6px;
    }

    .info-text {
        font-size: 13px;
        color: #666;
        flex: 1;
    }

    .action-row {
        flex-direction: row;
        margin-top: 12px;
        padding-top: 10px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
        justify-content: flex-end;
    }

    .action-btn {
        padding: 6px 16px;
        border-radius: 16px;
        margin-left: 8px;
    }

    .action-btn.outline {
        background-color: #FFFFFF;
        border-width: 1px;
        border-color: #DDDDDD;
    }

    .action-btn.primary {
        background-color: #FF6B35;
    }

    .btn-text {
        font-size: 13px;
        color: #666;
    }

    .btn-text-white {
        font-size: 13px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .load-more, .no-more {
        padding: 16px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
