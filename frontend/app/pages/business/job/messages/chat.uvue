<template>
    <view class="page">
        <scroll-view class="msg-list" scroll-y :scroll-top="scrollTop" :scroll-into-view="scrollToId">
            <view class="msg-item" v-for="(msg, idx) in messageList" :key="idx" :id="'msg-' + idx">
                <job-message-item :msg="transformMsg(msg)" :mine="msg.is_mine" :show-sender="false" />
            </view>
            <view class="load-more" v-if="loading">
                <text class="load-text">加载中...</text>
            </view>
            <view class="no-more" v-if="!hasMore && messageList.length > 0">
                <text class="no-more-text">没有更多消息了</text>
            </view>
        </scroll-view>
        <view class="input-bar">
            <input class="msg-input" type="text" v-model="inputText" placeholder="请输入消息" :confirm-type="'send'" @confirm="onSend" />
            <view class="send-btn" @click="onSend">
                <text class="send-text">发送</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    import { state } from '@/store/index.uts'
    import { listMessages, sendMessage } from '@/api/business/job.uts'

    type Message = {
        id: number
        session_id: number
        sender_id: number
        content: string
        type: string
        is_mine: boolean
        created_at: string
    }
    type MsgData = {
        id: number
        content: string
        type: string
        sender_name: string
        time: string
    }

    const sessionId = ref(0)
    const jobId = ref(0)
    const peerId = ref(0)
    const peerName = ref('')
    const messageList = ref([] as Message[])
    const inputText = ref('')
    const loading = ref(false)
    const hasMore = ref(true)
    const page = ref(1)
    const pageSize = 50
    const scrollTop = ref(0)
    const scrollToId = ref('')

    const transformMsg = (msg: Message) : MsgData => {
        return {
            id: msg.id,
            content: msg.content,
            type: msg.type,
            sender_name: msg.is_mine ? '我' : peerName.value,
            time: msg.created_at
        } as MsgData
    }

    const loadMessages = (reset: boolean = false) => {
        if (loading.value) return
        if (reset) {
            page.value = 1
            hasMore.value = true
        }
        if (!hasMore.value) return

        loading.value = true
        const params: UTSJSONObject = {
            page: page.value,
            page_size: pageSize
        } as UTSJSONObject

        listMessages(sessionId.value, params).then((res: ApiResult) => {
            loading.value = false
            if (res.code == 200 && res.data) {
                const d = res.data as UTSJSONObject
                const newList = (d['list'] as Message[]) ?? ([] as Message[])
                if (reset) {
                    messageList.value = newList
                } else {
                    messageList.value = newList.concat(messageList.value)
                }
                hasMore.value = newList.length >= pageSize
                if (hasMore.value) page.value++
                if (reset && messageList.value.length > 0) {
                    nextTick(() => {
                        scrollToBottom()
                    })
                }
            }
        }).catch(() => {
            loading.value = false
        })
    }

    const scrollToBottom = () => {
        if (messageList.value.length == 0) return
        scrollToId.value = 'msg-' + (messageList.value.length - 1)
    }

    const onSend = () => {
        const text = inputText.value.trim()
        if (text.length == 0) {
            uni.showToast({ title: '请输入消息', icon: 'none' })
            return
        }
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            return
        }

        const data: UTSJSONObject = {
            session_id: sessionId.value,
            content: text,
            type: 'text'
        } as UTSJSONObject
        if (peerId.value > 0) data['receiver_id'] = peerId.value
        if (jobId.value > 0) data['job_id'] = jobId.value

        sendMessage(sessionId.value, data).then((res: ApiResult) => {
            if (res.code == 200) {
                inputText.value = ''
                loadMessages(true)
            } else {
                uni.showToast({ title: res.message || '发送失败', icon: 'none' })
            }
        })
    }

    onLoad((options: OnLoadOptions) => {
        if (!state.checkLogin()) {
            uni.showToast({ title: '请先登录', icon: 'none' })
            setTimeout(() => { uni.navigateBack() }, 1000)
            return
        }
        const sid = options['session_id']
        const jid = options['job_id']
        const pid = options['peer_id']
        const pn = options['peer_name']
        if (sid != null) {
            sessionId.value = parseInt(sid as string)
        }
        if (jid != null) {
            jobId.value = parseInt(jid as string)
        }
        if (pid != null) {
            peerId.value = parseInt(pid as string)
        }
        if (pn != null) {
            peerName.value = decodeURIComponent(pn as string)
        }
        loadMessages(true)
    })

    onShow(() => {
        if (sessionId.value > 0) {
            loadMessages(true)
        }
    })
</script>

<style>
    .page {
        flex: 1;
        background-color: #F5F5F5;
    }

    .msg-list {
        flex: 1;
    }

    .msg-item {
        padding: 4px 0;
    }

    .input-bar {
        background-color: #FFFFFF;
        flex-direction: row;
        align-items: center;
        padding: 8px 12px;
        border-top-width: 1px;
        border-top-color: #F0F0F0;
    }

    .msg-input {
        flex: 1;
        background-color: #F5F5F5;
        border-radius: 18px;
        padding: 8px 12px;
        font-size: 13px;
        color: #333;
    }

    .send-btn {
        background-color: #FF6B35;
        border-radius: 18px;
        padding: 8px 16px;
        margin-left: 8px;
    }

    .send-text {
        font-size: 13px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .load-more, .no-more {
        padding: 12px 0;
        align-items: center;
    }

    .load-text, .no-more-text {
        font-size: 12px;
        color: #999;
    }
</style>
