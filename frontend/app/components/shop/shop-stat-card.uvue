<template>
    <view class="stat-card" :class="type">
        <view class="icon-row" v-if="icon.length > 0">
            <text class="icon">{{ icon }}</text>
        </view>
        <view class="content">
            <text class="label">{{ label }}</text>
            <view class="value-row">
                <text class="prefix" v-if="prefix.length > 0">{{ prefix }}</text>
                <text class="value">{{ value }}</text>
                <text class="suffix" v-if="suffix.length > 0">{{ suffix }}</text>
            </view>
            <text class="trend" v-if="trend.length > 0" :class="trendType">{{ trend }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        label: string
        value: string | number
        prefix?: string
        suffix?: string
        icon?: string
        trend?: string
        trendType?: string  // 'up' | 'down' | ''
        type?: string       // 'primary' | 'default'
    }>(), {
        prefix: '',
        suffix: '',
        icon: '',
        trend: '',
        trendType: '',
        type: 'default'
    } as any)
</script>

