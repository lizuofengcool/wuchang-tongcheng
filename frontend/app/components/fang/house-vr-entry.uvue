<template>
    <view class="vr-entry" @click="onClick">
        <image class="cover" :src="vr.cover_image" mode="aspectFill" lazy-load="true" v-if="vr.cover_image.length > 0" />
        <view class="cover-placeholder" v-else>
            <text class="placeholder-icon">🏠</text>
        </view>
        <view class="vr-overlay">
            <view class="vr-badge">
                <text class="vr-icon">🎥</text>
                <text class="vr-text">VR全景</text>
            </view>
            <view class="play-icon">
                <text class="play-text">▶</text>
            </view>
        </view>
        <view class="info" v-if="vr.title.length > 0">
            <text class="title">{{ vr.title }}</text>
            <text class="sub" v-if="vr.scene_count > 0">{{ vr.scene_count }}个场景</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    type VR = {
        id: number
        title: string
        cover_image: string
        scene_count: number
        url: string
    }

    const props = withDefaults(defineProps<{
        vr: VR
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const onClick = () => {
        emit('click', props.vr.id)
    }
</script>

