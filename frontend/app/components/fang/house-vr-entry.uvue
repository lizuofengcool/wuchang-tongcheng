        right: 0;
        bottom: 0;
        align-items: center;
        justify-content: center;
    }

    .vr-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background-color: rgba(0, 0, 0, 0.6);
        flex-direction: row;
        align-items: center;
        padding: 4px 10px;
        border-radius: 14px;
    }

    .vr-icon {
        font-size: 12px;
        margin-right: 4px;
