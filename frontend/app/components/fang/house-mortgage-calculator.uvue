<template>
    <view class="calc">
        <view class="header-row">
            <text class="title">房贷计算器</text>
            <view class="type-switch">
                <text class="type-text" :class="{ active: calcType == 'commercial' }" @click="switchType('commercial')">商贷</text>
                <text class="type-text" :class="{ active: calcType == 'fund' }" @click="switchType('fund')">公积金</text>
            </view>
        </view>
        <view class="input-row">
            <text class="label">贷款金额</text>
            <view class="input-wrap">
                <text class="input-prefix">¥</text>
                <input class="input" type="number" :value="amount" @input="onAmount" placeholder="请输入金额" />
                <text class="input-suffix">万</text>
            </view>
        </view>
        <view class="input-row">
            <text class="label">贷款年限</text>
            <view class="year-options">
                <text class="year-text" v-for="y in yearOptions" :key="y" :class="{ active: years == y }" @click="onYear(y)">{{ y }}年</text>
            </view>
        </view>
        <view class="input-row">
            <text class="label">利率</text>
            <view class="input-wrap">
                <input class="input" type="number" :value="rate" @input="onRate" placeholder="年利率" />
                <text class="input-suffix">%</text>
            </view>
        </view>
        <view class="result-card">
            <view class="result-cell">
                <text class="result-label">月供</text>
                <text class="result-value">¥{{ monthlyPayment }}</text>
            </view>
            <view class="result-divider"></view>
            <view class="result-cell">
                <text class="result-label">利息总额</text>
                <text class="result-value">¥{{ totalInterest }}万</text>
            </view>
            <view class="result-divider"></view>
            <view class="result-cell">
                <text class="result-label">还款总额</text>
                <text class="result-value">¥{{ totalPayment }}万</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        defaultAmount?: number
        defaultYears?: number
    }>(), {
        defaultAmount: 100,
        defaultYears: 30
    } as any)

    const calcType = ref('commercial')
    const amount = ref(props.defaultAmount)
    const years = ref(props.defaultYears)
    const rate = ref(4.2)
    const yearOptions = [10, 15, 20, 25, 30] as number[]

    const monthlyPayment = computed(() : string => {
        const r = calc()
        return r.monthly.toFixed(2)
    })

    const totalInterest = computed(() : string => {
        const r = calc()
        return r.interest.toFixed(2)
    })

    const totalPayment = computed(() : string => {
        const r = calc()
        return r.total.toFixed(2)
    })

    const calc = () : { monthly: number, interest: number, total: number } => {
        const principal = amount.value * 10000
        const months = years.value * 12
        const monthRate = rate.value / 100 / 12
        if (principal <= 0 || months <= 0 || monthRate <= 0) {
            return { monthly: 0, interest: 0, total: 0 } as { monthly: number, interest: number, total: number }
        }
        const pow = Math.pow(1 + monthRate, months)
        const m = principal * monthRate * pow / (pow - 1)
        const total = m * months
        return { monthly: m, interest: total - principal, total: total } as { monthly: number, interest: number, total: number }
    }

    const switchType = (t: string) => {
        if (calcType.value == t) return
        calcType.value = t
        rate.value = t == 'fund' ? 3.1 : 4.2
    }

    const onAmount = (e: InputEvent) => {
        const v = (e.detail as UTSJSONObject).value as string
        amount.value = parseFloat(v) || 0
    }

    const onYear = (y: number) => {
        years.value = y
    }

    const onRate = (e: InputEvent) => {
        const v = (e.detail as UTSJSONObject).value as string
        rate.value = parseFloat(v) || 0
    }
</script>

<style>
    .calc {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
    }

    .type-switch {
        flex-direction: row;
    }

    .type-text {
        font-size: 12px;
        color: #999;
        padding: 4px 10px;
        border-radius: 14px;
        background-color: #F5F5F5;
        margin-left: 6px;
    }

    .type-text.active {
        color: #FFFFFF;
        background-color: #FF6B35;
    }

    .input-row {
        margin-top: 12px;
    }

    .label {
        font-size: 12px;
        color: #999;
    }

    .input-wrap {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
        border-bottom-width: 1px;
        border-bottom-color: #F0F0F0;
    }

    .input-prefix {
        font-size: 14px;
        color: #FF6B35;
        margin-right: 4px;
    }

    .input {
        flex: 1;
        font-size: 14px;
        color: #333;
        padding: 6px 0;
    }

    .input-suffix {
        font-size: 12px;
        color: #999;
        margin-left: 4px;
    }

    .year-options {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .year-text {
        font-size: 12px;
        color: #666;
        padding: 4px 10px;
        border-radius: 14px;
        background-color: #F5F5F5;
        margin-right: 6px;
        margin-top: 4px;
    }

    .year-text.active {
        color: #FFFFFF;
        background-color: #FF6B35;
    }

    .result-card {
        flex-direction: row;
        background-color: #FFF5F0;
        border-radius: 8px;
        padding: 12px;
        margin-top: 12px;
    }

    .result-cell {
        flex: 1;
        align-items: center;
    }

    .result-divider {
        width: 1px;
        background-color: #FFE0CC;
        margin: 0 4px;
    }

    .result-label {
        font-size: 11px;
        color: #999;
    }

    .result-value {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 700;
        margin-top: 4px;
    }
</style>
