<template>
    <view class="shop-card" @click="onClick">
        <image class="logo" :src="shop.logo" mode="aspectFill" lazy-load="true" v-if="shop.logo.length > 0" />
        <view class="logo-placeholder" v-else>
            <text class="logo-text">{{ shop.name.length > 0 ? shop.name.charAt(0) : '店' }}</text>
        </view>
        <view class="card-main">
            <view class="title-row">
                <text class="name">{{ shop.name }}</text>
                <text class="status" :class="{ open: shop.is_open, closed: !shop.is_open }">{{ shop.is_open ? '营业中' : '休息中' }}</text>
            </view>
            <view class="meta-row">
                <text class="rating" v-if="shop.rating > 0">★ {{ shop.rating }}</text>
                <text class="meta-dot" v-if="shop.rating > 0">·</text>
                <text class="meta">{{ shop.category_name }}</text>
                <text class="meta-dot" v-if="shop.category_name.length > 0">·</text>
                <text class="meta">销量 {{ shop.sales_count }}</text>
            </view>
            <view class="addr-row" v-if="shop.address.length > 0">
                <text class="addr">{{ shop.address }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Shop = {
        id: number
        name: string
        logo: string
        category_name: string
        rating: number
        sales_count: number
        address: string
        is_open: boolean
    }

    const props = withDefaults(defineProps<{
        shop: Shop
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const onClick = () => {
        emit('click', props.shop.id)
    }
</script>

<style>
    .shop-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        flex-direction: row;
        padding: 12px;
        margin-bottom: 10px;
    }

    .logo {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        margin-right: 12px;
    }

    .logo-placeholder {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .logo-text {
        font-size: 26px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .card-main {
        flex: 1;
    }

    .title-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .name {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .status {
        font-size: 11px;
        padding: 1px 6px;
        border-radius: 3px;
        margin-left: 8px;
    }

    .status.open {
        background-color: #E8F8EA;
        color: #07C160;
    }

    .status.closed {
        background-color: #F5F5F5;
        color: #999;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
    }

    .rating {
        font-size: 12px;
        color: #FF6B35;
        font-weight: 600;
    }

    .meta {
        font-size: 12px;
        color: #666;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .addr-row {
        margin-top: 6px;
    }

    .addr {
        font-size: 11px;
        color: #999;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }
</style>
