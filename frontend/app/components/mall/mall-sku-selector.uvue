<template>
    <view class="sku-selector">
        <view class="sku-group" v-for="(group, gIdx) in groups" :key="gIdx">
            <text class="group-title">{{ group.name }}</text>
            <view class="value-list">
                <view class="value-item" v-for="(val, vIdx) in group.values" :key="vIdx"
                    :class="{ active: isSelected(group.key, val) }" @click="onSelect(group.key, val)">
                    <text class="value-text">{{ val }}</text>
                </view>
            </view>
        </view>
        <view class="qty-row">
            <text class="qty-label">数量</text>
            <view class="qty-control">
                <view class="qty-btn" @click="onDecQty">
                    <text class="qty-btn-text">-</text>
                </view>
                <text class="qty-value">{{ quantity }}</text>
                <view class="qty-btn" @click="onIncQty">
                    <text class="qty-btn-text">+</text>
                </view>
            </view>
        </view>
        <view class="bottom-bar">
            <view class="btn-cart" @click="onAddCart">
                <text class="btn-cart-text">加入购物车</text>
            </view>
            <view class="btn-buy" @click="onBuyNow">
                <text class="btn-buy-text">立即购买</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type SkuGroup = {
        key: string
        name: string
        values: string[]
    }

    const props = withDefaults(defineProps<{
        groups: SkuGroup[]
        stock: number
    }>(), {
        groups: [] as SkuGroup[],
        stock: 0
    } as any)

    const emit = defineEmits<{
        (e: 'select', key: string, value: string): void
        (e: 'change-qty', qty: number): void
        (e: 'add-cart'): void
        (e: 'buy-now'): void
    }>()

    const selected = ref({} as UTSJSONObject)
    const quantity = ref(1)

    const isSelected = (key: string, value: string) : boolean => {
        const v = (selected.value[key] as string) ?? ''
        return v == value
    }

    const onSelect = (key: string, value: string) => {
        selected.value[key] = value
        emit('select', key, value)
    }

    const onIncQty = () => {
        if (props.stock > 0 && quantity.value >= props.stock) {
            uni.showToast({ title: '库存不足', icon: 'none' })
            return
        }
        quantity.value++
        emit('change-qty', quantity.value)
    }

    const onDecQty = () => {
        if (quantity.value <= 1) return
        quantity.value--
        emit('change-qty', quantity.value)
    }

    const onAddCart = () => {
        emit('add-cart')
    }

    const onBuyNow = () => {
        emit('buy-now')
    }
</script>

