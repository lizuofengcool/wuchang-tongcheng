    .sku-selector {
        background-color: #FFFFFF;
        padding: 12px 16px;
    }

    .sku-group {
        margin-bottom: 12px;
    }

    .group-title {
        font-size: 14px;
        color: #333;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .value-list {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .value-item {
        background-color: #F5F5F5;
        border-radius: 4px;
        padding: 6px 12px;
        margin-right: 8px;
        margin-top: 8px;
        border-width: 1px;
        border-color: #F5F5F5;
    }

    .value-item.active {
        background-color: #FFF5F0;
        border-color: #FF6B35;
    }

    .value-text {
        font-size: 13px;
        color: #333;
    }

    .value-item.active .value-text {
        color: #FF6B35;
    }

    .qty-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .qty-label {
        font-size: 14px;
        color: #333;
        font-weight: 600;
    }

    .qty-control {
        flex-direction: row;
        align-items: center;
    }

    .qty-btn {
        width: 28px;
        height: 28px;
        background-color: #F5F5F5;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    .qty-btn-text {
        font-size: 16px;
        color: #333;
    }

    .qty-value {
        font-size: 14px;
        color: #333;
        margin: 0 16px;
    }

    .bottom-bar {
        flex-direction: row;
        margin-top: 12px;
    }

    .btn-cart {
        flex: 1;
        height: 44px;
        border-radius: 22px 0 0 22px;
        background-color: #FFB340;
        align-items: center;
        justify-content: center;
    }

    .btn-cart-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .btn-buy {
        flex: 1;
        height: 44px;
        border-radius: 0 22px 22px 0;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .btn-buy-text {
        font-size: 14px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
