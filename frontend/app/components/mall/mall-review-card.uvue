<template>
    <view class="review-card">
        <view class="user-row">
            <image class="avatar" :src="review.user_avatar" mode="aspectFill" lazy-load="true" v-if="review.user_avatar.length > 0" />
            <view class="avatar-placeholder" v-else>
                <text class="avatar-text">{{ review.user_name.length > 0 ? review.user_name.charAt(0) : '匿' }}</text>
            </view>
            <view class="user-info">
                <text class="user-name">{{ review.user_name }}</text>
                <view class="rating-row">
                    <text class="rating">{{ starText }}</text>
                    <text class="time">{{ review.created_at }}</text>
                </view>
            </view>
        </view>
        <view class="sku-row" v-if="review.sku_name.length > 0">
            <text class="sku-text">{{ review.sku_name }}</text>
        </view>
        <view class="content-row" v-if="review.content.length > 0">
            <text class="content">{{ review.content }}</text>
        </view>
        <view class="image-row" v-if="review.images.length > 0">
            <image class="review-img" v-for="(img, idx) in review.images" :key="idx" :src="img" mode="aspectFill" lazy-load="true" @click="onPreviewImage(idx)" />
        </view>
        <view class="reply-row" v-if="review.reply_content.length > 0">
            <text class="reply-label">商家回复：</text>
            <text class="reply-text">{{ review.reply_content }}</text>
        </view>
        <view class="action-row">
            <view class="action-item" @click="onLike">
                <text class="action-icon">{{ review.is_liked ? '❤' : '♡' }}</text>
                <text class="action-text">{{ review.like_count }}</text>
            </view>
            <view class="action-item" @click="onDislike">
                <text class="action-icon">{{ review.is_disliked ? '👍' : '👍🏻' }}</text>
                <text class="action-text">{{ review.dislike_count }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Review = {
        id: number
        user_name: string
        user_avatar: string
        rating: number
        content: string
        images: string[]
        sku_name: string
        reply_content: string
        like_count: number
        dislike_count: number
        is_liked: boolean
        is_disliked: boolean
        created_at: string
    }

    const props = withDefaults(defineProps<{
        review: Review
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'like', id: number): void
        (e: 'dislike', id: number): void
    }>()

    const starText = computed(() : string => {
        const s = '★★★★★'
        return s.substring(0, props.review.rating)
    })

    const onPreviewImage = (idx: number) => {
        uni.previewImage({
            urls: props.review.images,
            current: props.review.images[idx]
        })
    }

    const onLike = () => {
        emit('like', props.review.id)
    }

    const onDislike = () => {
        emit('dislike', props.review.id)
    }
</script>

<style>
    .review-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .user-row {
        flex-direction: row;
        align-items: center;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        margin-right: 8px;
    }

    .avatar-placeholder {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
    }

    .avatar-text {
        font-size: 16px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .user-info {
        flex: 1;
    }

    .user-name {
        font-size: 14px;
        color: #333;
        font-weight: 600;
    }

    .rating-row {
        flex-direction: row;
        align-items: center;
        margin-top: 2px;
    }

    .rating {
        font-size: 12px;
        color: #FF6B35;
        flex: 1;
    }

    .time {
        font-size: 11px;
        color: #BBB;
    }

    .sku-row {
        margin-top: 6px;
    }

    .sku-text {
        font-size: 12px;
        color: #999;
        background-color: #F5F5F5;
        padding: 2px 6px;
        border-radius: 3px;
    }

    .content-row {
        margin-top: 8px;
    }

    .content {
        font-size: 13px;
        color: #333;
        line-height: 1.6;
    }

    .image-row {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .review-img {
        width: 80px;
        height: 80px;
        border-radius: 6px;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .reply-row {
        background-color: #F9F9F9;
        border-radius: 8px;
        padding: 8px;
        margin-top: 8px;
        flex-direction: row;
    }

    .reply-label {
        font-size: 12px;
        color: #FF6B35;
        font-weight: 600;
    }

    .reply-text {
        font-size: 12px;
        color: #666;
        flex: 1;
    }

    .action-row {
        flex-direction: row;
        justify-content: flex-end;
        margin-top: 8px;
        padding-top: 8px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .action-item {
        flex-direction: row;
        align-items: center;
        margin-left: 16px;
    }

    .action-icon {
        font-size: 14px;
        color: #999;
        margin-right: 4px;
    }

    .action-text {
        font-size: 12px;
        color: #999;
    }
</style>
