<template>
    <view class="driver-card" @click="onClick">
        <view class="card-main">
            <view class="header-row">
                <image class="avatar" :src="driver.avatar" mode="aspectFill" lazy-load="true" v-if="driver.avatar.length > 0" />
                <view class="avatar-placeholder" v-else>
                    <text class="avatar-text">{{ driver.name.length > 0 ? driver.name.charAt(0) : 'D' }}</text>
                </view>
                <view class="info">
                    <view class="name-row">
                        <text class="name">{{ driver.name }}</text>
                        <view class="verify-tag" v-if="driver.is_verified">
                            <text class="verify-text">✓ 已认证</text>
                        </view>
                    </view>
                    <view class="rating-row">
                        <text class="rating">★ {{ driver.rating }}</text>
                        <text class="dot">·</text>
                        <text class="trip-count">{{ driver.trip_count }}次行程</text>
                        <text class="dot">·</text>
                        <text class="vehicle-count">{{ driver.vehicle_count }}辆车</text>
                    </view>
                </view>
            </view>
            <view class="meta-row" v-if="driver.license_plate.length > 0">
                <text class="meta">车牌：{{ driver.license_plate }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ driver.vehicle_model }}</text>
            </view>
            <view class="status-row" v-if="driver.status.length > 0">
                <view class="status-tag" :class="driver.status">
                    <text class="status-text">{{ statusText }}</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Driver = {
        id: number
        name: string
        avatar: string
        rating: number
        trip_count: number
        vehicle_count: number
        is_verified: boolean
        license_plate: string
        vehicle_model: string
        status: string
    }

    const props = withDefaults(defineProps<{
        driver: Driver
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const statusText = computed(() : string => {
        const s = props.driver.status
        if (s == 'pending') return '审核中'
        if (s == 'approved') return '已通过'
        if (s == 'rejected') return '已拒绝'
        if (s == 'frozen') return '已冻结'
        return s
    })

    const onClick = () => {
        emit('click', props.driver.id)
    }
</script>

<style>
    .driver-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .card-main {
        flex: 1;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
    }

    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        margin-right: 12px;
    }

    .avatar-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .avatar-text {
        font-size: 20px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .info {
        flex: 1;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
    }

    .name {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-right: 8px;
    }

    .verify-tag {
        background-color: #E5F8FF;
        border-radius: 3px;
        padding: 1px 5px;
    }

    .verify-text {
        font-size: 10px;
        color: #1989FA;
    }

    .rating-row {
        flex-direction: row;
        align-items: center;
        margin-top: 4px;
    }

    .rating {
        font-size: 12px;
        color: #FF6B35;
        font-weight: 600;
    }

    .dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .trip-count, .vehicle-count {
        font-size: 12px;
        color: #666;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
        padding-top: 8px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .meta {
        font-size: 12px;
        color: #666;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .status-row {
        margin-top: 8px;
    }

    .status-tag {
        align-self: flex-start;
        border-radius: 3px;
        padding: 2px 8px;
    }

    .status-tag.pending {
        background-color: #FFF5E5;
    }

    .status-tag.approved {
        background-color: #E5F8FF;
    }

    .status-tag.rejected {
        background-color: #FFE5E5;
    }

    .status-tag.frozen {
        background-color: #F0F0F0;
    }

    .status-text {
        font-size: 11px;
    }

    .status-tag.pending .status-text {
        color: #FF9900;
    }

    .status-tag.approved .status-text {
        color: #1989FA;
    }

    .status-tag.rejected .status-text {
        color: #EE0A24;
    }

    .status-tag.frozen .status-text {
        color: #999;
    }
</style>
