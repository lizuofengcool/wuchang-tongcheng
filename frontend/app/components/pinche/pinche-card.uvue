<template>
    <view class="pinche-card" @click="onClick">
        <view class="card-main">
            <view class="route-row">
                <view class="route-points">
                    <view class="point start">
                        <view class="point-dot start-dot"></view>
                        <text class="point-text">{{ pinche.origin }}</text>
                    </view>
                    <view class="route-line"></view>
                    <view class="point end">
                        <view class="point-dot end-dot"></view>
                        <text class="point-text">{{ pinche.destination }}</text>
                    </view>
                </view>
                <text class="price">¥{{ pinche.price }}</text>
            </view>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx" :class="t.type">
                    <text class="tag-text">{{ t.text }}</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="meta">🕒 {{ pinche.departure_time }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ pinche.seats_available }}座可预订</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ pinche.vehicle_model }}</text>
            </view>
            <view class="driver-row">
                <image class="avatar" :src="pinche.driver_avatar" mode="aspectFill" lazy-load="true" v-if="pinche.driver_avatar.length > 0" />
                <view class="avatar-placeholder" v-else>
                    <text class="avatar-text">{{ pinche.driver_name.length > 0 ? pinche.driver_name.charAt(0) : 'D' }}</text>
                </view>
                <text class="driver-name">{{ pinche.driver_name }}</text>
                <text class="rating" v-if="pinche.driver_rating > 0">★ {{ pinche.driver_rating }}</text>
                <text class="stats">{{ pinche.view_count }}浏览</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Tag = { text: string, type: string }

    type Pinche = {
        id: number
        origin: string
        destination: string
        departure_time: string
        price: number
        seats_available: number
        vehicle_model: string
        driver_name: string
        driver_avatar: string
        driver_rating: number
        view_count: number
        is_urgent: boolean
        is_hot: boolean
        is_verified: boolean
    }

    const props = withDefaults(defineProps<{
        pinche: Pinche
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const tags = computed(() : Tag[] => {
        const list = [] as Tag[]
        if (props.pinche.is_urgent) list.push({ text: '急', type: 'urgent' } as Tag)
        if (props.pinche.is_hot) list.push({ text: '热', type: 'hot' } as Tag)
        if (props.pinche.is_verified) list.push({ text: '认证', type: 'verified' } as Tag)
        return list
    })

    const onClick = () => {
        emit('click', props.pinche.id)
    }
</script>

<style>
    .pinche-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .card-main {
        flex: 1;
    }

    .route-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .route-points {
        flex: 1;
        flex-direction: column;
    }

    .point {
        flex-direction: row;
        align-items: center;
    }

    .point-dot {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        margin-right: 8px;
    }

    .start-dot {
        background-color: #07C160;
    }

    .end-dot {
        background-color: #FF6B35;
    }

    .point-text {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .route-line {
        width: 1px;
        height: 16px;
        background-color: #DDD;
        margin-left: 3px;
        margin-top: 2px;
        margin-bottom: 2px;
    }

    .price {
        font-size: 16px;
        color: #FF6B35;
        font-weight: 600;
        margin-left: 8px;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 6px;
    }

    .tag {
        border-radius: 3px;
        padding: 1px 5px;
        margin-right: 4px;
    }

    .tag.urgent {
        background-color: #FFE5E5;
    }

    .tag.hot {
        background-color: #FFF5F0;
    }

    .tag.verified {
        background-color: #E5F8FF;
    }

    .tag-text {
        font-size: 10px;
    }

    .tag.urgent .tag-text {
        color: #EE0A24;
    }

    .tag.hot .tag-text {
        color: #FF6B35;
    }

    .tag.verified .tag-text {
        color: #1989FA;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
        flex-wrap: wrap;
    }

    .meta {
        font-size: 12px;
        color: #666;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .driver-row {
        flex-direction: row;
        align-items: center;
        margin-top: 10px;
        padding-top: 10px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .avatar {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        margin-right: 6px;
    }

    .avatar-placeholder {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 6px;
    }

    .avatar-text {
        font-size: 11px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .driver-name {
        font-size: 12px;
        color: #666;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .rating {
        font-size: 11px;
        color: #FF6B35;
        margin-right: 8px;
    }

    .stats {
        font-size: 11px;
        color: #BBB;
    }
</style>
