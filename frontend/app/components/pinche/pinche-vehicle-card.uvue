<template>
    <view class="vehicle-card" @click="onClick">
        <view class="card-main">
            <view class="header-row">
                <view class="vehicle-icon">
                    <text class="icon-text">🚗</text>
                </view>
                <view class="info">
                    <view class="title-row">
                        <text class="model">{{ vehicle.model }}</text>
                        <view class="default-tag" v-if="vehicle.is_default">
                            <text class="default-text">默认</text>
                        </view>
                    </view>
                    <text class="plate">{{ vehicle.license_plate }}</text>
                </view>
            </view>
            <view class="meta-row">
                <view class="meta-item">
                    <text class="meta-label">座位</text>
                    <text class="meta-value">{{ vehicle.seats }}座</text>
                </view>
                <view class="meta-item">
                    <text class="meta-label">颜色</text>
                    <text class="meta-value">{{ vehicle.color }}</text>
                </view>
                <view class="meta-item" v-if="vehicle.year > 0">
                    <text class="meta-label">年份</text>
                    <text class="meta-value">{{ vehicle.year }}</text>
                </view>
            </view>
            <view class="status-row" v-if="vehicle.status.length > 0">
                <view class="status-tag" :class="vehicle.status">
                    <text class="status-text">{{ statusText }}</text>
                </view>
            </view>
            <view class="action-row" v-if="showActions">
                <view class="action-btn default-btn" v-if="!vehicle.is_default" @click.stop="onSetDefault">
                    <text class="action-text">设为默认</text>
                </view>
                <view class="action-btn edit-btn" @click.stop="onEdit">
                    <text class="action-text">编辑</text>
                </view>
                <view class="action-btn delete-btn" @click.stop="onDelete">
                    <text class="action-text-danger">删除</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Vehicle = {
        id: number
        model: string
        license_plate: string
        seats: number
        color: string
        year: number
        is_default: boolean
        status: string
    }

    const props = withDefaults(defineProps<{
        vehicle: Vehicle
        showActions?: boolean
    }>(), {
        showActions: false
    } as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
        (e: 'setDefault', id: number): void
        (e: 'edit', id: number): void
        (e: 'delete', id: number): void
    }>()

    const statusText = computed(() : string => {
        const s = props.vehicle.status
        if (s == 'pending') return '审核中'
        if (s == 'approved') return '已通过'
        if (s == 'rejected') return '已拒绝'
        return s
    })

    const onClick = () => {
        emit('click', props.vehicle.id)
    }

    const onSetDefault = () => {
        emit('setDefault', props.vehicle.id)
    }

    const onEdit = () => {
        emit('edit', props.vehicle.id)
    }

    const onDelete = () => {
        emit('delete', props.vehicle.id)
    }
</script>

<style>
    .vehicle-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .card-main {
        flex: 1;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
    }

    .vehicle-icon {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background-color: #FFF5F0;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .icon-text {
        font-size: 24px;
    }

    .info {
        flex: 1;
    }

    .title-row {
        flex-direction: row;
        align-items: center;
    }

    .model {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        margin-right: 8px;
    }

    .default-tag {
        background-color: #FF6B35;
        border-radius: 3px;
        padding: 1px 5px;
    }

    .default-text {
        font-size: 10px;
        color: #FFFFFF;
    }

    .plate {
        font-size: 13px;
        color: #666;
        margin-top: 4px;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 10px;
        padding-top: 10px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .meta-item {
        flex: 1;
        flex-direction: column;
    }

    .meta-label {
        font-size: 11px;
        color: #999;
    }

    .meta-value {
        font-size: 13px;
        color: #333;
        margin-top: 2px;
    }

    .status-row {
        margin-top: 8px;
    }

    .status-tag {
        align-self: flex-start;
        border-radius: 3px;
        padding: 2px 8px;
    }

    .status-tag.pending {
        background-color: #FFF5E5;
    }

    .status-tag.approved {
        background-color: #E5F8FF;
    }

    .status-tag.rejected {
        background-color: #FFE5E5;
    }

    .status-text {
        font-size: 11px;
    }

    .status-tag.pending .status-text {
        color: #FF9900;
    }

    .status-tag.approved .status-text {
        color: #1989FA;
    }

    .status-tag.rejected .status-text {
        color: #EE0A24;
    }

    .action-row {
        flex-direction: row;
        margin-top: 10px;
        padding-top: 10px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .action-btn {
        flex: 1;
        align-items: center;
        justify-content: center;
        padding: 6px 0;
        margin-right: 8px;
        border-radius: 14px;
        border-width: 1px;
        border-color: #DDD;
    }

    .default-btn {
        background-color: #FF6B35;
        border-color: #FF6B35;
    }

    .default-btn .action-text {
        color: #FFFFFF;
    }

    .edit-btn .action-text {
        color: #666;
    }

    .delete-btn {
        border-color: #EE0A24;
    }

    .action-text {
        font-size: 12px;
        color: #666;
    }

    .action-text-danger {
        font-size: 12px;
        color: #EE0A24;
    }
</style>
