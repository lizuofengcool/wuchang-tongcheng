<template>
    <view class="love-card" @click="onClick">
        <image class="avatar" :src="love.avatar" mode="aspectFill" lazy-load="true" v-if="love.avatar.length > 0" />
        <view class="avatar-placeholder" v-else>
            <text class="avatar-text">{{ love.nickname.length > 0 ? love.nickname.charAt(0) : 'U' }}</text>
        </view>
        <view class="card-main">
            <view class="title-row">
                <text class="nickname">{{ love.nickname }}</text>
                <view class="age-badge" :class="{ male: love.gender == 'male', female: love.gender == 'female' }">
                    <text class="age-text">{{ love.age }}岁</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="meta">{{ love.city }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ love.height > 0 ? love.height + 'cm' : '未填' }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ love.occupation.length > 0 ? love.occupation : '未填' }}</text>
            </view>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx">
                    <text class="tag-text">{{ t }}</text>
                </view>
            </view>
            <view class="footer-row">
                <text class="sign">{{ love.signature.length > 0 ? love.signature : '这个人很懒，什么都没留下' }}</text>
            </view>
            <view class="action-row">
                <view class="action-btn dislike" @click.stop="onDislike">
                    <text class="action-icon">✕</text>
                </view>
                <view class="action-btn like" @click.stop="onLike">
                    <text class="action-icon">♥</text>
                </view>
                <view class="action-btn super-like" @click.stop="onSuperLike">
                    <text class="action-icon">★</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Love = {
        id: number
        nickname: string
        avatar: string
        gender: string
        age: number
        city: string
        height: number
        occupation: string
        signature: string
        tags: string[]
        is_verified: boolean
        is_vip: boolean
    }

    const props = withDefaults(defineProps<{
        love: Love
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
        (e: 'like', id: number): void
        (e: 'dislike', id: number): void
        (e: 'superlike', id: number): void
    }>()

    const tags = computed(() : string[] => {
        return props.love.tags ?? ([] as string[])
    })

    const onClick = () => {
        emit('click', props.love.id)
    }

    const onLike = () => {
        emit('like', props.love.id)
    }

    const onDislike = () => {
        emit('dislike', props.love.id)
    }

    const onSuperLike = () => {
        emit('superlike', props.love.id)
    }
</script>

<style>
    .love-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
        flex-direction: row;
    }

    .avatar {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        margin-right: 12px;
    }

    .avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .avatar-text {
        font-size: 32px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .card-main {
        flex: 1;
    }

    .title-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .nickname {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .age-badge {
        background-color: #FF6B35;
        border-radius: 10px;
        padding: 1px 8px;
        margin-left: 8px;
    }

    .age-badge.male {
        background-color: #1989FA;
    }

    .age-badge.female {
        background-color: #FF6B35;
    }

    .age-text {
        font-size: 11px;
        color: #FFFFFF;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
    }

    .meta {
        font-size: 12px;
        color: #666;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .tag-row {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 6px;
    }

    .tag {
        background-color: #FFF5F0;
        border-radius: 3px;
        padding: 1px 6px;
        margin-right: 4px;
        margin-top: 4px;
    }

    .tag-text {
        font-size: 10px;
        color: #FF6B35;
    }

    .footer-row {
        margin-top: 6px;
    }

    .sign {
        font-size: 12px;
        color: #999;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .action-row {
        flex-direction: row;
        justify-content: flex-end;
        margin-top: 8px;
        padding-top: 8px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .action-btn {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        align-items: center;
        justify-content: center;
        margin-left: 10px;
    }

    .action-btn.dislike {
        background-color: #F5F5F5;
    }

    .action-btn.like {
        background-color: #FFE5E5;
    }

    .action-btn.super-like {
        background-color: #FFF5F0;
    }

    .action-icon {
        font-size: 14px;
    }

    .action-btn.dislike .action-icon {
        color: #999;
    }

    .action-btn.like .action-icon {
        color: #EE0A24;
    }

    .action-btn.super-like .action-icon {
        color: #FF6B35;
    }
</style>
