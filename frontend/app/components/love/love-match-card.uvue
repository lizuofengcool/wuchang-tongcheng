<template>
    <view class="match-card" @click="onClick">
        <image class="cover" :src="profile.avatar" mode="aspectFill" lazy-load="true" v-if="profile.avatar.length > 0" />
        <view class="cover-placeholder" v-else>
            <text class="cover-text">{{ profile.nickname.length > 0 ? profile.nickname.charAt(0) : 'U' }}</text>
        </view>
        <view class="cover-mask"></view>
        <view class="top-actions">
            <view class="action-btn pass" @click.stop="onPass">
                <text class="action-icon">✕</text>
            </view>
            <view class="action-btn like" @click.stop="onLike">
                <text class="action-icon">♥</text>
            </view>
            <view class="action-btn super" @click.stop="onSuper">
                <text class="action-icon">★</text>
            </view>
        </view>
        <view class="info">
            <view class="name-row">
                <text class="nickname">{{ profile.nickname }}</text>
                <view class="age-badge" :class="{ male: profile.gender == 'male', female: profile.gender == 'female' }">
                    <text class="age-text">{{ profile.age }}岁</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="meta">{{ profile.city }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ profile.height > 0 ? profile.height + 'cm' : '未填' }}</text>
                <text class="meta-dot">·</text>
                <text class="meta">{{ profile.occupation.length > 0 ? profile.occupation : '未填' }}</text>
            </view>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx">
                    <text class="tag-text">{{ t }}</text>
                </view>
            </view>
            <view class="sign-row" v-if="profile.signature.length > 0">
                <text class="sign">{{ profile.signature }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Profile = {
        id: number
        nickname: string
        avatar: string
        gender: string
        age: number
        city: string
        height: number
        occupation: string
        signature: string
        tags: string[]
    }

    const props = withDefaults(defineProps<{
        profile: Profile
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
        (e: 'pass', id: number): void
        (e: 'like', id: number): void
        (e: 'super', id: number): void
    }>()

    const tags = computed(() : string[] => {
        return props.profile.tags ?? ([] as string[])
    })

    const onClick = () => {
        emit('click', props.profile.id)
    }

    const onPass = () => {
        emit('pass', props.profile.id)
    }

    const onLike = () => {
        emit('like', props.profile.id)
    }

    const onSuper = () => {
        emit('super', props.profile.id)
    }
</script>

<style>
    .match-card {
        width: 100%;
        background-color: #FFFFFF;
        border-radius: 16px;
        overflow: hidden;
        position: relative;
    }

    .cover {
        width: 100%;
        height: 420px;
    }

    .cover-placeholder {
        width: 100%;
        height: 420px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .cover-text {
        font-size: 80px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .cover-mask {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 220px;
        background: linear-gradient(to top, rgba(0,0,0,0.7), rgba(0,0,0,0));
    }

    .top-actions {
        position: absolute;
        top: 12px;
        right: 12px;
        flex-direction: row;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background-color: rgba(255, 255, 255, 0.85);
        align-items: center;
        justify-content: center;
        margin-left: 8px;
    }

    .action-icon {
        font-size: 16px;
    }

    .action-btn.pass .action-icon {
        color: #999;
    }

    .action-btn.like .action-icon {
        color: #EE0A24;
    }

    .action-btn.super .action-icon {
        color: #FF6B35;
    }

    .info {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 16px;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
    }

    .nickname {
        font-size: 20px;
        color: #FFFFFF;
        font-weight: 700;
        margin-right: 8px;
    }

    .age-badge {
        background-color: #FF6B35;
        border-radius: 12px;
        padding: 2px 8px;
    }

    .age-badge.male {
        background-color: #1989FA;
    }

    .age-badge.female {
        background-color: #FF6B35;
    }

    .age-text {
        font-size: 12px;
        color: #FFFFFF;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 6px;
    }

    .meta {
        font-size: 13px;
        color: #EEEEEE;
    }

    .meta-dot {
        font-size: 13px;
        color: #CCCCCC;
        margin: 0 6px;
    }

    .tag-row {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .tag {
        background-color: rgba(255, 107, 53, 0.85);
        border-radius: 4px;
        padding: 2px 8px;
        margin-right: 6px;
        margin-top: 4px;
    }

    .tag-text {
        font-size: 11px;
        color: #FFFFFF;
    }

    .sign-row {
        margin-top: 8px;
    }

    .sign {
        font-size: 12px;
        color: #DDDDDD;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }
</style>
