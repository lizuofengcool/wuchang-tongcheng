<template>
    <view class="header">
        <view class="bg-wrap">
            <image class="bg" :src="profile.avatar" mode="aspectFill" lazy-load="true" v-if="profile.avatar.length > 0" />
            <view class="bg-mask"></view>
        </view>
        <view class="info-wrap">
            <image class="avatar" :src="profile.avatar" mode="aspectFill" lazy-load="true" v-if="profile.avatar.length > 0" />
            <view class="avatar-placeholder" v-else>
                <text class="avatar-text">{{ profile.nickname.length > 0 ? profile.nickname.charAt(0) : 'U' }}</text>
            </view>
            <view class="main-info">
                <view class="name-row">
                    <text class="nickname">{{ profile.nickname }}</text>
                    <love-verify-badge :status="profile.verify_status" :size="'small'" />
                    <love-member-badge :level="profile.member_level" :size="'small'" />
                </view>
                <view class="meta-row">
                    <view class="age-badge" :class="{ male: profile.gender == 'male', female: profile.gender == 'female' }">
                        <text class="age-text">{{ profile.age }}岁</text>
                    </view>
                    <text class="meta">{{ profile.city }}</text>
                    <text class="meta-dot">·</text>
                    <text class="meta">{{ profile.height > 0 ? profile.height + 'cm' : '未填' }}</text>
                    <text class="meta-dot">·</text>
                    <text class="meta">{{ profile.occupation.length > 0 ? profile.occupation : '未填' }}</text>
                </view>
                <view class="stats-row">
                    <view class="stat-item">
                        <text class="stat-num">{{ profile.view_count }}</text>
                        <text class="stat-label">浏览</text>
                    </view>
                    <view class="stat-item">
                        <text class="stat-num">{{ profile.like_count }}</text>
                        <text class="stat-label">喜欢</text>
                    </view>
                    <view class="stat-item">
                        <text class="stat-num">{{ profile.match_count }}</text>
                        <text class="stat-label">匹配</text>
                    </view>
                </view>
            </view>
        </view>
        <view class="signature-row" v-if="profile.signature.length > 0">
            <text class="signature">{{ profile.signature }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Profile = {
        id: number
        nickname: string
        avatar: string
        gender: string
        age: number
        city: string
        height: number
        occupation: string
        signature: string
        verify_status: string
        member_level: string
        view_count: number
        like_count: number
        match_count: number
    }

    withDefaults(defineProps<{
        profile: Profile
    }>(), {} as any)
</script>

