<template>
    <view class="msg-item" :class="{ mine: isMine }">
        <image class="avatar" :src="message.avatar" mode="aspectFill" lazy-load="true" v-if="message.avatar.length > 0" />
        <view class="avatar-placeholder" v-else>
            <text class="avatar-text">{{ message.sender_name.length > 0 ? message.sender_name.charAt(0) : 'U' }}</text>
        </view>
        <view class="bubble-wrap">
            <text class="sender" v-if="!isMine && showSender">{{ message.sender_name }}</text>
            <view class="bubble">
                <text class="content">{{ message.content }}</text>
            </view>
            <text class="time">{{ message.time }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Message = {
        id: number
        sender_id: number
        sender_name: string
        avatar: string
        content: string
        time: string
        is_read: boolean
    }

    const props = withDefaults(defineProps<{
        message: Message
        isMine: boolean
        showSender: boolean
    }>(), {
        isMine: false,
        showSender: false
    } as any)
</script>

