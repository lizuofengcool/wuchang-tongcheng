<template>
    <view class="header">
        <text class="title">{{ job.title }}</text>
        <view class="salary-row">
            <text class="salary-symbol">¥</text>
            <text class="salary-value">{{ job.salary_range }}</text>
            <text class="salary-unit">/月</text>
        </view>
        <view class="tag-row" v-if="tags.length > 0">
            <view class="tag" v-for="(t, idx) in tags" :key="idx" :class="t.type">
                <text class="tag-text">{{ t.text }}</text>
            </view>
        </view>
        <view class="meta-row">
            <text class="meta">{{ job.city }}</text>
            <text class="meta-dot">·</text>
            <text class="meta">{{ job.experience }}</text>
            <text class="meta-dot">·</text>
            <text class="meta">{{ job.education }}</text>
        </view>
        <view class="stats-row" v-if="job.view_count > 0 || job.fav_count > 0">
            <text class="stat" v-if="job.view_count > 0">浏览 {{ job.view_count }}</text>
            <text class="stat" v-if="job.fav_count > 0">收藏 {{ job.fav_count }}</text>
            <text class="stat" v-if="job.application_count > 0">投递 {{ job.application_count }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Tag = { text: string, type: string }
    type Job = {
        id: number
        title: string
        salary_range: string
        city: string
        experience: string
        education: string
        view_count: number
        fav_count: number
        application_count: number
        is_urgent: boolean
        is_hot: boolean
        is_remote: boolean
    }

    const props = withDefaults(defineProps<{
        job: Job
    }>(), {} as any)

    const tags = computed(() : Tag[] => {
        const list = [] as Tag[]
        if (props.job.is_urgent) list.push({ text: '⚡急招', type: 'urgent' } as Tag)
        if (props.job.is_hot) list.push({ text: '🔥热门', type: 'hot' } as Tag)
        if (props.job.is_remote) list.push({ text: '🏠远程', type: 'remote' } as Tag)
        return list
    })
</script>

<style>
    .header {
        background-color: #FFFFFF;
        padding: 16px;
    }

    .title {
        font-size: 18px;
        color: #333;
        font-weight: 700;
        line-height: 1.4;
    }

    .salary-row {
        flex-direction: row;
        align-items: baseline;
        margin-top: 10px;
    }

    .salary-symbol {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 600;
    }

    .salary-value {
        font-size: 24px;
        color: #FF6B35;
        font-weight: 700;
        margin-left: 2px;
    }

    .salary-unit {
        font-size: 12px;
        color: #FF6B35;
        margin-left: 2px;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 10px;
    }

    .tag {
        border-radius: 4px;
        padding: 2px 6px;
        margin-right: 6px;
    }

    .tag.urgent {
        background-color: #FFE5E5;
    }

    .tag.hot {
        background-color: #FFF5F0;
    }

    .tag.remote {
        background-color: #E5F8FF;
    }

    .tag-text {
        font-size: 11px;
    }

    .tag.urgent .tag-text {
        color: #EE0A24;
    }

    .tag.hot .tag-text {
        color: #FF6B35;
    }

    .tag.remote .tag-text {
        color: #1989FA;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 10px;
    }

    .meta {
        font-size: 13px;
        color: #666;
    }

    .meta-dot {
        font-size: 13px;
        color: #CCC;
        margin: 0 8px;
    }

    .stats-row {
        flex-direction: row;
        margin-top: 8px;
    }

    .stat {
        font-size: 11px;
        color: #BBB;
        margin-right: 12px;
    }
</style>
