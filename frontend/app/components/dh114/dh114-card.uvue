<template>
    <view class="dh114-card" @click="onClick">
        <image class="cover" :src="business.cover_image" mode="aspectFill" lazy-load="true" v-if="business.cover_image.length > 0" />
        <view class="cover-placeholder" v-else>
            <text class="cover-text">{{ business.name.length > 0 ? business.name.charAt(0) : '商' }}</text>
        </view>
        <view class="card-main">
            <view class="title-row">
                <text class="title">{{ business.name }}</text>
                <text class="price" v-if="business.avg_price > 0">¥{{ business.avg_price }}/人</text>
            </view>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx" :class="t.type">
                    <text class="tag-text">{{ t.text }}</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="rating" v-if="business.rating > 0">★ {{ business.rating }}</text>
                <text class="meta-dot" v-if="business.rating > 0">·</text>
                <text class="meta">{{ business.category_name }}</text>
                <text class="meta-dot" v-if="business.category_name.length > 0">·</text>
                <text class="meta">{{ business.distance }}</text>
            </view>
            <view class="addr-row" v-if="business.address.length > 0">
                <text class="addr">{{ business.address }}</text>
                <text class="stats">{{ business.view_count }}浏览</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Tag = { text: string, type: string }

    type Business = {
        id: number
        name: string
        cover_image: string
        category_name: string
        rating: number
        avg_price: number
        distance: string
        address: string
        view_count: number
        is_verified: boolean
        is_hot: boolean
        is_open: boolean
    }

    const props = withDefaults(defineProps<{
        business: Business
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const tags = computed(() : Tag[] => {
        const list = [] as Tag[]
        if (props.business.is_verified) list.push({ text: '认证', type: 'verified' } as Tag)
        if (props.business.is_hot) list.push({ text: '热门', type: 'hot' } as Tag)
        if (props.business.is_open) {
            list.push({ text: '营业中', type: 'open' } as Tag)
        } else {
            list.push({ text: '休息中', type: 'closed' } as Tag)
        }
        return list
    })

    const onClick = () => {
        emit('click', props.business.id)
    }
</script>

<style>
    .dh114-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        flex-direction: row;
        padding: 12px;
        margin-bottom: 10px;
    }

    .cover {
        width: 90px;
        height: 90px;
        border-radius: 8px;
        margin-right: 12px;
    }

    .cover-placeholder {
        width: 90px;
        height: 90px;
        border-radius: 8px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
        margin-right: 12px;
    }

    .cover-text {
        font-size: 32px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .card-main {
        flex: 1;
    }

    .title-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        flex: 1;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .price {
        font-size: 13px;
        color: #FF6B35;
        font-weight: 600;
        margin-left: 8px;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 6px;
    }

    .tag {
        border-radius: 3px;
        padding: 1px 5px;
        margin-right: 4px;
    }

    .tag.verified {
        background-color: #E5F8FF;
    }

    .tag.hot {
        background-color: #FFF5F0;
    }

    .tag.open {
        background-color: #E8F8EA;
    }

    .tag.closed {
        background-color: #F5F5F5;
    }

    .tag-text {
        font-size: 10px;
    }

    .tag.verified .tag-text {
        color: #1989FA;
    }

    .tag.hot .tag-text {
        color: #FF6B35;
    }

    .tag.open .tag-text {
        color: #07C160;
    }

    .tag.closed .tag-text {
        color: #999;
    }

    .meta-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
    }

    .rating {
        font-size: 12px;
        color: #FF6B35;
        font-weight: 600;
    }

    .meta {
        font-size: 12px;
        color: #666;
    }

    .meta-dot {
        font-size: 12px;
        color: #CCC;
        margin: 0 6px;
    }

    .addr-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 8px;
    }

    .addr {
        flex: 1;
        font-size: 11px;
        color: #999;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .stats {
        font-size: 11px;
        color: #BBB;
        margin-left: 8px;
    }
</style>
