        margin-right: 8px;
    }

    .level-badge {
        background-color: rgba(255, 255, 255, 0.25);
        border-radius: 10px;
        padding: 2px 8px;
    }

    .level-text {
        font-size: 11px;
        color: #FFFFFF;
    }

    .meta-row {
        flex-direction: row;
