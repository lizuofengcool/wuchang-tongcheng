    .avatar-text {
        font-size: 24px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .info {
        flex: 1;
    }

    .name-row {
        flex-direction: row;
        align-items: center;
    }

    .name {
        font-size: 18px;
