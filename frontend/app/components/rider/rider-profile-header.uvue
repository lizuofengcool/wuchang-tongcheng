<template>
    <view class="profile-header">
        <view class="avatar-wrap">
            <image class="avatar" :src="rider.avatar" mode="aspectFill" lazy-load="true" v-if="rider.avatar.length > 0" />
            <view class="avatar-placeholder" v-else>
                <text class="avatar-text">{{ rider.name.length > 0 ? rider.name.charAt(0) : '骑' }}</text>
            </view>
        </view>
        <view class="info">
            <view class="name-row">
                <text class="name">{{ rider.name }}</text>
                <view class="level-badge" v-if="rider.level.length > 0">
                    <text class="level-text">{{ rider.level }}</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="meta-text">信用分 {{ rider.credit_score }}</text>
                <text class="meta-divider">|</text>
                <text class="meta-text">已接 {{ rider.total_orders }} 单</text>
            </view>
            <view class="status-row" @click="onToggleStatus">
                <view class="status-dot" :class="{ online: rider.is_online }"></view>
                <text class="status-text">{{ rider.is_online ? '在线接单' : '已下线' }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Rider = {
        name: string
        avatar: string
        level: string
        credit_score: number
        total_orders: number
        is_online: boolean
    }

    const props = defineProps<{
        rider: Rider
    }>()

    const emit = defineEmits<{
        (e: 'toggle'): void
    }>()

    const onToggleStatus = () => {
        emit('toggle')
    }
</script>

