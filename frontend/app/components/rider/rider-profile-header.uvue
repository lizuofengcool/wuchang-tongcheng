        margin-top: 6px;
    }

    .meta-text {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.85);
    }

    .meta-divider {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        margin: 0 8px;
    }

    .status-row {
        flex-direction: row;
        align-items: center;
        margin-top: 8px;
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 4px 10px;
        align-self: flex-start;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background-color: #999999;
