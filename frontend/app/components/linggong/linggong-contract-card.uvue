<template>
    <view class="contract-card" @click="onClick">
        <view class="header-row">
            <text class="contract-no">{{ contract.contract_no }}</text>
            <view class="status-tag" :class="contract.status">
                <text class="status-text">{{ getStatusText(contract.status) }}</text>
            </view>
        </view>
        <view class="info-row">
            <text class="info-label">岗位：</text>
            <text class="info-value">{{ contract.linggong_title }}</text>
        </view>
        <view class="info-row">
            <text class="info-label">对方：</text>
            <text class="info-value">{{ contract.peer_name }}</text>
        </view>
        <view class="info-row">
            <text class="info-label">金额：</text>
            <text class="info-value amount">{{ contract.amount }}</text>
        </view>
        <view class="footer-row">
            <text class="time">{{ contract.created_at }}</text>
            <view class="sign-btn" v-if="showSignBtn" @click.stop="onSign">
                <text class="sign-btn-text">立即签署</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Contract = {
        id: number
        contract_no: string
        linggong_title: string
        peer_name: string
        amount: string
        status: string
        can_sign: boolean
        created_at: string
    }

    const props = withDefaults(defineProps<{
        contract: Contract
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
        (e: 'sign', id: number): void
    }>()

    const showSignBtn = computed(() : boolean => {
        return props.contract.status == 'pending' && props.contract.can_sign
    })

    const getStatusText = (status: string) : string => {
        if (status == 'pending') return '待签署'
        if (status == 'signed') return '已签署'
        if (status == 'executing') return '执行中'
        if (status == 'completed') return '已完成'
        if (status == 'terminated') return '已终止'
        if (status == 'expired') return '已过期'
        return status
    }

    const onClick = () => {
        emit('click', props.contract.id)
    }

    const onSign = () => {
        emit('sign', props.contract.id)
    }
</script>

<style>
    .contract-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .header-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .contract-no {
        font-size: 13px;
        color: #333;
        font-weight: 600;
        flex: 1;
    }

    .status-tag {
        border-radius: 12px;
        padding: 2px 8px;
        margin-left: 8px;
    }

    .status-tag.pending {
        background-color: #FFF8E5;
    }

    .status-tag.signed {
        background-color: #E5F8FF;
    }

    .status-tag.executing {
        background-color: #FFF5F0;
    }

    .status-tag.completed {
        background-color: #F0FFF8;
    }

    .status-tag.terminated {
        background-color: #F5F5F5;
    }

    .status-tag.expired {
        background-color: #FFE5E5;
    }

    .status-text {
        font-size: 11px;
    }

    .status-tag.pending .status-text {
        color: #FF976A;
    }

    .status-tag.signed .status-text {
        color: #1989FA;
    }

    .status-tag.executing .status-text {
        color: #FF6B35;
    }

    .status-tag.completed .status-text {
        color: #07C160;
    }

    .status-tag.terminated .status-text {
        color: #999;
    }

    .status-tag.expired .status-text {
        color: #EE0A24;
    }

    .info-row {
        flex-direction: row;
        margin-top: 8px;
    }

    .info-label {
        font-size: 12px;
        color: #999;
    }

    .info-value {
        font-size: 12px;
        color: #333;
        flex: 1;
    }

    .info-value.amount {
        color: #FF6B35;
        font-weight: 600;
    }

    .footer-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
        padding-top: 10px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .time {
        font-size: 11px;
        color: #BBB;
    }

    .sign-btn {
        background-color: #FF6B35;
        border-radius: 14px;
        padding: 4px 14px;
    }

    .sign-btn-text {
        font-size: 12px;
        color: #FFFFFF;
        font-weight: 600;
    }
</style>
