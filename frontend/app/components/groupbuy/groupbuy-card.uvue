<template>
    <view class="groupbuy-card" @click="onClick">
        <image class="cover" :src="groupbuy.cover_image" mode="aspectFill" lazy-load="true" v-if="groupbuy.cover_image.length > 0" />
        <view class="cover-placeholder" v-else>
            <text class="cover-text">{{ groupbuy.title.length > 0 ? groupbuy.title.charAt(0) : '团' }}</text>
        </view>
        <view class="card-main">
            <text class="title">{{ groupbuy.title }}</text>
            <text class="sub-title" v-if="groupbuy.sub_title.length > 0">{{ groupbuy.sub_title }}</text>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx" :class="t.type">
                    <text class="tag-text" :class="t.type">{{ t.text }}</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="price">¥{{ groupbuy.price }}</text>
                <text class="origin-price" v-if="groupbuy.origin_price > groupbuy.price">¥{{ groupbuy.origin_price }}</text>
                <text class="discount" v-if="discountText.length > 0">{{ discountText }}</text>
            </view>
            <view class="bottom-row">
                <text class="sales">已售 {{ groupbuy.sales_count }}</text>
                <text class="shop-name" v-if="groupbuy.shop_name.length > 0">{{ groupbuy.shop_name }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Tag = { text: string, type: string }

    type GroupBuy = {
        id: number
        title: string
        sub_title: string
        cover_image: string
        price: number
        origin_price: number
        sales_count: number
        stock: number
        shop_name: string
        status: number
        is_featured: boolean
        is_hot: boolean
    }

    const props = withDefaults(defineProps<{
        groupbuy: GroupBuy
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const tags = computed(() : Tag[] => {
        const list = [] as Tag[]
        if (props.groupbuy.is_featured) list.push({ text: '精选', type: 'featured' } as Tag)
        if (props.groupbuy.is_hot) list.push({ text: '热销', type: 'hot' } as Tag)
        if (props.groupbuy.status == 2) list.push({ text: '售罄', type: 'soldout' } as Tag)
        return list
    })

    const discountText = computed(() : string => {
        if (props.groupbuy.origin_price <= 0 || props.groupbuy.origin_price <= props.groupbuy.price) return ''
        const d = Math.round((props.groupbuy.price / props.groupbuy.origin_price) * 10)
        return d + '折'
    })

    const onClick = () => {
        emit('click', props.groupbuy.id)
    }
</script>

<style>
    .groupbuy-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .cover {
        width: 100%;
        height: 160px;
        border-radius: 8px;
        background-color: #F5F5F5;
    }

    .cover-placeholder {
        width: 100%;
        height: 160px;
        border-radius: 8px;
        background-color: #FF6B35;
        align-items: center;
        justify-content: center;
    }

    .cover-text {
        font-size: 40px;
        color: #FFFFFF;
        font-weight: 700;
    }

    .card-main {
        margin-top: 8px;
    }

    .title {
        font-size: 15px;
        color: #333;
        font-weight: 600;
        lines: 2;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .sub-title {
        font-size: 12px;
        color: #999;
        margin-top: 4px;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 6px;
    }

    .tag {
        border-radius: 3px;
        padding: 1px 5px;
        margin-right: 4px;
    }

    .tag.featured {
        background-color: #FFF5F0;
    }

    .tag.hot {
        background-color: #FFEEEE;
    }

    .tag.soldout {
        background-color: #F5F5F5;
    }

    .tag-text {
        font-size: 10px;
    }

    .tag.featured .tag-text {
        color: #FF6B35;
    }

    .tag.hot .tag-text {
        color: #EE0A24;
    }

    .tag.soldout .tag-text {
        color: #999;
    }

    .meta-row {
        flex-direction: row;
        align-items: baseline;
        margin-top: 8px;
    }

    .price {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .origin-price {
        font-size: 11px;
        color: #BBB;
        text-decoration: line-through;
        margin-left: 6px;
    }

    .discount {
        font-size: 10px;
        color: #FF6B35;
        background-color: #FFF5F0;
        border-radius: 3px;
        padding: 1px 4px;
        margin-left: 6px;
    }

    .bottom-row {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-top: 6px;
    }

    .sales {
        font-size: 11px;
        color: #999;
    }

    .shop-name {
        font-size: 11px;
        color: #BBB;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
        max-width: 120px;
    }
</style>
