<template>
    <view class="header">
        <view class="type-row">
            <view class="type-tag" :class="car.listing_type">
                <text class="type-text">{{ car.listing_type == 'rent' ? '出租' : '出售' }}</text>
            </view>
            <view class="tag" v-if="car.is_urgent">
                <text class="tag-text urgent">⚡急售</text>
            </view>
            <view class="tag" v-if="car.is_featured">
                <text class="tag-text featured">★精选</text>
            </view>
            <view class="tag" v-if="car.is_certified">
                <text class="tag-text certified">✓认证</text>
            </view>
        </view>
        <text class="title">{{ car.title }}</text>
        <view class="price-row">
            <text class="price-symbol">¥</text>
            <text class="price-value">{{ formatPrice(car.price) }}</text>
            <text class="price-unit">{{ car.listing_type == 'rent' ? '/日' : '万' }}</text>
        </view>
        <view class="meta-grid">
            <view class="meta-cell">
                <text class="meta-label">品牌</text>
                <text class="meta-value">{{ car.brand_name }}</text>
            </view>
            <view class="meta-cell">
                <text class="meta-label">车型</text>
                <text class="meta-value">{{ car.model_name }}</text>
            </view>
            <view class="meta-cell">
                <text class="meta-label">年份</text>
                <text class="meta-value">{{ car.year_text }}</text>
            </view>
            <view class="meta-cell">
                <text class="meta-label">里程</text>
                <text class="meta-value">{{ car.mileage_text }}</text>
            </view>
            <view class="meta-cell">
                <text class="meta-label">变速箱</text>
                <text class="meta-value">{{ car.transmission }}</text>
            </view>
            <view class="meta-cell">
                <text class="meta-label">排放</text>
                <text class="meta-value">{{ car.emission_standard }}</text>
            </view>
            <view class="meta-cell" v-if="car.color.length > 0">
                <text class="meta-label">颜色</text>
                <text class="meta-value">{{ car.color }}</text>
            </view>
            <view class="meta-cell" v-if="car.fuel_type.length > 0">
                <text class="meta-label">燃料</text>
                <text class="meta-value">{{ car.fuel_type }}</text>
            </view>
        </view>
        <view class="stats-row" v-if="car.view_count > 0 || car.fav_count > 0">
            <text class="stat" v-if="car.view_count > 0">浏览 {{ car.view_count }}</text>
            <text class="stat" v-if="car.fav_count > 0">收藏 {{ car.fav_count }}</text>
            <text class="stat" v-if="car.test_drive_count > 0">试驾 {{ car.test_drive_count }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Car = {
        id: number
        title: string
        listing_type: string
        price: number
        brand_name: string
        model_name: string
        year_text: string
        mileage_text: string
        transmission: string
        emission_standard: string
        color: string
        fuel_type: string
        view_count: number
        fav_count: number
        test_drive_count: number
        is_urgent: boolean
        is_featured: boolean
        is_certified: boolean
    }

    const props = withDefaults(defineProps<{
        car: Car
    }>(), {} as any)

    const formatPrice = (p: number) : string => {
        if (p == 0) return '0'
        if (p == Math.floor(p)) return p.toString()
        return p.toFixed(2)
    }
</script>

