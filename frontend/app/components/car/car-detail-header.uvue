    .tag-text {
        font-size: 11px;
        border-radius: 4px;
        padding: 2px 6px;
    }

    .tag-text.urgent {
        color: #EE0A24;
        background-color: #FFE5E5;
    }

    .tag-text.featured {
        color: #FF6B35;
        background-color: #FFF5F0;
    }

    .tag-text.certified {
        color: #07C160;
        background-color: #F0FFF8;
    }

    .title {
        font-size: 18px;
        color: #333;
        font-weight: 700;
        line-height: 1.4;
        margin-top: 10px;
    }

    .price-row {
        flex-direction: row;
        align-items: baseline;
        margin-top: 10px;
    }

    .price-symbol {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 600;
    }

    .price-value {
        font-size: 24px;
        color: #FF6B35;
        font-weight: 700;
        margin-left: 2px;
    }

    .price-unit {
        font-size: 12px;
        color: #FF6B35;
        margin-left: 2px;
    }

    .meta-grid {
        flex-direction: row;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .meta-cell {
        width: 33.33%;
        margin-top: 8px;
    }

    .meta-label {
        font-size: 12px;
        color: #999;
    }

    .meta-value {
        font-size: 13px;
        color: #333;
        margin-top: 2px;
    }

    .stats-row {
        flex-direction: row;
        margin-top: 10px;
        padding-top: 8px;
        border-top-width: 1px;
        border-top-color: #F5F5F5;
    }

    .stat {
        font-size: 11px;
        color: #BBB;
        margin-right: 12px;
    }
</style>
