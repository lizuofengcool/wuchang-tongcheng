<template>
    <view class="car-card" @click="onClick">
        <view class="image-wrap">
            <image class="cover" :src="car.cover_image" mode="aspectFill" lazy-load="true" />
            <view class="badge" v-if="car.listing_type == 'sale'">
                <text class="badge-text">售</text>
            </view>
            <view class="badge rent" v-else-if="car.listing_type == 'rent'">
                <text class="badge-text">租</text>
            </view>
            <view class="cert-tag" v-if="car.is_certified">
                <text class="cert-tag-text">✓ 认证</text>
            </view>
        </view>
        <view class="info">
            <text class="title">{{ car.title }}</text>
            <view class="tag-row" v-if="tags.length > 0">
                <view class="tag" v-for="(t, idx) in tags" :key="idx">
                    <text class="tag-text">{{ t }}</text>
                </view>
            </view>
            <view class="meta-row">
                <text class="meta" v-if="car.mileage_text.length > 0">{{ car.mileage_text }}</text>
                <text class="meta" v-if="car.year_text.length > 0">{{ car.year_text }}</text>
                <text class="meta" v-if="car.city.length > 0">{{ car.city }}</text>
            </view>
            <view class="bottom-row">
                <view class="price-wrap">
                    <text class="price-symbol">¥</text>
                    <text class="price">{{ formatPrice(car.price) }}</text>
                    <text class="price-unit" v-if="car.listing_type == 'rent'">/日</text>
                    <text class="price-unit" v-else>万</text>
                </view>
                <view class="location-row" v-if="car.brand_name.length > 0">
                    <text class="location">{{ car.brand_name }}</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
    type Car = {
        id: number
        title: string
        cover_image: string
        listing_type: string
        mileage_text: string
        year_text: string
        city: string
        price: number
        brand_name: string
        is_certified: boolean
        is_urgent: boolean
        is_featured: boolean
    }

    const props = withDefaults(defineProps<{
        car: Car
    }>(), {} as any)

    const emit = defineEmits<{
        (e: 'click', id: number): void
    }>()

    const tags = computed(() : string[] => {
        const list = [] as string[]
        if (props.car.is_urgent) list.push('急售')
        if (props.car.is_featured) list.push('精选')
        return list
    })

    const onClick = () => {
        emit('click', props.car.id)
    }

    const formatPrice = (p: number) : string => {
        if (p == 0) return '0'
        if (p == Math.floor(p)) return p.toString()
        return p.toFixed(2)
    }
</script>

<style>
    .car-card {
        background-color: #FFFFFF;
        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
        flex-direction: row;
    }

    .image-wrap {
        position: relative;
        width: 120px;
        height: 90px;
        border-radius: 8px;
        overflow: hidden;
        margin-right: 10px;
    }

    .cover {
        width: 100%;
        height: 100%;
    }

    .badge {
        position: absolute;
        top: 0;
        left: 0;
        background-color: #FF6B35;
        padding: 2px 6px;
        border-bottom-right-radius: 6px;
    }

    .badge.rent {
        background-color: #1989FA;
    }

    .badge-text {
        font-size: 11px;
        color: #FFFFFF;
        font-weight: 600;
    }

    .cert-tag {
        position: absolute;
        bottom: 4px;
        right: 4px;
        background-color: rgba(7, 193, 96, 0.85);
        border-radius: 4px;
        padding: 1px 4px;
    }

    .cert-tag-text {
        font-size: 10px;
        color: #FFFFFF;
    }

    .info {
        flex: 1;
        flex-direction: column;
        justify-content: space-between;
    }

    .title {
        font-size: 14px;
        color: #333;
        font-weight: 500;
        lines: 1;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .tag-row {
        flex-direction: row;
        margin-top: 4px;
    }

    .tag {
        background-color: #FFF5F0;
        border-radius: 3px;
        padding: 1px 5px;
        margin-right: 4px;
    }

    .tag-text {
        font-size: 10px;
        color: #FF6B35;
    }

    .meta-row {
        flex-direction: row;
        margin-top: 4px;
    }

    .meta {
        font-size: 11px;
        color: #999;
        margin-right: 8px;
    }

    .bottom-row {
        flex-direction: row;
        align-items: baseline;
        justify-content: space-between;
        margin-top: 4px;
    }

    .price-wrap {
        flex-direction: row;
        align-items: baseline;
    }

    .price-symbol {
        font-size: 12px;
        color: #FF6B35;
        font-weight: 600;
    }

    .price {
        font-size: 18px;
        color: #FF6B35;
        font-weight: 700;
    }

    .price-unit {
        font-size: 11px;
        color: #FF6B35;
        margin-left: 2px;
    }

    .location-row {
        flex-direction: row;
        align-items: center;
    }

    .location {
        font-size: 11px;
        color: #999;
    }
</style>
