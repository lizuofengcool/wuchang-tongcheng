<template>
    <view class="badge" :style="{ backgroundColor: bgColor }">
        <text class="badge-icon" v-if="showIcon">⭐</text>
        <text class="badge-level" :style="{ color: textColor }">{{ levelText }}</text>
        <text class="badge-score" :style="{ color: textColor }">{{ score }}</text>
    </view>
</template>

<script setup lang="uts">
    const props = withDefaults(defineProps<{
        score: number
        level?: number
        showIcon?: boolean
    }>(), {
        level: 0,
        showIcon: true
    } as any)

    const levelText = computed(() : string => {
        const lvl = props.level > 0 ? props.level : levelByScore(props.score)
        if (lvl >= 5) return '钻石'
        if (lvl == 4) return '金牌'
        if (lvl == 3) return '银牌'
        if (lvl == 2) return '铜牌'
        if (lvl == 1) return '新手'
        return '未评级'
    })

    const bgColor = computed(() : string => {
        const lvl = props.level > 0 ? props.level : levelByScore(props.score)
        if (lvl >= 5) return '#E5E5E5'
        if (lvl == 4) return '#FFF5E5'
        if (lvl == 3) return '#F0F0F0'
        if (lvl == 2) return '#FFF0E5'
        if (lvl == 1) return '#F5F5F5'
        return '#F5F5F5'
    })

    const textColor = computed(() : string => {
        const lvl = props.level > 0 ? props.level : levelByScore(props.score)
        if (lvl >= 5) return '#9B59B6'
        if (lvl == 4) return '#FF976A'
        if (lvl == 3) return '#666666'
        if (lvl == 2) return '#CD7F32'
        if (lvl == 1) return '#999999'
        return '#999999'
    })

    const levelByScore = (score: number) : number => {
        if (score >= 800) return 5
        if (score >= 600) return 4
        if (score >= 400) return 3
        if (score >= 200) return 2
        if (score >= 100) return 1
        return 0
    }
</script>

<style>
    .badge {
        flex-direction: row;
        align-items: center;
        border-radius: 10px;
        padding: 2px 6px;
    }

    .badge-icon {
        font-size: 10px;
        margin-right: 2px;
    }

    .badge-level {
        font-size: 10px;
        font-weight: 600;
    }

    .badge-score {
        font-size: 10px;
        margin-left: 2px;
    }
</style>
