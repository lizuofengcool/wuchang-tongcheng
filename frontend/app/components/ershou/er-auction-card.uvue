        border-radius: 12px;
        padding: 12px;
        margin-bottom: 10px;
    }

    .header {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .title-wrap {
        flex-direction: row;
        align-items: center;
    }

    .title {
        font-size: 14px;
        color: #FF6B35;
        font-weight: 700;
        margin-right: 8px;
    }

    .status {
        font-size: 11px;
        color: #999;
    }

    .countdown {
        background-color: #FFE5E5;
        border-radius: 4px;
        padding: 2px 8px;
        flex-direction: row;
        align-items: center;
    }

    .countdown-label {
        font-size: 10px;
        color: #EE0A24;
        margin-right: 4px;
    }

    .countdown-time {
        font-size: 12px;
        color: #EE0A24;
        font-weight: 600;
    }

    .price-area {
        flex-direction: row;
        background-color: #FFF8F5;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .price-col {
        flex: 1;
        align-items: center;
    }

    .label {
        font-size: 11px;
        color: #999;
        margin-bottom: 4px;
    }

    .value {
        font-size: 15px;
        color: #333;
        font-weight: 600;
    }

    .highlight {
        color: #FF6B35;
        font-size: 18px;
    }

    .muted {
        color: #999;
    }

    .meta {
        flex-direction: row;
        margin-bottom: 10px;
    }

    .meta-item {
        flex: 1;
        align-items: center;
    }

    .meta-label {
        font-size: 11px;
        color: #999;
        margin-bottom: 2px;
    }

    .meta-value {
        font-size: 13px;
        color: #333;
        font-weight: 500;
    }

    .footer {
        background-color: #FAFAFA;
        border-radius: 6px;
        padding: 8px;
    }

    .rule-text {
        font-size: 11px;
        color: #999;
    }
</style>
