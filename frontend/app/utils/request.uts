// API 请求封装 - 统一处理 token/错误/超时
// 依据需求文档 1.2 后端 API 统一服务，所有端共用 /api/v1/*

export type ApiResult = {
    code: number
    message: string
    data: any | null
}

export type RequestOptions = {
    url: string
    method?: string
    data?: any | null
    header?: UTSJSONObject | null
    showLoading?: boolean
    showError?: boolean
    needAuth?: boolean
}

const BASE_URL = 'http://localhost:8088/api/v1'
const TIMEOUT = 15000

export const request = (options: RequestOptions): Promise<ApiResult> => {
    return new Promise((resolve, reject) => {
        const token = uni.getStorageSync('wctc_token') as string
        const header: UTSJSONObject = {
            'Content-Type': 'application/json'
        }
        if (options.needAuth != false && token != null && token.length > 0) {
            header['Authorization'] = 'Bearer ' + token
        }
        if (options.header != null) {
            const customHeader = options.header!
            Object.keys(customHeader).forEach((key) => {
                header[key] = customHeader[key]
            })
        }

        if (options.showLoading != false) {
            uni.showLoading({ title: '加载中...' })
        }

        uni.request({
            url: BASE_URL + options.url,
            method: (options.method ?? 'GET') as RequestMethod,
            data: options.data,
            header: header,
            timeout: TIMEOUT,
            success: (res: RequestSuccessCallbackResult) => {
                if (options.showLoading != false) {
                    uni.hideLoading()
                }
                if (res.statusCode >= 200 && res.statusCode < 300) {
                    const data = res.data as UTSJSONObject
                    const code = (data['code'] as number) ?? 0
                    const message = (data['message'] as string) ?? ''
                    if (code === 0) {
                        resolve({
                            code: code,
                            message: message,
                            data: data['data']
                        } as ApiResult)
                    } else if (code === 401) {
                        // token 过期，跳转登录
                        uni.removeStorageSync('wctc_token')
                        uni.removeStorageSync('wctc_user_info')
                        uni.reLaunch({ url: '/pages/login/login' })
                        reject({ code: 401, message: '登录已过期' })
                    } else {
                        if (options.showError != false) {
                            uni.showToast({ title: message, icon: 'none' })
                        }
                        reject({ code: code, message: message })
                    }
                } else if (res.statusCode === 401) {
                    uni.removeStorageSync('wctc_token')
                    uni.removeStorageSync('wctc_user_info')
                    uni.reLaunch({ url: '/pages/login/login' })
                    reject({ code: 401, message: '未授权' })
                } else {
                    const errMsg = '服务器错误(' + res.statusCode + ')'
                    if (options.showError != false) {
                        uni.showToast({ title: errMsg, icon: 'none' })
                    }
                    reject({ code: res.statusCode, message: errMsg })
                }
            },
            fail: (err: UniError) => {
                if (options.showLoading != false) {
                    uni.hideLoading()
                }
                const errMsg = '网络请求失败：' + err.errMsg
                if (options.showError != false) {
                    uni.showToast({ title: errMsg, icon: 'none' })
                }
                reject({ code: -1, message: errMsg })
            }
        })
    })
}

// 便捷方法
export const get = (url: string, data?: any | null): Promise<ApiResult> => {
    return request({ url: url, method: 'GET', data: data } as RequestOptions)
}

export const post = (url: string, data?: any | null): Promise<ApiResult> => {
    return request({ url: url, method: 'POST', data: data } as RequestOptions)
}

export const put = (url: string, data?: any | null): Promise<ApiResult> => {
    return request({ url: url, method: 'PUT', data: data } as RequestOptions)
}

export const del = (url: string, data?: any | null): Promise<ApiResult> => {
    return request({ url: url, method: 'DELETE', data: data } as RequestOptions)
}
