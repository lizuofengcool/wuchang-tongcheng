<script setup lang="uts">
    import { state, setStatusBarHeight, setSafeArea, setNetworkType } from '@/store/index.uts'

    onLaunch((_ : OnLaunchOptions) => {
        console.log('近享同城 App Launch')

        // 获取系统信息
        uni.getSystemInfo({
            success: (res : GetSystemInfoResult) => {
                setStatusBarHeight(res.statusBarHeight)
                setSafeArea(res.safeArea?.top ?? 0, res.safeArea?.bottom ?? 0)
            }
        })

        // 监听网络状态
        uni.getNetworkType({
            success: (res : GetNetworkTypeResult) => {
                setNetworkType(res.networkType)
            }
        })
        uni.onNetworkStatusChange((res : NetworkStatusChangeResult) => {
            setNetworkType(res.networkType)
            if (!res.isConnected) {
                uni.showToast({
                    title: '网络已断开',
                    icon: 'none'
                })
            }
        })
    })

    onAppShow((_ : OnShowOptions) => {
        console.log('App Show')
    })

    onAppHide(() => {
        console.log('App Hide')
    })

    // #ifdef APP-ANDROID || APP-HARMONY
    let firstBackTime = 0
    onLastPageBackPress(() => {
        if (firstBackTime == 0) {
            uni.showToast({
                title: '再按一次退出应用',
                position: 'bottom',
            })
            firstBackTime = Date.now()
            setTimeout(() => {
                firstBackTime = 0
            }, 2000)
        } else if (Date.now() - firstBackTime < 2000) {
            firstBackTime = Date.now()
            uni.exit()
        }
    })
    // #endif

    onError((err : any) => {
        console.error('App Error', err)
    })
</script>

